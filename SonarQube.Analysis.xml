<?xml version="1.0" encoding="utf-8" ?>
<SonarQubeAnalysisProperties
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">

  <!-- Exclude from all analysis: EF migrations (generated DDL) and test utilities (not production code).
       The migrations pattern is rooted at src/ so the migration tests under tests/ are still analysed.

       CodingAgent.Web.E2ETests is excluded for a structural reason, not to hide issues. The
       scanner classifies a project as test code from its IsTestProject property, and that project
       must keep IsTestProject=false so ci.yml's solution-wide `dotnet test` does not fail on it
       matching zero tests (see the csproj for the full note). Without this exclusion the scanner
       therefore measures E2E harness code as production code — its fixtures and factories count
       against new-code coverage, and the four deliberately parallel WebApplicationFactory classes
       count as duplication.

       .github/scripts holds CI helper scripts (Python), not product code. They run their own unit
       tests in the workflow that uses them, and no Python coverage report reaches the scanner. -->
  <Property Name="sonar.exclusions">src/**/Migrations/**,tests/CodingAgent.Web.TestUtilities/**,tests/CodingAgent.Web.E2ETests/**,.github/scripts/**</Property>

  <!-- Rule-level suppressions that cannot be expressed inline. -->
  <Property Name="sonar.issue.ignore.multicriteria">e2ecopy,inclusterhttp</Property>

  <!-- docker:S6470 — `COPY . .` in the E2E image. The inline `# NOSONAR` this previously relied on
       had to move off the instruction line: BuildKit does not strip trailing comments and parsed
       the `#` as another source path, failing every build with `lstat /#: no such file or
       directory`. The copy itself is required (the image builds the whole solution) and
       .dockerignore excludes .env, .git, .kiro, config/ and *credentials*. -->
  <Property Name="sonar.issue.ignore.multicriteria.e2ecopy.ruleKey">docker:S6470</Property>
  <Property Name="sonar.issue.ignore.multicriteria.e2ecopy.resourceKey">dockerfiles/e2e-tests.Dockerfile</Property>

  <!-- csharpsquid:S5332 — `UseUrls("http://+:PORT")` binds the in-cluster listener. TLS terminates
       at the ingress; these ports are never exposed outside the cluster network. -->
  <Property Name="sonar.issue.ignore.multicriteria.inclusterhttp.ruleKey">csharpsquid:S5332</Property>
  <Property Name="sonar.issue.ignore.multicriteria.inclusterhttp.resourceKey">**/Program.cs</Property>

  <!-- Exclude from coverage only. Every entry must name a file that exists and has no unit-testable
       logic. Do not add a file here to pass the new-code coverage gate: if a file has tests, it
       stays measured. A class whose only uncovered code needs a live dependency gets
       [ExcludeFromCodeCoverage] on that class or method instead — the scanner honours the
       attribute, so the class needs no entry here.

       Host entry points and markers: Program.cs is exercised only through host startup; the
       *HostMarker classes are empty marker types for WebApplicationFactory.

       Blazor components (*.razor): covered by the bUnit tests in CodingAgent.Web.UnitTests, but kept
       out of the coverage metric so UI changes are not held to the new-code coverage gate.

       Live-dependency wrappers with no logic of their own: KubernetesJobClient (one call per
       Kubernetes API method), SharedRepositoryOperations (the remaining CommitAllAsync overloads
       delegate to RepositoryGitOperations, which needs a real git repo),
       PostgresDistributedLockProvider (pg_try_advisory_lock through EF Core, needs a real Postgres),
       JobTemplateProviderLoader (File.Exists/path-fallback wrapper).

       DI registration: JobController and Kubernetes service-collection wiring only.

       Trivial types with no logic to assert on: DispatchPreparationRequests (records),
       NullPipelineRunHistoryService (null object), HubMethodNames (constant bag), and the
       IPullRequest*Provider interfaces (default implementations that only throw
       NotSupportedException or return a fixed value). -->
  <Property Name="sonar.coverage.exclusions">**/Program.cs,**/*.razor,src/CodingAgent.Api/ApiHostMarker.cs,src/CodingAgent.Web/WebUiHostMarker.cs,src/CodingAgent.JobController/JobControllerHostMarker.cs,src/CodingAgent.Kubernetes/KubernetesJobClient.cs,src/CodingAgent.Infrastructure.Providers/Git/SharedRepositoryOperations.cs,src/CodingAgent.Infrastructure.Persistence/Locking/PostgresDistributedLockProvider.cs,src/CodingAgent.Orchestration/Dispatch/JobTemplateProviderLoader.cs,src/CodingAgent.JobController/Dispatch/DispatchServiceRegistration.cs,src/CodingAgent.JobController/Reconciliation/ReconciliationServiceRegistration.cs,src/CodingAgent.JobController/JobControllerServiceCollectionExtensions.cs,src/CodingAgent.Kubernetes/KubernetesClientRegistration.cs,src/CodingAgent.Orchestration/Dispatch/DispatchPreparationRequests.cs,src/CodingAgent.Agent/NullPipelineRunHistoryService.cs,src/CodingAgent.Contracts/Interfaces/HubMethodNames.cs,src/CodingAgent.Contracts/Interfaces/IPullRequestLabelProvider.cs,src/CodingAgent.Contracts/Interfaces/IPullRequestProvider.cs,src/CodingAgent.Contracts/Interfaces/IPullRequestReviewProvider.cs</Property>

  <!-- Exclude from CPD only.

       GitHubRepositoryProvider.Commits and GitLabRepositoryProvider both implement IRepositoryProvider
       by delegating the same methods to SharedRepositoryOperations. The identical call sequences
       come from implementing a shared interface, not from copy-paste.

       Prompt builders: they build prompt text from long runs of s.AppendLine("...") calls. The C#
       CPD tokenizer replaces every string literal with the same token, so two such runs compare
       equal even though their text differs; the files contain no verbatim duplicated prose. These
       entries can go once the builders hold their prose in raw string literals ("""..."""), which
       the tokenizer sees as a single token. -->
  <Property Name="sonar.cpd.exclusions">src/CodingAgent.Infrastructure.Providers/GitHub/GitHubRepositoryProvider.Commits.cs,src/CodingAgent.Infrastructure.Providers/GitLab/GitLabRepositoryProvider.cs,src/CodingAgent.Pipeline/Services/Prompts/PromptBuilder.cs,src/CodingAgent.Pipeline/Services/Prompts/ConsolidationPromptBuilder.cs,src/CodingAgent.Pipeline/Services/Prompts/ConsolidationPromptBuilder.Refactoring.cs,src/CodingAgent.Pipeline/Services/Prompts/DecompositionPromptBuilder.cs,src/CodingAgent.Pipeline/Services/Prompts/FeedbackPromptBuilder.cs</Property>

</SonarQubeAnalysisProperties>
