<?xml version="1.0" encoding="utf-8" ?>
<SonarQubeAnalysisProperties
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema"
  xmlns="http://www.sonarsource.com/msbuild/integration/2015/1">

  <!-- Exclude from all analysis: EF migrations (generated DDL) and test utilities (not production code) -->
  <Property Name="sonar.exclusions">**/Migrations/**,tests/CodingAgentWebUI.TestUtilities/**</Property>

  <!-- Exclude from coverage only: entry points, Blazor markup, ReconciliationService files
       (service-host methods: K8s watch loops, job deletion, PVC management — require integration env),
       AgentK8sModeRegistration (pure DI/service-registration wiring, requires full container),
       SignalR infrastructure (hubs, reporters, auth filters — require live connections/runtime),
       and DI registration files (service wiring, not unit-testable logic) -->
  <Property Name="sonar.coverage.exclusions">**/Program.cs,**/*.razor,**/Dispatch/ReconciliationService*.cs,**/AgentK8sModeRegistration.cs,**/SignalRRegistration.cs,**/PipelineSignalRReporter.cs,**/SignalRAgentCommunication.cs,**/AgentAuthorizationFilter.cs,**/Hubs/AgentHub.cs</Property>

  <!-- Exclude ReconciliationService partials from CPD: duplication with DatabaseMaintenanceService
       is pre-existing (was in monolithic ReconciliationService.cs before this structural split) -->
  <Property Name="sonar.cpd.exclusions">**/Dispatch/ReconciliationService.*.cs</Property>

</SonarQubeAnalysisProperties>
