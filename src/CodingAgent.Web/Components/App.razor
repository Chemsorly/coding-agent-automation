@inject IConfiguration Configuration
@inject CodingAgent.Web.Models.BuildInfo BuildInfo
@inject IWebHostEnvironment Env
<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Coding Agent</title>
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    @{
        // Base path for the <base href> tag. Unset or relative WebUI__BasePath values (the Helm
        // default is "./") produce a relative base that points from the current route back to the
        // app root ("../" on /runs/{id}), so nested routes load their assets both at a root
        // deployment and behind a prefix-stripping reverse proxy such as Rancher. A rooted value
        // (e.g. "/k8s/clusters/c-xxxxx/proxy/") is used as is. See BaseHrefResolver.
        var basePath = BaseHrefResolver.Resolve(Configuration["WebUI:BasePath"], HttpContext?.Request.Path.Value);
    }
    <base href="@basePath" />
    <ResourcePreloader />
    @{
        // Faro collector URL injected as a meta tag so faro-init.js can read it without
        // hardcoding it in the static bundle. Empty string → Faro disabled (dev/test).
        var faroCollectorUrl = Configuration["Faro:CollectorUrl"] ?? "";
    }
    <meta name="faro-collector-url" content="@faroCollectorUrl" />
    <meta name="app-version" content="@BuildInfo.ShortSha" />
    <meta name="app-environment" content="@Env.EnvironmentName.ToLowerInvariant()" />
    <!-- Grafana Faro: faro-init.js reads faro-collector-url meta and dynamically loads the CDN bundles -->
    <script src="js/faro-init.js"></script>
    @* app.css also declares the fonts, served from wwwroot/fonts (spec 052: no third-party stylesheet). *@
    <link rel="stylesheet" href="css/app.css" />
    <!-- Redesigned shell theme (see docs/frontend-redesign-handoff.md). Scoped to .cockpit; legacy shell unaffected. -->
    <link rel="stylesheet" href="css/cockpit.css" />
    <link rel="stylesheet" href="@Assets["CodingAgent.Web.styles.css"]" />
    <ImportMap nonce="@CspNonce" />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>
<body>
    @* Spec 052 Req 1.4: shown until the client renders a layout (app.css hides it once .cockpit exists). *@
    <div id="app-loading" role="status" aria-live="polite">
        <span class="app-loading-name">Coding Agent</span>
        <span class="app-loading-spinner" aria-hidden="true"></span>
        <span class="app-loading-text">Loading…</span>
        <p class="app-loading-error">The app could not load. <a href="" data-testid="app-loading-reload">Reload</a></p>
    </div>

    <Routes @rendermode="PageRenderMode" />

    @* Spec 052 Req 1.7: Blazor shows this on an unhandled exception in the client. *@
    <div id="blazor-error-ui" data-nosnippet>
        An error has occurred. <a href="" class="reload">Reload</a>
        <span class="dismiss" aria-label="Dismiss">✕</span>
    </div>

    <script nonce="@CspNonce">
        // The loading screen turns into an error with a Reload link when the client cannot start: a
        // script or download error, a missing fingerprinted file during a rolling update, or a browser
        // without WebAssembly. After 20 s it keeps the spinner and offers Reload too. Blazor.start()
        // resolves before WebAssembly starts, so its promise cannot report this.
        (function () {
            var box = document.getElementById('app-loading');
            function started() { return !!document.querySelector('.cockpit'); }
            function fail() { if (!started()) box.classList.add('app-loading-failed'); }
            window.addEventListener('error', fail, true);
            window.addEventListener('unhandledrejection', fail);
            if (typeof WebAssembly === 'undefined') fail();
            setTimeout(function () { if (!started()) box.classList.add('app-loading-slow'); }, 20000);
        })();
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script nonce="@CspNonce">
        // Spec 052 Req 3.4: a hidden tab's timers may run only once a minute, so the session store checks
        // the session as soon as the tab is visible again.
        window.watchPageVisibility = function (dotNetRef) {
            document.addEventListener('visibilitychange', function () {
                if (document.visibilityState === 'visible') dotNetRef.invokeMethodAsync('OnPageVisibleAsync');
            });
        };
        // Spec 052 Req 5.2: the build this page was served with, which the client compares with X-App-Version.
        window.getAppVersion = function () {
            var meta = document.querySelector('meta[name="app-version"]');
            return meta ? meta.getAttribute('content') : null;
        };
        window.scrollToBottom = function (elementId) {
            var element = document.getElementById(elementId);
            if (element) {
                element.scrollTop = element.scrollHeight;
            }
        };
        window.scrollActiveStepIntoView = function (containerId) {
            var container = document.getElementById(containerId);
            if (!container) return;
            var active = container.querySelector('.step-card-active');
            if (active) {
                active.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        };
        window.getSidebarCollapsed = function () {
            return localStorage.getItem('sidebar-collapsed');
        };
        window.setSidebarCollapsed = function (value) {
            localStorage.setItem('sidebar-collapsed', value);
        };
        window.localStorageGet = function (key) {
            return localStorage.getItem(key);
        };
        window.localStorageSet = function (key, value) {
            localStorage.setItem(key, value);
        };
        // The triage form's times are the browser's local time; the agent gets UTC
        window.localToUtcIso = function (value) {
            var d = new Date(value);
            return isNaN(d.getTime()) ? null : d.toISOString();
        };
        window.startOfTodayUtcIso = function () {
            var d = new Date();
            d.setHours(0, 0, 0, 0);
            return d.toISOString();
        };
        window.getTheme = function () {
            return localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        };
        window.setTheme = function (theme) {
            localStorage.setItem('theme', theme);
            document.documentElement.setAttribute('data-theme', theme);
        };
        // Apply stored theme immediately to avoid flash
        (function() {
            var t = localStorage.getItem('theme') || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
            document.documentElement.setAttribute('data-theme', t);
        })();
        window.registerGlobalKeyboardHandler = function (dotNetRef) {
            window.__globalKeyHandler = function (e) {
                var tag = document.activeElement ? document.activeElement.tagName : '';
                var isInput = (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT');
                if (e.key === 'Escape') {
                    dotNetRef.invokeMethodAsync('HandleGlobalKey', 'Escape');
                } else if (e.key === '?' && !isInput && !e.ctrlKey && !e.metaKey) {
                    e.preventDefault();
                    dotNetRef.invokeMethodAsync('HandleGlobalKey', '?');
                }
            };
            document.addEventListener('keydown', window.__globalKeyHandler);
        };
        window.unregisterGlobalKeyboardHandler = function () {
            if (window.__globalKeyHandler) {
                document.removeEventListener('keydown', window.__globalKeyHandler);
                window.__globalKeyHandler = null;
            }
        };
        window.downloadFileFromStream = async function (fileName, streamRef) {
            var buffer = await streamRef.arrayBuffer();
            var blob = new Blob([buffer], { type: 'application/json' });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = fileName;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        };
    </script>
</body>
</html>

@code {
    // App renders statically (only HeadOutlet and Routes are interactive), so the request's
    // HttpContext is available here; the request path decides the relative base href.
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    // The Content-Security-Policy allows inline scripts only with this request's nonce.
    private string? CspNonce => HttpContext?.GetCspNonce();

    // Spec 052 D1, D2: every page runs in the browser as WebAssembly, without prerendering. A loading
    // screen covers the start (Req 1.4) and pages render once, through one DI setup.
    private static readonly IComponentRenderMode WebAssembly = new InteractiveWebAssemblyRenderMode(prerender: false);

    // Spec 049: the login page ([ExcludeFromInteractiveRouting]) renders statically so its form can
    // post to /auth/login and receive the session cookie; every other page is interactive.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext is null || HttpContext.AcceptsInteractiveRouting() ? WebAssembly : null;
}
