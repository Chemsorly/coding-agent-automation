@inherits LayoutComponentBase
@implements IAsyncDisposable
@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models
@using CodingAgent.Web.Components.Shared
@using CodingAgent.Web.Services
@using Serilog
@inject IPipelineApiConfigClient ConfigClient
@inject IPipelineApiRunHistoryClient RunHistory
@inject CockpitState State
@inject IFaroService Faro
@inject NotificationFaroBridge FaroBridge
@inject IJSRuntime JS
@inject NavigationManager Nav

@*
    Cockpit shell — the redesigned frontend's layout (see docs/frontend-redesign-handoff.md).
    Opt in per-page with `@layout CockpitLayout`. Re-themes tokens via the `.cockpit` scope
    (cockpit.css), so token-based components adopt the new look with no rewrite.
    Nav destinations that aren't built yet render inert ("soon"); they light up as their slices land.
*@

<div class="cockpit @(_sidebarOpen ? "sidebar-open" : "")">

    <nav class="cockpit-sidebar @(_sidebarOpen ? "is-open" : "")" id="cockpit-nav" aria-label="Main navigation">
        <div class="cockpit-brand">
            <span class="cockpit-brand-mark"><Icon Name="bot" Size="19" /></span>
            <span class="cockpit-brand-text">
                <span class="cockpit-brand-name">Coding Agent</span>
                <span class="cockpit-brand-sub">Automation</span>
            </span>
        </div>

        <div class="cockpit-nav">
            <NavLink class="cockpit-nav-link" href="overview" Match="NavLinkMatch.Prefix" aria-label="Overview">
                <span class="cockpit-nav-icon"><Icon Name="monitor" Size="18" /></span><span class="cockpit-nav-text">Overview</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="work" Match="NavLinkMatch.Prefix" aria-label="Work">
                <span class="cockpit-nav-icon"><Icon Name="clipboard-list" Size="18" /></span><span class="cockpit-nav-text">Work</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="runs" Match="NavLinkMatch.Prefix" aria-label="Runs">
                <span class="cockpit-nav-icon"><Icon Name="scroll-text" Size="18" /></span><span class="cockpit-nav-text">Runs</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="fleet" Match="NavLinkMatch.Prefix" aria-label="Fleet">
                <span class="cockpit-nav-icon"><Icon Name="bot" Size="18" /></span><span class="cockpit-nav-text">Fleet</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="attention" Match="NavLinkMatch.Prefix" aria-label="Attention">
                <span class="cockpit-nav-icon"><Icon Name="alert-triangle" Size="18" /></span><span class="cockpit-nav-text">Attention</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="insights" Match="NavLinkMatch.Prefix" aria-label="Insights">
                <span class="cockpit-nav-icon"><Icon Name="bar-chart-2" Size="18" /></span><span class="cockpit-nav-text">Insights</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="pipelines" Match="NavLinkMatch.Prefix" aria-label="Pipelines">
                <span class="cockpit-nav-icon"><Icon Name="refresh-cw" Size="18" /></span><span class="cockpit-nav-text">Pipelines</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="consolidation" Match="NavLinkMatch.Prefix" aria-label="Consolidation">
                <span class="cockpit-nav-icon"><Icon Name="layers" Size="18" /></span>
                <span class="cockpit-nav-text">Consolidation</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="settings" Match="NavLinkMatch.Prefix" aria-label="Settings">
                <span class="cockpit-nav-icon"><Icon Name="settings" Size="18" /></span><span class="cockpit-nav-text">Settings</span>
            </NavLink>

            <div class="cockpit-nav-sep"></div>
            <span class="cockpit-nav-group">Tools</span>
            <NavLink class="cockpit-nav-link" href="knowledge" Match="NavLinkMatch.Prefix" aria-label="Knowledge">
                <span class="cockpit-nav-icon"><Icon Name="brain" Size="18" /></span><span class="cockpit-nav-text">Knowledge</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="agent-chat" Match="NavLinkMatch.Prefix" aria-label="Agent Chat">
                <span class="cockpit-nav-icon"><Icon Name="message-circle" Size="18" /></span><span class="cockpit-nav-text">Agent Chat</span>
            </NavLink>
            <NavLink class="cockpit-nav-link" href="about" Match="NavLinkMatch.Prefix" aria-label="About">
                <span class="cockpit-nav-icon"><Icon Name="info" Size="18" /></span><span class="cockpit-nav-text">About</span>
            </NavLink>
        </div>

        <div class="cockpit-sidebar-footer">
            <SidebarHealthIndicators />
            <button class="cockpit-theme-toggle" @onclick="ToggleTheme" title="Toggle light / dark">
                <Icon Name="@(_theme == "dark" ? "sun" : "moon")" Size="16" />
                <span>@(_theme == "dark" ? "Light" : "Dark") mode</span>
            </button>
        </div>
    </nav>

    @if (_sidebarOpen)
    {
        <div class="cockpit-sidebar-backdrop" @onclick="CloseSidebar" aria-hidden="true"></div>
    }

    <div class="cockpit-main">
        <div class="cockpit-topbar">
            <button class="cockpit-hamburger" @onclick="ToggleSidebar" aria-label="Toggle navigation menu" aria-expanded="@_sidebarOpen" aria-controls="cockpit-nav">
                <Icon Name="menu" Size="20" />
            </button>

            <label class="cockpit-project-switcher" title="Project scope">
                <svg class="icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>
                <select value="@State.SelectedProjectId" @onchange="OnProjectChanged" aria-label="Project scope">
                    <option value="">All projects</option>
                    @foreach (var p in _projects)
                    {
                        <option value="@p.Id">@p.Name</option>
                    }
                </select>
            </label>

            <div class="cockpit-topbar-right">
                <a href="attention" class="cockpit-attention @(State.AttentionCount > 0 ? "" : "is-disabled")" title="Attention inbox" style="text-decoration: none;">
                    <Icon Name="alert-triangle" Size="14" /> @(State.AttentionCount > 0 ? $"{State.AttentionCount} need attention" : "Attention")
                </a>
            </div>
        </div>

        <div class="cockpit-body">
            <FirstRunBanner />
            <CascadingValue Value="this" IsFixed="true">
                @Body
            </CascadingValue>
        </div>
    </div>
</div>

<ShortcutHelpOverlay IsVisible="_showShortcutHelp" OnClose="CloseShortcutHelp" />

@code {
    private IReadOnlyList<PipelineProject> _projects = [];

    // Mobile sidebar overlay state.
    private bool _sidebarOpen;

    // Global keyboard help (ported from the retired MainLayout — the '?' overlay + Escape).
    private DotNetObjectReference<CockpitLayout>? _dotNetRef;
    private bool _showShortcutHelp;

    /// <summary>Raised on Escape so pages (e.g. Pipelines dispatch drawers) can close their overlays.</summary>
    public event Action? OnEscapePressed;

    protected override void OnInitialized()
    {
        State.OnChange += HandleStateChanged;
        State.OnProjectChanged += HandleProjectChanged;
        // TODO [WARNING]: Nav.LocationChanged is subscribed here (synchronous OnInitialized) but
        // unsubscribed only in DisposeAsync. If the component is disposed before OnInitializedAsync
        // completes (rapid navigation), HandleLocationChanged may fire on a partially-initialised or
        // disposed component. InvokeAsync(StateHasChanged) on a disposed component logs an
        // ObjectDisposedException (Blazor swallows it, but it is a latent reliability issue).
        // A disposed-flag guard in HandleLocationChanged would prevent spurious invocations.
        // Also: NavigationManager is a scoped singleton; if DisposeAsync is never called (circuit
        // drops abruptly without IAsyncDisposable teardown), the handler keeps the component alive.
        // A synchronous IDisposable.Dispose fallback would close that leak path.
        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _projects = await ConfigClient.GetProjectsAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            // The config API can be unavailable in some run modes — degrade to "All projects".
            Log.Warning(ex, "CockpitLayout: failed to load projects for the scope switcher");
            _projects = [];
        }

        await RefreshAttentionCountAsync();
    }

    private async Task OnProjectChanged(ChangeEventArgs e)
    {
        var id = e.Value as string ?? "";
        var name = _projects.FirstOrDefault(p => p.Id == id)?.Name;
        State.SetProject(id, name);
        try { await JS.InvokeVoidAsync("localStorageSet", "cockpit.selectedProjectId", id); }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    private async Task RefreshAttentionCountAsync()
    {
        // Top-bar Attention count from recent run history, scoped to the selected project.
        // Runs once on circuit init and re-runs whenever the project scope changes.
        try
        {
            var runs = await RunHistory.GetRunHistoryAsync(page: 1, pageSize: 100, feedbackOnly: false, includeActive: false, projectId: State.SelectedProjectId);
            State.SetAttentionCount(AttentionAggregator.Aggregate(runs.Items).TotalCount);
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "CockpitLayout: failed to compute attention count");
        }
    }

    // TODO: [WARNING] HandleProjectChanged is declared async void. RefreshAttentionCountAsync wraps its
    // body in catch (Exception ex), so today's risk is low. However if RefreshAttentionCountAsync ever
    // rethrows, or if new awaitable work is added outside its try/catch, the exception will escape the
    // outer catch (ObjectDisposedException) guard here and be delivered to the Blazor circuit's unhandled-
    // exception handler, potentially tearing down the circuit. Consider wrapping the entire body in
    // catch (Exception) or scheduling via _ = InvokeAsync(RefreshAttentionCountAsync) so Blazor's own
    // error pipeline handles it. Also note that OperationCanceledException on circuit teardown would
    // also escape the current ObjectDisposedException guard.
    private async void HandleProjectChanged()
    {
        try { await RefreshAttentionCountAsync(); }
        catch (ObjectDisposedException) { }
    }

    private void HandleStateChanged() => InvokeAsync(StateHasChanged);

    // ── Mobile sidebar overlay ──────────────────────────────────────────────

    private void ToggleSidebar()
    {
        _sidebarOpen = !_sidebarOpen;
    }

    private void CloseSidebar()
    {
        if (_sidebarOpen)
        {
            _sidebarOpen = false;
        }
    }

    /// <summary>
    /// Closes the sidebar whenever the user navigates to a new page.
    /// Subscribed in OnInitialized, unsubscribed in DisposeAsync.
    /// </summary>
    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_sidebarOpen)
        {
            _sidebarOpen = false;
            // LocationChanged fires on the NavigationManager thread; must marshal to the render thread.
            // TODO [WARNING]: InvokeAsync return value is not observed. If the circuit is already disposed
            // when LocationChanged fires (user navigates away while the component is tearing down),
            // InvokeAsync may throw ObjectDisposedException as an unobserved faulted task. This is
            // consistent with the existing HandleStateChanged pattern, but LocationChanged is more likely
            // to fire during disposal than OnChange. Consider wrapping with try/catch inside the lambda
            // passed to InvokeAsync, or guarding with an _isDisposed flag set in DisposeAsync.
            InvokeAsync(StateHasChanged);
        }
    }

    // Theme follows the app's shared toggle (data-theme + localStorage). App.razor applies the
    // stored theme before Blazor renders; this just syncs the button icon and flips it on click.
    private string _theme = "dark";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _dotNetRef = DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("registerGlobalKeyboardHandler", _dotNetRef);

                var t = await JS.InvokeAsync<string>("getTheme");
                if (!string.IsNullOrEmpty(t) && t != _theme)
                {
                    _theme = t;
                    StateHasChanged();
                }

                // Restore persisted project scope. Must run after OnInitializedAsync so _projects
                // is populated. null = key absent (first visit); "" = "All projects" explicitly saved.
                var savedProjectId = await JS.InvokeAsync<string?>("localStorageGet", "cockpit.selectedProjectId");
                if (savedProjectId is not null)
                {
                    if (string.IsNullOrEmpty(savedProjectId))
                    {
                        State.SetProject("", null);
                    }
                    else
                    {
                        var project = _projects.FirstOrDefault(p => p.Id == savedProjectId);
                        if (project is not null)
                            State.SetProject(project.Id, project.Name);
                        else
                            // TODO [WARNING]: A transient config-API failure causes OnInitializedAsync to
                            // degrade _projects to [] (documented). If that happens on a reload where a
                            // *valid* project ID is stored, this branch incorrectly treats it as "deleted"
                            // and permanently clears the saved preference. Consider tracking whether the
                            // project list loaded successfully (e.g. a bool _projectsLoadedOk flag set in
                            // OnInitializedAsync) and only clearing the stale key when the list loaded OK.
                            await JS.InvokeVoidAsync("localStorageSet", "cockpit.selectedProjectId", ""); // clear stale
                    }
                }

                // Signal to Faro that the Blazor circuit connected successfully (ported from MainLayout).
                await Faro.PushEventAsync("blazor.circuit.connected");
            }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (ObjectDisposedException) { }
            catch (InvalidOperationException) { }
        }

        // Flush any notifications added since the last render to Faro (ported from MainLayout).
        await FaroBridge.FlushAsync();
    }

    [JSInvokable]
    public async Task HandleGlobalKey(string key)
    {
        switch (key)
        {
            case "Escape":
                // Priority: sidebar open → shortcut help → propagate to pages.
                if (_sidebarOpen)
                    _sidebarOpen = false;
                else if (_showShortcutHelp)
                    _showShortcutHelp = false;
                else
                    OnEscapePressed?.Invoke();
                break;
            case "?":
                _showShortcutHelp = !_showShortcutHelp;
                break;
        }
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    private void CloseShortcutHelp()
    {
        _showShortcutHelp = false;
        StateHasChanged();
    }

    private async Task ToggleTheme()
    {
        _theme = _theme == "dark" ? "light" : "dark";
        try { await JS.InvokeVoidAsync("setTheme", _theme); }
        catch (JSException) { }
        catch (InvalidOperationException) { }
    }

    public async ValueTask DisposeAsync()
    {
        State.OnChange -= HandleStateChanged;
        State.OnProjectChanged -= HandleProjectChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        // Push disconnect while JS is still available (ported from MainLayout; FaroService swallows a dead circuit).
        await Faro.PushEventAsync("blazor.circuit.disconnected");
        try { await JS.InvokeVoidAsync("unregisterGlobalKeyboardHandler"); }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
        _dotNetRef?.Dispose();
    }
}
