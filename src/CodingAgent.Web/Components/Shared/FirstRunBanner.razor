@using CodingAgent.Api.Client
@inject IPipelineApiConfigClient ConfigClient
@inject NavigationManager Navigation

@if (_show)
{
    <div class="first-run-banner" role="alert" aria-live="polite">
        <span class="first-run-banner-message">
            No job templates configured. Go to <a href="pipelines"><strong>Pipelines → Pipeline Job Templates</strong></a> to set up your first template before the pipeline can dispatch work.
        </span>
        <button class="first-run-banner-dismiss" @onclick="DismissAsync" aria-label="Dismiss banner">Dismiss</button>
    </div>
}

@code {
    private bool _show;
    private bool _dismissed;

    protected override async Task OnInitializedAsync()
    {
        await EvaluateAsync();
    }

    private async Task EvaluateAsync()
    {
        var hasEnabled = await ConfigClient.HasEnabledTemplatesAsync(CancellationToken.None);
        var dismissedValue = await ConfigClient.GetKeyValueAsync("first_run_banner_dismissed", CancellationToken.None);
        _dismissed = dismissedValue == "true";

        var currentPath = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        // Suppress the banner when the user is already on the Pipelines page.
        // AgentCoding.razor registers both /pipelines and /agent-coding as valid routes.
        var onPipelines = string.Equals(currentPath, "/pipelines", StringComparison.OrdinalIgnoreCase)
                       || string.Equals(currentPath, "/agent-coding", StringComparison.OrdinalIgnoreCase);

        // show = noEnabledTemplates AND route != "/pipelines|/agent-coding" AND (notDismissed OR noEnabledTemplates)
        // Req 8.2: the third clause is intentionally redundant when noEnabledTemplates is true —
        // dismissal never suppresses the banner when there are no templates.
        var noEnabledTemplates = !hasEnabled;
        _show = noEnabledTemplates
                && !onPipelines
                && (!_dismissed || noEnabledTemplates);
    }

    private async Task DismissAsync()
    {
        await ConfigClient.SetKeyValueAsync("first_run_banner_dismissed", "true", CancellationToken.None);
        _dismissed = true;
        await EvaluateAsync();
        StateHasChanged();
    }
}
