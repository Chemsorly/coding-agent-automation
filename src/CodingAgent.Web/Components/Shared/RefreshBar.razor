@implements IAsyncDisposable
@inject IJSRuntime JS

@*
    RefreshBar — a consistent refresh toolbar for all live-data pages.
    Renders a manual Refresh button and an auto-refresh interval selector.
    Manages its own PeriodicTimer so callers don't need a separate <AutoRefresh/>.

    Usage (no persistence):
        <RefreshBar OnRefresh="LoadAsync" IsLoading="_loading" />

    Usage (with localStorage persistence):
        <RefreshBar OnRefresh="LoadAsync" IsLoading="_loading" StorageKey="autoRefresh.work" />

    Auto-refresh default is 1 minute. When StorageKey is provided, the selected interval is
    persisted to localStorage and restored on first render.
    The timer is cancelled and disposed on component teardown — no leaked timers.
    Invoking the EventCallback re-renders the parent, so handlers need no explicit StateHasChanged.
*@

@code {
    // Interval options shown in the dropdown.  0 = Off (no polling).
    private static readonly (int Seconds, string Label)[] Intervals =
    [
        (0,   "Off"),
        (10,  "10s"),
        (30,  "30s"),
        (60,  "1m"),
        (300, "5m"),
    ];
}

<div class="refresh-bar">
    <button class="cockpit-pager-btn" @onclick="HandleManualRefresh" disabled="@IsLoading" title="Refresh now">
        <Icon Name="refresh-cw" Size="14" /> Refresh
    </button>
    <label class="refresh-bar-label">
        <span class="refresh-bar-interval-label">Auto-refresh:</span>
        <select class="time-window-select refresh-bar-select"
                value="@_intervalSeconds"
                @onchange="HandleIntervalChanged"
                title="Auto-refresh interval">
            @foreach (var (sec, label) in Intervals)
            {
                <option value="@sec">@label</option>
            }
        </select>
    </label>
</div>

@code {
    /// <summary>Invoked when the Refresh button is clicked or on each auto-refresh tick.</summary>
    [Parameter] public EventCallback OnRefresh { get; set; }

    /// <summary>When true, the Refresh button is disabled (the page is already loading).</summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>
    /// Optional localStorage key for persisting the selected auto-refresh interval.
    /// When null (default), no localStorage reads or writes are performed — behaviour
    /// is identical to before this parameter was added.
    /// </summary>
    [Parameter] public string? StorageKey { get; set; }

    // 60 = 1 minute (default). 0 = Off (no auto-refresh).
    // TODO [WARNING]: The acceptance criterion states "defaults to Off", but the original
    // implementation (pre-#2491) used 60s as the default and the existing tests assert 60s.
    // Confirm whether the pre-existing default was 0 or 60 and align the criterion, the field
    // initialiser, and the tests. This is a pre-existing ambiguity, not introduced by this PR.
    private int _intervalSeconds = 60;

    private PeriodicTimer? _timer;
    private CancellationTokenSource? _timerCts;

    // Guards the second RestartTimer call in OnAfterRenderAsync (the localStorage-override path)
    // against running after DisposeAsync has already torn down the timer.
    private bool _disposed;

    private async Task HandleManualRefresh() => await OnRefresh.InvokeAsync();

    // TODO [WARNING]: OnAfterRenderAsync fires once per component lifetime (firstRender==true), which
    // is the correct hook here. If SetParametersAsync or OnParametersSetAsync triggers a synchronous
    // re-render before this async path completes, RestartTimer can be called while the first-render
    // timer setup is still in-flight. RestartTimer handles concurrent re-entry safely (it cancels the
    // previous CTS before creating a new one), so the practical risk is only a redundant cancel+recreate
    // cycle rather than a leaked timer. Low probability, but worth monitoring if timer state looks off.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Always start the default timer first. This preserves the original behaviour for
        // callers that don't pass StorageKey, and ensures the timer starts even when
        // StorageKey is set but no stored value exists yet (first visit, or stored value
        // equals the current default — the localStorage override path below only fires
        // when a stored value differs from _intervalSeconds).
        await RestartTimer();

        if (StorageKey is null) return;

        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorageGet", StorageKey);
            if (!_disposed && int.TryParse(raw, out var secs) && Intervals.Any(i => i.Seconds == secs) && secs != _intervalSeconds)
            {
                _intervalSeconds = secs;
                await RestartTimer();
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
    }

    private async Task HandleIntervalChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var secs) || secs < 0) return;
        _intervalSeconds = secs;
        if (StorageKey is not null)
        {
            try { await JS.InvokeVoidAsync("localStorageSet", StorageKey, secs.ToString()); }
            catch (JSDisconnectedException) { }
            catch (JSException) { }
            catch (InvalidOperationException) { }
        }
        await RestartTimer();
    }

    private async Task RestartTimer()
    {
        // Cancel and dispose the existing timer, if any.
        if (_timerCts is not null)
        {
            try { await _timerCts.CancelAsync(); } catch (ObjectDisposedException) { }
            _timer?.Dispose();
            _timerCts.Dispose();
            _timer = null;
            _timerCts = null;
        }

        if (_intervalSeconds <= 0) return;

        _timerCts = new CancellationTokenSource();
        var timer = new PeriodicTimer(TimeSpan.FromSeconds(_intervalSeconds));
        _timer = timer;
        var token = _timerCts.Token;
        _ = RunTickLoopAsync(timer, OnRefresh, token);
    }

    private static async Task RunTickLoopAsync(PeriodicTimer timer, EventCallback onRefresh, CancellationToken ct)
    {
        // Timer is passed as a local parameter (not read from the shared _timer field) so that
        // a concurrent RestartTimer call that disposes and nulls _timer does not affect this loop.
        // Cancellation is the correct exit path: RestartTimer calls CancelAsync() on the token
        // before disposing the timer, so WaitForNextTickAsync throws OperationCanceledException
        // and the loop exits cleanly before the timer is disposed.
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                try
                {
                    await onRefresh.InvokeAsync();
                }
                catch (OperationCanceledException)
                {
                    // Cancellation during callback — propagate to exit the loop.
                    throw;
                }
                catch
                {
                    // Swallow transient callback exceptions (e.g. HttpRequestException on a
                    // network hiccup) so the auto-refresh loop survives and retries on the next
                    // tick. Without this guard, a single callback failure permanently kills
                    // auto-refresh for the component lifetime with no log or user-visible
                    // indication. Pages like Attention and Insights whose callbacks lack an
                    // outer bare catch{} are the primary beneficiaries.
                }
            }
        }
        catch (OperationCanceledException) { }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        // Set _disposed before any await so that OnAfterRenderAsync's localStorage-override
        // path (which awaits localStorageGet) sees the flag and skips the second RestartTimer.
        _disposed = true;
        if (_timerCts is not null)
        {
            try { await _timerCts.CancelAsync(); } catch (ObjectDisposedException) { }
            _timer?.Dispose();
            _timerCts.Dispose();
        }
    }
}
