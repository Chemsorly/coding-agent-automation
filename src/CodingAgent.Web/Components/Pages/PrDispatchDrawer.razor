@using CodingAgent.Pipeline.Interfaces
@using CodingAgent.Pipeline.Models
@inherits DispatchDrawerBase<PullRequestSummary>

<DispatchDrawerFrame IsOpen="IsOpen" Title="Browse Pull Requests" HeaderPrefix="HeaderPrefix" OnClose="Close">
    @if (Template != null)
    {
        <div class="agent-detail-section">
            <h4>Template: @Template.Name</h4>
        </div>

        @if (IsLoading)
        {
            <div class="loading-text" style="padding: 12px;">Loading pull requests...</div>
        }
        else
        {
            <div style="padding: 0 0 8px;">
                <input type="text" @bind="_filter" @bind:event="oninput" @bind:after="ApplyFilter"
                       placeholder="Filter by number or title..." style="width: 100%; padding: 6px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 0.82rem;" />
            </div>

            <DrawerLabelFilter AvailableLabels="AvailableLabels" SelectedLabels="SelectedLabels" OnToggleLabel="OnToggleLabel" OnClearLabels="OnClearLabels" />

            @if (PullRequests.Count == 0)
            {
                <div class="monitoring-empty">No open pull requests found.</div>
            }
            else
            {
                <div class="agent-history-list" tabindex="0" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="ShouldPreventDefault"
                     style="max-height: calc(100vh - 380px); overflow-y: auto;">
                    @{ var idx = 0; }
                    @foreach (var pr in FilteredItems)
                    {
                        var processingStatus = GetProcessingStatus(pr.Identifier);
                        var isProcessing = processingStatus.HasValue;
                        var currentIdx = idx;
                        <div class="drawer-issue-item @(isProcessing ? "drawer-issue-dispatched" : "") @(SelectedItem?.Identifier == pr.Identifier ? "drawer-issue-selected" : "") @GetHighlightClass(currentIdx)"
                             @onclick="() => SelectItem(pr)"
                             data-testid="pr-row-@pr.Identifier"
                             style="@(isProcessing ? "opacity: 0.6; pointer-events: none;" : "")">
                            <div class="drawer-issue-header">
                                <span class="drawer-issue-number">PR #@pr.Identifier</span>
                                @if (pr.IsDraft)
                                {
                                    <span class="badge-default" style="background: var(--text-muted); color: white;">DRAFT</span>
                                }
                                @if (processingStatus == WorkItemStatus.Running || processingStatus == WorkItemStatus.Dispatched)
                                {
                                    <span class="badge-default" style="background: var(--accent-fill); color: white;">Running</span>
                                }
                                else if (processingStatus == WorkItemStatus.Pending)
                                {
                                    @* "Queued" = work item is Pending; not yet dispatched to a pod. *@
                                    <span class="badge-default" style="background: var(--accent-fill); color: white;">Queued</span>
                                }
                            </div>
                            <div class="drawer-issue-title">@pr.Title</div>
                            <div class="drawer-issue-labels">
                                <span class="sidebar-label" style="background: var(--bg-hover); font-size: 0.7rem;">@pr.BranchName → @pr.TargetBranch</span>
                                @foreach (var label in pr.Labels.Take(4))
                                {
                                    <span class="sidebar-label @UiFormatters.GetLabelClass(label)">@label</span>
                                }
                            </div>
                        </div>
                        idx++;
                    }
                </div>

                <DrawerPager Page="Page" HasMore="HasMore" OnPrevPage="OnPrevPage" OnNextPage="OnNextPage" />
            }

            @if (SelectedItem != null)
            {
                <div class="agent-detail-section" style="margin-top: 12px; border-top: 1px solid var(--border); padding-top: 12px;">
                    <h4>PR #@SelectedItem.Identifier — @SelectedItem.Title</h4>
                    <div style="font-size: 0.78rem; color: var(--text-muted); margin-bottom: 4px;">
                        @SelectedItem.BranchName → @SelectedItem.TargetBranch
                    </div>
                    <div class="drawer-issue-labels" style="margin-bottom: 8px;">
                        @foreach (var label in SelectedItem.Labels)
                        {
                            <span class="sidebar-label @UiFormatters.GetLabelClass(label)">@label</span>
                        }
                    </div>
                    @if (SelectedItem.IsDraft)
                    {
                        <div class="settings-status status-error" style="margin-bottom: 8px; font-size: 0.78rem;">
                            <Icon Name="alert-triangle" /> This PR is a draft. Review will still be dispatched.
                        </div>
                    }
                    @if (SelectedItem.CreatedAt.HasValue)
                    {
                        <p style="font-size: 0.78rem; color: var(--text-muted); margin: 0 0 8px;">
                            Created: @SelectedItem.CreatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </p>
                    }
                    @if (CanDispatch)
                    {
                    <button class="btn-save" @onclick="DispatchSelected" disabled="@IsDispatching"
                            data-testid="dispatch-pr-btn">
                        @(IsDispatching ? "Dispatching..." : $"Start Review on PR #{SelectedItem.Identifier}")
                    </button>
                    }
                </div>
            }
        }
    }
</DispatchDrawerFrame>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PullRequestSummary> PullRequests { get; set; } = [];

    protected override void OnParametersSet()
    {
        Items = PullRequests;
        base.OnParametersSet();
    }

    protected override void SelectItem(PullRequestSummary item) => SelectedItem = item;

    protected override async Task DispatchSelected()
    {
        if (SelectedItem == null || !CanDispatch) return;
        await OnDispatch.InvokeAsync(SelectedItem);
        SelectedItem = null;
    }

    protected override bool MatchesFilter(PullRequestSummary item, string filter) =>
        item.Identifier.Contains(filter, StringComparison.OrdinalIgnoreCase)
        || item.Title.Contains(filter, StringComparison.OrdinalIgnoreCase);

    protected override string GetIdentifier(PullRequestSummary item) => item.Identifier;
}
