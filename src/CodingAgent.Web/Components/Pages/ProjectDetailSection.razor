                <span class="global-default-hint">Using global default (click Override to customize)</span>
            }
        </div>
    };

    private IEnumerable<PipelineJobTemplate> GetAvailableTemplates()
    {
        var currentProjectIds = _project.TemplateIds.ToHashSet();
        return _allTemplates.Where(t => !currentProjectIds.Contains(t.Id));
    }

    private async Task AddTemplate()
    {
        if (string.IsNullOrEmpty(_selectedTemplateToAdd)) return;

        // Find source project that currently owns this template
        var sourceProject = _allProjects.FirstOrDefault(p => p.TemplateIds.Contains(_selectedTemplateToAdd));
        if (sourceProject is null)
        {
            await OnShowStatus.InvokeAsync(("Template not found in any project.", true));
            return;
        }

        try
        {
            await ConfigClient.MoveTemplateAsync(sourceProject.Id, _project.Id, _selectedTemplateToAdd, _cts.Token);
            _selectedTemplateToAdd = null;
            await LoadDataAsync();
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Template added to project.", false));
        }
        catch (OperationCanceledException)
        {
            // TODO: Re-throwing OperationCanceledException from a Blazor event handler propagates through
            // the renderer's event dispatch path. On Blazor Server this tears down the SignalR circuit;
            // on WASM it surfaces as an unhandled JS exception. Neither produces a visible UI error.
            // The correct pattern for routine cancellation (user navigating away) is to swallow this
            // silently (or log it) rather than re-throw. Fix by replacing `throw` with a silent return
            // or a log-only call.
            throw;
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to add template: {ex.Message}", true));
        }
    }

    private async Task RemoveTemplate(int index)
    {
        var templateId = _project.TemplateIds[index];

        try
        {
            await ConfigClient.MoveTemplateAsync(_project.Id, WellKnownIds.DefaultProjectId, templateId, _cts.Token);
            await LoadDataAsync();
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Template moved to Default project.", false));
        }
        catch (OperationCanceledException)
        {
            throw;
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to remove template: {ex.Message}", true));
        }
    }

    private async Task MoveTemplateToProject(string templateId, string? targetProjectId)
    {
        if (string.IsNullOrEmpty(targetProjectId)) return;

        try
        {
            await ConfigClient.MoveTemplateAsync(_project.Id, targetProjectId, templateId, CancellationToken.None);
            await LoadDataAsync();
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Template moved to another project.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to move template: {ex.Message}", true));
        }
    }

    private async Task SaveOverviewAsync()
    {
        try
