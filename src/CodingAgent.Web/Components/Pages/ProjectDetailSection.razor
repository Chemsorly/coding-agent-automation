@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.CodeReview.Models
@using CodingAgent.Pipeline.Models
@using System.Text.RegularExpressions
@implements IAsyncDisposable

<section class="settings-section">
    <h2>@_project.Name</h2>
    <p class="section-description">Project configuration — overview, template membership, and behavioral settings that override global defaults.</p>

    <div class="project-tabs">
        <button class="tab-btn @(IsTab(TabOverview))" @onclick="() => SetTab(TabOverview)">Overview</button>
        <button class="tab-btn @(IsTab(TabTemplates))" @onclick="() => SetTab(TabTemplates)">Templates</button>
        <button class="tab-btn @(IsTab(TabSecrets))" @onclick="() => SetTab(TabSecrets)">Secrets</button>
        <button class="tab-btn @(IsTab(TabSettings))" @onclick="() => SetTab(TabSettings)">Settings</button>
        <button class="tab-btn @(IsTab(TabMcp))" @onclick="() => SetTab(TabMcp)">MCP Servers</button>
        @if (!IsDefaultProject)
        {
            <button class="tab-btn @(IsTab(TabReview))" @onclick="() => SetTab(TabReview)">Project Review</button>
        }
    </div>

    @if (_activeTab == TabOverview)
    {
        @RenderOverviewTab()
    }
    else if (_activeTab == TabTemplates)
    {
        @RenderTemplatesTab()
    }
    else if (_activeTab == TabSecrets)
    {
        @RenderSecretsTab()
    }
    else if (_activeTab == TabSettings)
    {
        @RenderSettingsTab()
    }
    else if (_activeTab == TabMcp)
    {
        @RenderMcpTab()
    }
    else if (_activeTab == TabReview && !IsDefaultProject)
    {
        @RenderReviewTab()
    }
</section>

@code {
    // Multi-line placeholders are C# strings: in an attribute of a rendered element, "&#10;" would show up as text.
    private const string SteeringPlaceholder =
        "## Code Style\n- Use descriptive variable names\n- Prefer composition over inheritance\n\n" +
        "## Build & Test\n- Always run the build after changes\n- Run tests before considering work complete\n\n" +
        "## Tool Preferences\n- Use context7 to look up library documentation before using unfamiliar APIs\n" +
        "- Use sequential-thinking for complex multi-step reasoning";
    private const string McpHeadersPlaceholder = "Authorization=Bearer mytoken\nX-Org=myorg";

    private const string TabOverview = "overview";
    private const string TabTemplates = "templates";
    private const string TabSecrets = "secrets";
    private const string TabSettings = "settings";
    private const string TabMcp = "mcp";
    private const string TabReview = "review";

    [Parameter, EditorRequired] public string ProjectId { get; set; } = default!;
    [Parameter, EditorRequired] public IPipelineApiConfigClient ConfigClient { get; set; } = default!;
    [Parameter] public EventCallback OnProjectSaved { get; set; }
    [Parameter] public EventCallback<(string Message, bool IsError)> OnShowStatus { get; set; }

    private string _activeTab = TabOverview;

    private string IsTab(string tab) => _activeTab == tab ? "active" : "";
    private void SetTab(string tab) { _activeTab = tab; }
    private PipelineProject _project = new() { Id = "", Name = "" };
    private PipelineConfiguration _globalConfig = new();
    private List<ProviderConfig> _issueProviders = new();
    private List<PipelineJobTemplate> _allTemplates = new();
    private IReadOnlyList<PipelineProject> _allProjects = [];

    // Overview fields
    private string _name = "";
    private string _description = "";
    private bool _enabled = true;
    private string? _epicIssueProviderId;

    // Steering
    private string? _steeringContent;

    // Project review. The page edits the first reviewer; others, set through the API, are kept as they are.
    private bool _projectReviewEnabled;
    private string _projectReviewPrompt = PipelineConfigurationDefaults.DefaultProjectReviewPrompt;

    // The Default project holds templates that belong to no product, so it has no project review.
    private bool IsDefaultProject => _project.Id == WellKnownIds.DefaultProjectId;

    // The Settings tab edits the overrides on this copy of the project; saving takes them over (see SaveSettingsAsync).
    private PipelineProject _draft = new() { Id = "", Name = "" };

    // Blacklisted paths (null = inherit global)
    private string? _blacklistedPathsText;

    // Template management
    private string? _selectedTemplateToAdd;

    private readonly CancellationTokenSource _cts = new();

    // Secrets management
    private List<SecretEntry> _secrets = new();
    private HashSet<int> _revealedSecrets = new();
    private static readonly Regex SecretKeyPattern = new(@"^[A-Za-z_][A-Za-z0-9_]*$", RegexOptions.Compiled, matchTimeout: TimeSpan.FromSeconds(1));

    // MCP Servers management
    private List<McpServerFormModel> _mcpServers = new();
    private bool _showMcpForm;
    private int _editingMcpIndex = -1;
    private McpServerFormModel _mcpForm = new();

    // The project the tabs were loaded for. The parent re-renders this section whenever it shows a status, so reloading
    // on every parameter set would discard the unsaved edits after a refused save; only another project is loaded.
    private string? _loadedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == _loadedProjectId)
            return;
        _loadedProjectId = ProjectId;
        await LoadDataAsync();
    }

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }

    private async Task LoadDataAsync()
    {
        var project = await ConfigClient.GetProjectByIdAsync(ProjectId, CancellationToken.None);
        if (project is null)
        {
            // New project being created — pre-populate with defaults, don't persist yet
            _project = new PipelineProject { Id = ProjectId, Name = "", Enabled = true };
        }
        else
        {
            _project = project;
        }
        _globalConfig = await ConfigClient.GetPipelineConfigAsync(CancellationToken.None);
        _issueProviders = (await ConfigClient.GetProviderConfigsAsync(ProviderKind.Issue, CancellationToken.None)).ToList();
        _allTemplates = (await ConfigClient.GetAllTemplatesAsync(CancellationToken.None)).ToList();
        _allProjects = await ConfigClient.GetProjectsAsync(CancellationToken.None);

        // Populate overview fields
        _name = _project.Name;
        _description = _project.Description ?? "";
        _enabled = _project.Enabled;
        _epicIssueProviderId = _project.EpicIssueProviderId;

        // Populate secrets
        _secrets = _project.Secrets?.Select(kv => new SecretEntry { Key = kv.Key, Value = kv.Value }).ToList() ?? new();
        _revealedSecrets.Clear();

        // Populate settings overrides
        _draft = _project;
        _blacklistedPathsText = _project.BlacklistedPaths != null ? string.Join(",", _project.BlacklistedPaths) : null;
        _steeringContent = _project.SteeringContent;

        // Populate the project review; an empty prompt shows the default one
        _projectReviewEnabled = _project.ProjectReviewEnabled;
        _projectReviewPrompt = _project.ProjectReviewers.FirstOrDefault()?.Prompt is { } prompt && !string.IsNullOrWhiteSpace(prompt)
            ? prompt
            : PipelineConfigurationDefaults.DefaultProjectReviewPrompt;

        // Populate MCP Servers
        _mcpServers = _project.McpServers?.Select(s => new McpServerFormModel
        {
            Name = s.Name,
            Type = s.Type ?? "stdio",
            Command = s.Command ?? "",
            Args = string.Join(" ", s.Args),
            Url = s.Url ?? "",
            EnvVars = string.Join("\n", s.Env?.Select(kv => $"{kv.Key}={kv.Value}") ?? []),
            Headers = string.Join("\n", s.Headers?.Select(kv => $"{kv.Key}={kv.Value}") ?? []),
            Enabled = !s.Disabled
        }).ToList() ?? new();
        _showMcpForm = false;
        _editingMcpIndex = -1;
        _mcpForm = new();
    }

    private RenderFragment RenderOverviewTab() => __builder =>
    {
        <div class="provider-form">
            <div class="form-group">
                <label>Name</label>
                <input type="text" @bind="_name" maxlength="128" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <textarea @bind="_description" rows="3" maxlength="512"></textarea>
            </div>
            <div class="form-group form-checkbox">
                <label>
                    <input type="checkbox" @bind="_enabled" />
                    Enabled
                </label>
            </div>
            <div class="form-group">
                <div class="label-with-hint">
                    <label>Epic Issue Provider</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Optional centralized issue tracker for cross-repo epic decomposition. When set, the loop polls this provider for agent:epic issues.">?</span>
                </div>
                <select @bind="_epicIssueProviderId">
                    <option value="">— None —</option>
                    @foreach (var provider in _issueProviders)
                    {
                        <option value="@provider.Id">@provider.DisplayName</option>
                    }
                </select>
            </div>
            <div class="pipeline-form-actions">
                <button class="btn-save" @onclick="SaveOverviewAsync">Save Overview</button>
            </div>
        </div>
    };

    private RenderFragment RenderTemplatesTab() => __builder =>
    {
        <div class="provider-form">
            <h3>Templates in this project</h3>
            @if (_project.TemplateIds.Count == 0)
            {
                <p class="form-hint">No templates assigned to this project.</p>
            }
            else
            {
                <p class="form-hint">Listed by name, which is also the order the loop uses. The first enabled template with decomposition runs this project's epics.</p>
                <div class="template-list">
                    @for (var i = 0; i < _project.TemplateIds.Count; i++)
                    {
                        @RenderTemplateRow(i)
                    }
                </div>
            }

            <div class="template-add-row">
                <select @bind="_selectedTemplateToAdd">
                    <option value="">— Select template to add —</option>
                    @foreach (var template in GetAvailableTemplates())
                    {
                        <option value="@template.Id">@template.Name</option>
                    }
                </select>
                <button class="btn-save" disabled="@(string.IsNullOrEmpty(_selectedTemplateToAdd))" @onclick="AddTemplate">Add</button>
            </div>
        </div>
    };

    private RenderFragment RenderTemplateRow(int index) => __builder =>
    {
        var templateId = _project.TemplateIds[index];
        var template = _allTemplates.FirstOrDefault(t => t.Id == templateId);
        var displayName = template?.Name ?? $"Unknown ({templateId[..8]}...)";

        <div class="template-row">
            <span class="template-name">@displayName</span>
            <div class="template-actions">
                <select class="template-move-select" @onchange="e => MoveTemplateToProject(templateId, e.Value?.ToString())">
                    <option value="">Move to…</option>
                    @foreach (var proj in _allProjects.Where(p => p.Id != _project.Id))
                    {
                        <option value="@proj.Id">@proj.Name</option>
                    }
                </select>
                @if (_project.Id != WellKnownIds.DefaultProjectId)
                {
                    <button class="btn-icon btn-icon-danger" @onclick="() => RemoveTemplate(index)" title="Remove from project (moves to Default)">✕</button>
                }
            </div>
        </div>
    };

    private RenderFragment RenderSecretsTab() => __builder =>
    {
        <div class="provider-form">
            <h3>🔐 Project Secrets</h3>
            <p class="form-hint">Environment variables injected into every run for this project. Merged with repo-level secrets (repo wins on key collision).</p>
            <div class="secrets-section-body">
                @for (var i = 0; i < _secrets.Count; i++)
                {
                    var index = i;
                    var secret = _secrets[index];
                    var isRevealed = _revealedSecrets.Contains(index);
                    <div class="secret-row">
                        <input type="text"
                               class="secret-key-input"
                               value="@secret.Key"
                               @onchange="e => UpdateSecretKey(index, e.Value?.ToString() ?? string.Empty)"
                               placeholder="ENV_VAR_NAME" />
                        <input type="@(isRevealed ? "text" : "password")"
                               class="secret-value-input"
                               value="@secret.Value"
                               @onchange="e => UpdateSecretValue(index, e.Value?.ToString() ?? string.Empty)"
                               placeholder="secret value" />
                        <button type="button" class="btn-icon" title="@(isRevealed ? "Hide" : "Reveal")" @onclick="() => ToggleSecretVisibility(index)">@(isRevealed ? "🙈" : "👁")</button>
                        <button type="button" class="btn-icon btn-icon-danger" title="Remove" @onclick="() => RemoveSecret(index)">🗑</button>
                    </div>
                    @if (!string.IsNullOrEmpty(secret.ValidationError))
                    {
                        <div class="secret-validation-error">@secret.ValidationError</div>
                    }
                }
                <button type="button" class="btn-add-inline" @onclick="AddSecret">+ Add Secret</button>
            </div>
            <div class="pipeline-form-actions">
                <button class="btn-save" @onclick="SaveSecretsAsync">Save Secrets</button>
            </div>
        </div>
    };

    private RenderFragment RenderReviewTab() => __builder =>
    {
        var repositories = ProjectRepositoryNames();
        <div class="provider-form project-review">
            <h3>Project Review</h3>
            <p class="form-hint">A project reviewer joins every code review in this project's repositories, in implementation runs and PR review runs, and runs alongside the reviewers the repository's labels pick. It reads the project's other repositories and the connected MCP servers, and checks the change against the whole project: the contracts between the repositories, the project's decisions and its documentation.</p>
            <div class="form-group form-checkbox">
                <input type="checkbox" id="project-review-enabled" @bind="_projectReviewEnabled" />
                <label for="project-review-enabled">Enable project review</label>
            </div>
            <p class="form-hint">
                @if (repositories.Count > 1)
                {
                    @($"Each review clones the other repositories of this project, read-only and without push access: {string.Join(", ", repositories)}.")
                }
                else
                {
                    @("This project has one repository, so the project reviewer checks a change against the project's decisions and documentation only.")
                }
            </p>
            <div class="form-group">
                <label for="project-review-prompt">Reviewer Instructions</label>
                <textarea id="project-review-prompt" @bind="_projectReviewPrompt" rows="20"></textarea>
                <button type="button" class="btn-revert" disabled="@IsDefaultReviewPrompt" @onclick="() => _projectReviewPrompt = PipelineConfigurationDefaults.DefaultProjectReviewPrompt">Reset to default</button>
                <p class="form-hint">Each run adds the list of the cloned repositories to these instructions.</p>
            </div>
            <div class="pipeline-form-actions">
                <button class="btn-save" @onclick="SaveProjectReviewAsync">Save Project Review</button>
            </div>
        </div>
    };

    private bool IsDefaultReviewPrompt =>
        string.Equals(_projectReviewPrompt.Trim(), PipelineConfigurationDefaults.DefaultProjectReviewPrompt.Trim(), StringComparison.Ordinal);

    /// <summary>The names of the project's enabled templates, one per repository.</summary>
    private List<string> ProjectRepositoryNames() => _allTemplates
        .Where(t => t.Enabled && _project.TemplateIds.Contains(t.Id))
        .Select(t => t.Name)
        .ToList();

    private RenderFragment RenderSettingsTab() => __builder =>
    {
        <div class="provider-form">
            <p class="form-hint">Override global defaults for this project. Fields set to "Using global default" inherit from the global pipeline configuration.</p>

            <h3>Retries &amp; Timeouts</h3>
            @RenderIntOverride("Max Retries", nameof(PipelineConfiguration.MaxRetries), () => _draft.MaxRetries, v => _draft = _draft with { MaxRetries = v }, _globalConfig.MaxRetries)
            @RenderIntOverride("Max Analysis Retries", nameof(PipelineConfiguration.MaxAnalysisRetries), () => _draft.MaxAnalysisRetries, v => _draft = _draft with { MaxAnalysisRetries = v }, _globalConfig.MaxAnalysisRetries)
            @RenderIntOverride("Agent Timeout (minutes)", nameof(PipelineConfiguration.AgentTimeout), () => Minutes(_draft.AgentTimeout), v => _draft = _draft with { AgentTimeout = FromMinutes(v) }, (int)_globalConfig.AgentTimeout.TotalMinutes, SettingUnit.Minutes)
            @RenderIntOverride("Max Infrastructure Retries", nameof(PipelineConfiguration.MaxInfrastructureRetries), () => _draft.MaxInfrastructureRetries, v => _draft = _draft with { MaxInfrastructureRetries = v }, _globalConfig.MaxInfrastructureRetries)
            @RenderIntOverride("Stall Warning Interval (seconds)", nameof(PipelineConfiguration.StallWarningInterval), () => Seconds(_draft.StallWarningInterval), v => _draft = _draft with { StallWarningInterval = FromSeconds(v) }, (int)_globalConfig.StallWarningInterval.TotalSeconds, SettingUnit.Seconds)
            @RenderIntOverride("Feedback Timeout (seconds)", nameof(PipelineConfiguration.FeedbackTimeoutSeconds), () => _draft.FeedbackTimeoutSeconds, v => _draft = _draft with { FeedbackTimeoutSeconds = v }, _globalConfig.FeedbackTimeoutSeconds)

            <h3>Analysis</h3>
            @RenderBoolOverride("Baseline Health Check Enabled", nameof(PipelineConfiguration.BaselineHealthCheckEnabled), () => _draft.BaselineHealthCheckEnabled, v => _draft = _draft with { BaselineHealthCheckEnabled = v }, _globalConfig.BaselineHealthCheckEnabled)
            @RenderBoolOverride("Analysis Review Enabled", nameof(PipelineConfiguration.AnalysisReviewEnabled), () => _draft.AnalysisReviewEnabled, v => _draft = _draft with { AnalysisReviewEnabled = v }, _globalConfig.AnalysisReviewEnabled)
            @RenderIntOverride("Analysis Refresh After Commits", nameof(PipelineConfiguration.AnalysisCommitThreshold), () => _draft.AnalysisCommitThreshold, v => _draft = _draft with { AnalysisCommitThreshold = v }, _globalConfig.AnalysisCommitThreshold)

            <h3>External CI</h3>
            @RenderIntOverride("CI Timeout (minutes)", nameof(PipelineConfiguration.ExternalCiTimeout), () => Minutes(_draft.ExternalCiTimeout), v => _draft = _draft with { ExternalCiTimeout = FromMinutes(v) }, (int)_globalConfig.ExternalCiTimeout.TotalMinutes, SettingUnit.Minutes)
            @RenderIntOverride("CI Poll Interval (seconds)", nameof(PipelineConfiguration.ExternalCiPollInterval), () => Seconds(_draft.ExternalCiPollInterval), v => _draft = _draft with { ExternalCiPollInterval = FromSeconds(v) }, (int)_globalConfig.ExternalCiPollInterval.TotalSeconds, SettingUnit.Seconds)
            @RenderIntOverride("CI Not Started Timeout (minutes)", nameof(PipelineConfiguration.CiNotStartedTimeout), () => Minutes(_draft.CiNotStartedTimeout), v => _draft = _draft with { CiNotStartedTimeout = FromMinutes(v) }, (int)_globalConfig.CiNotStartedTimeout.TotalMinutes, SettingUnit.Minutes)
            @RenderIntOverride("CI Not Started Max Retries", nameof(PipelineConfiguration.CiNotStartedMaxRetries), () => _draft.CiNotStartedMaxRetries, v => _draft = _draft with { CiNotStartedMaxRetries = v }, _globalConfig.CiNotStartedMaxRetries)
            @RenderIntOverride("CI Re-Polls After Branch Moves", nameof(PipelineConfiguration.CiCancelledMoveMaxRetries), () => _draft.CiCancelledMoveMaxRetries, v => _draft = _draft with { CiCancelledMoveMaxRetries = v }, _globalConfig.CiCancelledMoveMaxRetries)

            <h3>Code Review</h3>
            @RenderIntOverride("Review Iterations in Implementation Runs (0 = off)", "CodeReview.MaxIterations", () => _draft.CodeReview?.MaxIterations, v => SetCodeReview(o => o with { MaxIterations = v }), _globalConfig.CodeReview.MaxIterations)
            @RenderStringOverride("Fix Prompt", "CodeReview.FixPrompt", () => _draft.CodeReview?.FixPrompt, v => SetCodeReview(o => o with { FixPrompt = v }), _globalConfig.CodeReview.FixPrompt ?? "")
            @RenderBoolOverride("Acceptance Criteria Check", nameof(PipelineConfiguration.AcceptanceCriteriaEnabled), () => _draft.AcceptanceCriteriaEnabled, v => _draft = _draft with { AcceptanceCriteriaEnabled = v }, _globalConfig.AcceptanceCriteriaEnabled)
            @RenderBoolOverride("Inline Comments on PR Reviews", "CodeReview.InlineComments.Enabled", () => _draft.CodeReview?.InlineComments?.Enabled, v => SetInlineComments(o => o with { Enabled = v }), _globalConfig.CodeReview.InlineComments.Enabled)
            @RenderSeverityOverride("Minimum Severity for Inline Comments", "CodeReview.InlineComments.SeverityThreshold", () => _draft.CodeReview?.InlineComments?.SeverityThreshold, v => SetInlineComments(o => o with { SeverityThreshold = v }), _globalConfig.CodeReview.InlineComments.SeverityThreshold)
            @RenderIntOverride("Max Inline Comments per Review", "CodeReview.InlineComments.MaxInlineComments", () => _draft.CodeReview?.InlineComments?.MaxInlineComments, v => SetInlineComments(o => o with { MaxInlineComments = v }), _globalConfig.CodeReview.InlineComments.MaxInlineComments)
            @RenderBoolOverride("Prioritize Inline Comments by Severity", "CodeReview.InlineComments.OrderBySeverity", () => _draft.CodeReview?.InlineComments?.OrderBySeverity, v => SetInlineComments(o => o with { OrderBySeverity = v }), _globalConfig.CodeReview.InlineComments.OrderBySeverity)
            @RenderIntOverride("Format Correction Retries", "CodeReview.InlineComments.MaxRetries", () => _draft.CodeReview?.InlineComments?.MaxRetries, v => SetInlineComments(o => o with { MaxRetries = v }), _globalConfig.CodeReview.InlineComments.MaxRetries)

            <h3>Decomposition</h3>
            @RenderIntOverride("Max Sub-Issues Per Epic", nameof(PipelineConfiguration.MaxDecompositionSubIssues), () => _draft.MaxDecompositionSubIssues, v => _draft = _draft with { MaxDecompositionSubIssues = v }, _globalConfig.MaxDecompositionSubIssues)
            @RenderIntOverride("Max Files Per Sub-Issue", nameof(PipelineConfiguration.MaxDecompositionSubIssueFiles), () => _draft.MaxDecompositionSubIssueFiles, v => _draft = _draft with { MaxDecompositionSubIssueFiles = v }, _globalConfig.MaxDecompositionSubIssueFiles)
            @RenderIntOverride("Max Open Issues for Context", nameof(PipelineConfiguration.MaxOpenIssuesForContext), () => _draft.MaxOpenIssuesForContext, v => _draft = _draft with { MaxOpenIssuesForContext = v }, _globalConfig.MaxOpenIssuesForContext)

            <h3>Consolidation</h3>
            @RenderIntOverride("Max Refactoring Proposals", nameof(PipelineConfiguration.MaxRefactoringProposals), () => _draft.MaxRefactoringProposals, v => _draft = _draft with { MaxRefactoringProposals = v }, _globalConfig.MaxRefactoringProposals)
            @RenderBoolOverride("Refactoring Review Enabled", nameof(PipelineConfiguration.RefactoringReviewEnabled), () => _draft.RefactoringReviewEnabled, v => _draft = _draft with { RefactoringReviewEnabled = v }, _globalConfig.RefactoringReviewEnabled)
            @RenderBoolOverride("Brain Consolidation Review Enabled", nameof(PipelineConfiguration.BrainConsolidationReviewEnabled), () => _draft.BrainConsolidationReviewEnabled, v => _draft = _draft with { BrainConsolidationReviewEnabled = v }, _globalConfig.BrainConsolidationReviewEnabled)
            @RenderBoolOverride("Brain Read-Only", nameof(PipelineConfiguration.BrainReadOnly), () => _draft.BrainReadOnly, v => _draft = _draft with { BrainReadOnly = v }, _globalConfig.BrainReadOnly)

            <h3>Prompts</h3>
            @RenderStringOverride("Analysis Prompt", nameof(PipelineConfiguration.AnalysisPrompt), () => _draft.AnalysisPrompt, v => _draft = _draft with { AnalysisPrompt = v }, _globalConfig.AnalysisPrompt)
            @RenderStringOverride("Implementation Prompt", nameof(PipelineConfiguration.ImplementationPrompt), () => _draft.ImplementationPrompt, v => _draft = _draft with { ImplementationPrompt = v }, _globalConfig.ImplementationPrompt)
            @RenderStringOverride("Analysis Review Prompt", nameof(PipelineConfiguration.AnalysisReviewPrompt), () => _draft.AnalysisReviewPrompt, v => _draft = _draft with { AnalysisReviewPrompt = v }, _globalConfig.AnalysisReviewPrompt)
            @RenderStringOverride("Analysis Refinement Prompt", nameof(PipelineConfiguration.AnalysisRefinementPrompt), () => _draft.AnalysisRefinementPrompt, v => _draft = _draft with { AnalysisRefinementPrompt = v }, _globalConfig.AnalysisRefinementPrompt)

            <h3>Steering</h3>
            <div class="form-group">
                <label>Steering Instructions</label>
                <p class="form-hint">These instructions are provided to every agent working on issues in this project. Use them for cross-cutting rules like code style, build commands, tool preferences, or quality expectations.</p>
                <textarea @bind="_steeringContent" rows="15" placeholder="@SteeringPlaceholder"></textarea>
            </div>

            <h3>Commit Blacklist</h3>
            <div class="form-group override-group" data-setting="@nameof(PipelineConfiguration.BlacklistedPaths)">
                <div class="override-header">
                    <label>Blacklisted Paths</label>
                    @if (_blacklistedPathsText is not null)
                    {
                        <button class="btn-revert" @onclick="() => _blacklistedPathsText = null">Reset to global</button>
                    }
                    else
                    {
                        <button class="btn-override" @onclick="OverrideBlacklistedPaths">Override</button>
                    }
                </div>
                @if (_blacklistedPathsText is not null)
                {
                    <input type="text" @bind="_blacklistedPathsText" />
                    <span class="form-hint">Comma-separated paths excluded from commits. Overrides global blacklist for this project.</span>
                }
                else
                {
                    <span class="global-default-hint">Using global default: @string.Join(", ", _globalConfig.BlacklistedPaths)</span>
                }
            </div>

            <div class="pipeline-form-actions">
                <button class="btn-save" @onclick="SaveSettingsAsync">Save Settings</button>
            </div>
        </div>
    };

    // Each override renders with data-setting set to the setting's path; a test checks the tab offers every project-overridable setting.
    // Number inputs take their limits from the setting's [Range]; the API rejects a value outside it when the project is saved.
    private RenderFragment RenderIntOverride(string label, string setting, Func<int?> getter, Action<int?> setter, int globalDefault, SettingUnit unit = SettingUnit.None) => __builder =>
    {
        var value = getter();
        <div class="form-group override-group" data-setting="@setting">
            <div class="override-header">
                <label>@label</label>
                @if (value.HasValue)
                {
                    <button class="btn-revert" @onclick="() => { setter(null); }">Reset to global</button>
                }
                else
                {
                    <button class="btn-override" @onclick="() => { setter(globalDefault); }">Override</button>
                }
            </div>
            @if (value.HasValue)
            {
                <input type="number" value="@value.Value" @onchange="e => setter(int.TryParse(e.Value?.ToString(), out var v) ? v : null)" min="@SettingLimits.Min(setting, unit)" max="@SettingLimits.Max(setting, unit)" />
            }
            else
            {
                <span class="global-default-hint">Using global default: @globalDefault</span>
            }
        </div>
    };

    private RenderFragment RenderSeverityOverride(string label, string setting, Func<FindingSeverity?> getter, Action<FindingSeverity?> setter, FindingSeverity globalDefault) => __builder =>
    {
        var value = getter();
        <div class="form-group override-group" data-setting="@setting">
            <div class="override-header">
                <label>@label</label>
                @if (value.HasValue)
                {
                    <button class="btn-revert" @onclick="() => { setter(null); }">Reset to global</button>
                }
                else
                {
                    <button class="btn-override" @onclick="() => { setter(globalDefault); }">Override</button>
                }
            </div>
            @if (value.HasValue)
            {
                <select value="@value.Value" @onchange="e => setter(Enum.TryParse<FindingSeverity>(e.Value?.ToString(), out var v) ? v : null)">
                    <option value="@FindingSeverity.Critical">Critical</option>
                    <option value="@FindingSeverity.Warning">Warning</option>
                    <option value="@FindingSeverity.Suggestion">Suggestion</option>
                </select>
            }
            else
            {
                <span class="global-default-hint">Using global default: @globalDefault</span>
            }
        </div>
    };

    private RenderFragment RenderBoolOverride(string label, string setting, Func<bool?> getter, Action<bool?> setter, bool globalDefault) => __builder =>
    {
        var value = getter();
        <div class="form-group override-group" data-setting="@setting">
            <div class="override-header">
                <label>@label</label>
                @if (value.HasValue)
                {
                    <button class="btn-revert" @onclick="() => { setter(null); }">Reset to global</button>
                }
                else
                {
                    <button class="btn-override" @onclick="() => { setter(globalDefault); }">Override</button>
                }
            </div>
            @if (value.HasValue)
            {
                <label class="form-checkbox-inline">
                    <input type="checkbox" checked="@value.Value" @onchange="e => setter((bool?)e.Value)" />
                    @(value.Value ? "Enabled" : "Disabled")
                </label>
            }
            else
            {
                <span class="global-default-hint">Using global default: @(globalDefault ? "Enabled" : "Disabled")</span>
            }
        </div>
    };

    private RenderFragment RenderStringOverride(string label, string setting, Func<string?> getter, Action<string?> setter, string globalDefault) => __builder =>
    {
        var value = getter();
        <div class="form-group override-group" data-setting="@setting">
            <div class="override-header">
                <label>@label</label>
                @if (value is not null)
                {
                    <button class="btn-revert" @onclick="() => { setter(null); }">Reset to global</button>
                }
                else
                {
                    <button class="btn-override" @onclick="() => { setter(globalDefault); }">Override</button>
                }
            </div>
            @if (value is not null)
            {
                <textarea @bind="value" @bind:after="() => setter(value)" rows="4"></textarea>
            }
            else
