                Name = _name,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                Enabled = _enabled,
                EpicIssueProviderId = string.IsNullOrEmpty(_epicIssueProviderId) ? null : _epicIssueProviderId
            };

            await ConfigClient.SaveProjectAsync(_project, CancellationToken.None);
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Project overview saved.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to save: {ex.Message}", true));
        }
    }

    private async Task SaveSecretsAsync()
    {
        if (!ValidateSecrets()) return;

        try
        {
            _project = _project with { Secrets = BuildSecretsDictionary() };
            await ConfigClient.SaveProjectAsync(_project, CancellationToken.None);
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Project secrets saved.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to save: {ex.Message}", true));
        }
    }

    private async Task SaveProjectReviewAsync()
    {
        try
        {
            // The default instructions are stored as empty, so a project follows later changes to them
            var prompt = IsDefaultReviewPrompt ? "" : _projectReviewPrompt.Trim();
            var name = _project.ProjectReviewers.FirstOrDefault()?.Name is { } existing && !string.IsNullOrWhiteSpace(existing)
                ? existing
                : PipelineConfigurationDefaults.DefaultProjectReviewerName;
            var updated = _project with
            {
                ProjectReviewEnabled = _projectReviewEnabled,
                ProjectReviewers = [new ReviewAgent { Name = name, Prompt = prompt }, .. _project.ProjectReviewers.Skip(1)]
            };

            await ConfigClient.SaveProjectAsync(updated, CancellationToken.None);
            _project = updated;
            _draft = _draft with { ProjectReviewEnabled = updated.ProjectReviewEnabled, ProjectReviewers = updated.ProjectReviewers };
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Project review saved.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to save: {ex.Message}", true));
        }
    }

    private async Task SaveSettingsAsync()
    {
        try
        {
            if (!ValidateSecrets())
                return;

            // The draft holds the overrides; everything the other tabs own comes from the project as last saved.
            var updated = _draft with
            {
                Name = _project.Name,
                Description = _project.Description,
                Enabled = _project.Enabled,
                EpicIssueProviderId = _project.EpicIssueProviderId,
                Secrets = _project.Secrets,
                McpServers = _project.McpServers,
                ProjectReviewEnabled = _project.ProjectReviewEnabled,
                ProjectReviewers = _project.ProjectReviewers,
                TemplateIds = _project.TemplateIds,
                BlacklistedPaths = ParseBlacklistedPaths(_blacklistedPathsText),
                SteeringContent = string.IsNullOrWhiteSpace(_steeringContent) ? null : _steeringContent.Trim()
            };

            await ConfigClient.SaveProjectAsync(updated, CancellationToken.None);
            _project = updated;
            _draft = updated;
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Project settings saved.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to save: {ex.Message}", true));
        }
    }

    private static int? Minutes(TimeSpan? value) => value.HasValue ? (int)value.Value.TotalMinutes : null;
    private static int? Seconds(TimeSpan? value) => value.HasValue ? (int)value.Value.TotalSeconds : null;
    private static TimeSpan? FromMinutes(int? value) => value.HasValue ? TimeSpan.FromMinutes(value.Value) : null;
    private static TimeSpan? FromSeconds(int? value) => value.HasValue ? TimeSpan.FromSeconds(value.Value) : null;

    /// <summary>Changes the draft's code review overrides; overrides with nothing set become null (inherit everything).</summary>
    private void SetCodeReview(Func<CodeReviewOverrides, CodeReviewOverrides> change)
    {
        var next = change(_draft.CodeReview ?? new CodeReviewOverrides());
        var empty = next.FixPrompt is null && next.MaxIterations is null && next.InlineComments is null;
        _draft = _draft with { CodeReview = empty ? null : next };
    }

    private void SetInlineComments(Func<InlineCommentOverrides, InlineCommentOverrides> change)
    {
        var next = change(_draft.CodeReview?.InlineComments ?? new InlineCommentOverrides());
        var empty = next.Enabled is null && next.MaxInlineComments is null && next.MaxRetries is null
            && next.OrderBySeverity is null && next.SeverityThreshold is null;
        SetCodeReview(o => o with { InlineComments = empty ? null : next });
    }

    // --- Secrets management ---

    private void AddSecret()
    {
        _secrets.Add(new SecretEntry());
    }

    private void RemoveSecret(int index)
    {
        if (index >= 0 && index < _secrets.Count)
        {
            _secrets.RemoveAt(index);
            var newRevealed = new HashSet<int>();
            foreach (var i in _revealedSecrets)
            {
                if (i < index) newRevealed.Add(i);
                else if (i > index) newRevealed.Add(i - 1);
            }
            _revealedSecrets = newRevealed;
        }
    }

    private void UpdateSecretKey(int index, string value)
    {
        if (index >= 0 && index < _secrets.Count)
        {
            _secrets[index].Key = value;
            _secrets[index].ValidationError = null;
        }
    }

    private void UpdateSecretValue(int index, string value)
    {
        if (index >= 0 && index < _secrets.Count)
        {
            _secrets[index].Value = value;
        }
    }

    private void ToggleSecretVisibility(int index)
    {
        if (!_revealedSecrets.Remove(index))
            _revealedSecrets.Add(index);
    }

    private bool ValidateSecrets()
    {
        if (_secrets.Count == 0) return true;

        var isValid = true;
        var seenKeys = new HashSet<string>(StringComparer.Ordinal);

        foreach (var secret in _secrets)
        {
            secret.ValidationError = null;

            if (string.IsNullOrWhiteSpace(secret.Key))
            {
                secret.ValidationError = "Key is required.";
                isValid = false;
                continue;
            }

            if (!SecretKeyPattern.IsMatch(secret.Key))
            {
                secret.ValidationError = "Key must match POSIX env var pattern (letters, digits, underscores; cannot start with digit).";
                isValid = false;
                continue;
            }

            if (!seenKeys.Add(secret.Key))
            {
                secret.ValidationError = "Duplicate key.";
                isValid = false;
            }
        }

        return isValid;
    }

    private Dictionary<string, string>? BuildSecretsDictionary()
    {
        if (_secrets.Count == 0) return null;
        var dict = new Dictionary<string, string>();
        foreach (var secret in _secrets.Where(s => !string.IsNullOrWhiteSpace(s.Key)))
            dict[secret.Key] = secret.Value;
        return dict.Count > 0 ? dict : null;
    }

    private static IReadOnlyList<string>? ParseBlacklistedPaths(string? input)
    {
        if (input is null) return null;
        var paths = input.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();
        return paths.Count > 0 ? paths : null;
    }

    private void OverrideBlacklistedPaths()
    {
        _blacklistedPathsText = string.Join(",", _globalConfig.BlacklistedPaths);
    }

    private class SecretEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
        public string? ValidationError { get; set; }
    }

