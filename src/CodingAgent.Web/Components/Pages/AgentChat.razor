@page "/agent-chat"
@attribute [Authorize(Policy = AccessPolicies.AnyOperator)]
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgent.Pipeline.Interfaces
@using CodingAgent.Pipeline.Models
@using Microsoft.AspNetCore.SignalR.Client
@using Serilog
@inject IUiChatClient Chat
@inject IUiConfigClient UiConfig
@inject IJSRuntime JS
@inject IUiHubConnection HubConnection
@inject CurrentAccess Access

<PageTitle>Agent Chat - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Agent Chat</h1>
            <span class="cockpit-page-sub">Launch a dedicated chat pod for interactive sessions</span>
        </div>
    </div>

    <section class="settings-section">
        @if (!_isChatActive)
        {
            <!-- K8s mode: agent profile selection + pod launch -->
            <div class="cockpit-card-header"><h2><Icon Name="message-circle" Size="16" /> Interactive Chat</h2></div>
            <div class="chat-setup">
                <p class="chat-description">Select an agent profile to launch a dedicated chat pod.</p>

                <div class="chat-agent-select">
                    <label for="profile-select">Agent Profile:</label>
                    <select id="profile-select" @bind="_selectedProfileId" class="chat-select">
                        <option value="">— Select agent profile —</option>
                        @foreach (var profile in _chatProfiles)
                        {
                            <option value="@profile.Id">@profile.DisplayName (@string.Join(", ", profile.MatchLabels))</option>
                        }
                    </select>
                </div>

                @if (_profilesLoaded && _chatProfiles.Count == 0)
                {
                    <p class="form-hint">No enabled agent profile has a matching job template. Add one in Settings → Label Routing → Agent Profiles.</p>
                }

                <div class="chat-agent-select">
                    <label for="project-select-k8s">@(Access.HasGlobalOperate ? "Project (optional):" : "Project:")</label>
                    <select id="project-select-k8s" @bind="_selectedProjectId" @bind:after="OnProjectSelected" class="chat-select"
                            disabled="@_isChatActive">
                        @if (Access.HasGlobalOperate)
                        {
                            <option value="">— No project —</option>
                        }
                        @foreach (var p in _projects)
                        {
                            <option value="@p.Id">@p.Name</option>
                        }
                    </select>
                </div>

                @if (_launching)
                {
                    <div class="agent-detail-warning">
                        <Icon Name="loader" Size="16" /> Launching chat pod... (@_launchElapsedSeconds s / @_options_connectTimeout s)
                    </div>
                }

                @if (_launchError is not null)
                {
                    <div class="agent-detail-warning"><Icon Name="alert-triangle" Size="16" /> @_launchError</div>
                }

                <button class="btn-start-chat" @onclick="LaunchChatPod"
                        disabled="@(string.IsNullOrEmpty(_selectedProfileId) || _launching)">
                    <Icon Name="rocket" Size="16" /> Launch Chat Pod
                </button>
            </div>
        }
        else
        {
            <!-- Chat Window (shared by both modes) -->
            <div class="chat-window">
                <div class="chat-header-bar">
                    <span class="chat-agent-info">Chatting with <strong>@_selectedAgentId</strong> · model: <strong>@_resolvedModel</strong></span>
                    <button class="btn-end-chat" @onclick="EndChat">✕ End Chat</button>
                </div>

                <div class="chat-messages" @ref="_messagesContainer">
                    @foreach (var msg in _messages)
                    {
                        <div class="chat-message chat-message-@msg.Role.ToString().ToLowerInvariant()">
                            <div class="chat-message-header">
                                <span class="chat-role"><Icon Name="@GetRoleIconName(msg.Role)" Size="16" /> @msg.Role</span>
                                <span class="chat-timestamp">@msg.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                            </div>
                            <div class="chat-message-content">
                                <pre>@msg.Content</pre>
                            </div>
                        </div>
                    }
                    @if (_isWaitingForResponse)
                    {
                        <div class="chat-message chat-message-agent">
                            <div class="chat-message-header">
                                <span class="chat-role"><Icon Name="bot" Size="16" /> Agent</span>
                            </div>
                            <div class="chat-message-content chat-streaming">
                                <pre>@(_streamingContent.Length > 0 ? _streamingContent.ToString() : "⏳ Thinking...")</pre>
                            </div>
                        </div>
                    }
                </div>

                <div class="chat-input-area">
                    <textarea @bind="_currentPrompt" @bind:event="oninput"
                              @onkeydown="HandleKeyDown"
                              placeholder="Type your prompt... (Enter to send, Shift+Enter for newline)"
                              disabled="@_isWaitingForResponse"
                              class="chat-input" rows="2"></textarea>
                    <button class="btn-send" @onclick="SendPrompt"
                            disabled="@(_isWaitingForResponse || string.IsNullOrWhiteSpace(_currentPrompt))">
                        Send
                    </button>
                </div>
            </div>
        }
    </section>
</div>

@code {
    // ── Shared state ─────────────────────────────────────────────────────────
    private string _selectedAgentId = "";
    private bool _isChatActive;
    private bool _isWaitingForResponse;
    private string _currentPrompt = "";
    private string? _activeSessionId;
    private string _resolvedModel = "auto";

    // ── Hub event subscriptions ──────────────────────────────────────────────
    private IDisposable? _chatResponseSub;
    private IDisposable? _chatCompletedSub;
    // Held so it can be detached from HubConnection.Reconnected in EndChat and DisposeAsync.
    private Func<string?, Task>? _reconnectedHandler;

    // ── Project context (optional) ───────────────────────────────────────────
    private IReadOnlyList<UiProject> _projects = [];
    private string _selectedProjectId = "";  // empty = no project selected
    private UiProject? _selectedProject;

    private readonly List<ChatMessage> _messages = new();
    private readonly System.Text.StringBuilder _streamingContent = new();
    private ElementReference _messagesContainer;

    // ── K8s-mode state ───────────────────────────────────────────────────────
    // Profiles a chat can be launched for, from the API: enabled, and their labels name a job
    // template. The API takes the model, effort, auth mode and MCP servers from the profile.
    private IReadOnlyList<UiChatProfile> _chatProfiles = [];
    private bool _profilesLoaded;
    private string _selectedProfileId = "";
    private bool _launching;
    private string? _launchError;
    private int _launchElapsedSeconds;
    private CancellationTokenSource? _cts;
    private System.Threading.Timer? _elapsedTimer;
    // Sends a keepalive to the API every ~30s while the chat window is open so the server
    // knows the circuit is still live and doesn't idle-kill the pod.
    private System.Threading.Timer? _keepaliveTimer;

    // Connect-timeout shown in the counter — the API's, loaded with the profiles.
    private int _options_connectTimeout = 120;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var options = await Chat.GetOptionsAsync();
            _chatProfiles = options.Profiles;
            _options_connectTimeout = options.ConnectTimeoutSeconds;
            _profilesLoaded = true;

            // Load available projects for the optional project context dropdown.
            // Spec 049 (D13): a chat runs with its project's MCP servers and secrets, so only projects
            // the user operates are offered; without a global role a project is mandatory.
            _projects = (await UiConfig.GetProjectsAsync())
                .Where(p => Access.CanOperate(p.Id))
                .OrderBy(p => p.Name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            // The page still renders; nothing can be launched until a reload succeeds.
            Log.Warning(ex, "AgentChat: failed to load the chat profiles or projects");
            _launchError = "Could not load the agent profiles and projects. Reload the page.";
        }
        if (!Access.HasGlobalOperate && _projects.Count > 0)
        {
            _selectedProjectId = _projects[0].Id;
            OnProjectSelected();
        }

        // Hub connection is NOT started here intentionally.
        // OnInitializedAsync runs during Blazor prerender (before the interactive circuit exists),
        // so calling StartAsync here would produce a 404. The hub is started in StartChat() instead,
        // which is invoked only from user action (after LaunchChatPod succeeds), post-circuit.
        // See RunPage.razor for the same pattern (hub start in OnAfterRenderAsync/firstRender).
    }

    // OnChatResponse: accumulate streaming lines into _streamingContent.
    private void HandleChatResponseReceived(string sessionId, IReadOnlyList<string> lines)
    {
        if (sessionId != _activeSessionId) return;
        InvokeAsync(() =>
        {
            foreach (var line in lines)
            {
                if (_streamingContent.Length > 0) _streamingContent.AppendLine();
                _streamingContent.Append(line);
            }
            StateHasChanged();
            _ = ScrollToBottom();
        });
    }

    // OnChatCompleted: finalise the message, release the waiting state.
    private void HandleChatCompleted(string sessionId, int exitCode, string? error)
    {
        if (sessionId != _activeSessionId) return;
        InvokeAsync(() =>
        {
            var content = _streamingContent.ToString();
            if (!string.IsNullOrWhiteSpace(content))
            {
                _messages.Add(new ChatMessage
                {
                    Role = ChatRole.Agent,
                    Content = content,
                    Timestamp = DateTime.UtcNow
                });
            }
            if (!string.IsNullOrEmpty(error))
            {
                _messages.Add(new ChatMessage
                {
                    Role = ChatRole.System,
                    Content = $"⚠️ {error} (exit code: {exitCode})",
                    Timestamp = DateTime.UtcNow
                });
            }
            _streamingContent.Clear();
            _isWaitingForResponse = false;
            // Do NOT clear _activeSessionId here — the chat session is still active and
            // waiting for the next prompt. Clearing it would prevent EndChat/DisposeAsync
            // from unsubscribing from the correct hub group. It is only cleared in EndChat.
            StateHasChanged();
            _ = ScrollToBottom();
        });
    }

    // ── Project selection handler (shared by both modes) ─────────────────────

    private void OnProjectSelected()
    {
        _selectedProject = string.IsNullOrEmpty(_selectedProjectId)
            ? null
            : _projects.FirstOrDefault(p => p.Id == _selectedProjectId);
    }

    // ── K8s-mode: launch chat pod ─────────────────────────────────────────────

    private async Task LaunchChatPod()
    {
        if (string.IsNullOrEmpty(_selectedProfileId) || _launching) return;

        _cts = new CancellationTokenSource();
        _launching = true;
        _launchError = null;
        _launchElapsedSeconds = 0;

        _elapsedTimer = new System.Threading.Timer(_ =>
        {
            InvokeAsync(() =>
            {
                _launchElapsedSeconds++;
                StateHasChanged();
            });
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));

        try
        {
            // The API checks operator on the project, resolves the profile and waits for the pod.
            var session = await Chat.StartAsync(_selectedProfileId, _selectedProject?.Id, _cts.Token);
            _selectedAgentId = session.AgentId;
            _resolvedModel = session.Model;
            await StartChat();
        }
        catch (OperationCanceledException) when (_cts?.IsCancellationRequested == true)
        {
            _launchError = "Launch cancelled.";
        }
        catch (InvalidOperationException ex)
        {
            // Refused, or the pod could not be started: the API's reason.
            _launchError = ex.Message;
        }
        catch (Exception ex)
        {
            _launchError = $"Launch failed: {ex.Message}";
            Log.Warning(ex, "AgentChat: unexpected error launching chat pod");
        }
        finally
        {
            _launching = false;
            if (_elapsedTimer is not null) { await _elapsedTimer.DisposeAsync(); _elapsedTimer = null; }
            StateHasChanged();
        }
    }

    // ── StartChat (K8s mode) ──────────────────────────────────────────────────

    private async Task StartChat()
    {
        // _selectedAgentId is always set by LaunchChatPod before this is called —
        // the guard that was here was a SignalR-era remnant and is unreachable.
        // The API keeps the chat window ID and whether a prompt was sent yet.

        _isChatActive = true;
        _messages.Clear();
        _streamingContent.Clear();

        // Start hub and register push handlers now — after the interactive circuit exists
        // and a chat pod is live. Starting here (from a user action) avoids the 404 that
        // occurs when StartAsync is called during OnInitializedAsync (prerender).
        // Handlers are registered before StartAsync so no events are missed during connection.
        _chatResponseSub?.Dispose();
        _chatCompletedSub?.Dispose();
        _chatResponseSub = HubConnection.On<string, IReadOnlyList<string>>(
            HubMethodNames.OnChatResponse, HandleChatResponseReceived);
        _chatCompletedSub = HubConnection.On<string, int, string?>(
            HubMethodNames.OnChatCompleted, HandleChatCompleted);

        if (HubConnection.State == HubConnectionState.Disconnected)
        {
            // TODO [WARNING]: Use _cts.Token instead of CancellationToken.None so that if the user
            // navigates away while StartAsync is in-flight, DisposeAsync cancelling _cts will also
            // interrupt the hub connection attempt. CancellationToken.None means the in-flight call
            // will not be cancelled on component teardown.
            try { await HubConnection.StartAsync(CancellationToken.None); }
            catch (Exception ex)
            {
                // TODO [WARNING]: On StartAsync failure the catch block swallows the exception but
                // _chatResponseSub and _chatCompletedSub remain pointing to freshly-registered handlers
                // on a hub that never connected. If the hub later reconnects via its own reconnect logic,
                // those stale handlers will fire against an unexpected session. Dispose and null both
                // subscription fields here so the component is in a clean state after a failed StartAsync.
                Log.Warning(ex, "AgentChat: hub connection start failed — responses will not stream");
            }
        }

        // Start sending keepalive heartbeats to the API so the server knows the chat window
        // is still open. Interval is 30s — well within the 90s default idle timeout.
        // The timer captures _selectedAgentId by value at creation time; if the field ever
        // changes (it doesn't in the current flow) the timer would send to the old agent,
        // which the API answers with 404, logged and ignored.
        var agentIdForKeepalive = _selectedAgentId;
        _keepaliveTimer = new System.Threading.Timer(_ =>
        {
            if (!string.IsNullOrEmpty(agentIdForKeepalive))
                _ = SendKeepaliveAsync(agentIdForKeepalive);
        }, null, TimeSpan.FromSeconds(30), TimeSpan.FromSeconds(30));

        // One subscription serves every prompt of this chat: replies carry their session ID. A reconnect is a
        // new hub connection without groups, so the handler joins the chat's group again.
        await JoinChatGroupAsync();
        _reconnectedHandler = _ => InvokeAsync(JoinChatGroupAsync);
        HubConnection.Reconnected += _reconnectedHandler;
    }

    // Joins the chat pod's group on the UI hub, which only the chat's owner may (spec 051 D7).
    private async Task JoinChatGroupAsync()
    {
        if (!_isChatActive || string.IsNullOrEmpty(_selectedAgentId) || HubConnection.State != HubConnectionState.Connected) return;
        try { await HubConnection.InvokeAsync(HubMethodNames.SubscribeToChat, _selectedAgentId, CancellationToken.None); }
        catch (Exception ex) { Log.Warning(ex, "AgentChat: joining the chat's hub group failed — responses will not stream"); }
    }

    private async Task LeaveChatGroupAsync()
    {
        if (string.IsNullOrEmpty(_selectedAgentId) || HubConnection.State != HubConnectionState.Connected) return;
        try { await HubConnection.InvokeAsync(HubMethodNames.UnsubscribeFromChat, _selectedAgentId, CancellationToken.None); }
        catch (Exception ex) { Log.Debug(ex, "AgentChat: leaving the chat's hub group failed"); }
    }

    // ── SendPrompt ────────────────────────────────────────────────────────────

    private async Task SendPrompt()
    {
        if (string.IsNullOrWhiteSpace(_currentPrompt) || _isWaitingForResponse) return;

        var prompt = _currentPrompt.Trim();
        _currentPrompt = "";

        _messages.Add(new ChatMessage { Role = ChatRole.User, Content = prompt, Timestamp = DateTime.UtcNow });
        _isWaitingForResponse = true;
        _streamingContent.Clear();

        try
        {
            // A new session ID per prompt: replies of an earlier prompt no longer match it.
            _activeSessionId = Guid.NewGuid().ToString();
            // The API builds the prompt (MCP servers, secrets, steering) and checks the chat is ours;
            // a refusal surfaces as InvalidOperationException with the reason.
            await Chat.SendPromptAsync(_selectedAgentId, _activeSessionId, prompt);
        }
        catch (Exception ex)
        {
            _activeSessionId = null;
            _messages.Add(new ChatMessage
            {
                Role = ChatRole.System,
                Content = $"❌ Failed to send prompt: {ex.Message}",
                Timestamp = DateTime.UtcNow
            });
            _isWaitingForResponse = false;
        }

        await ScrollToBottom();
    }

    // Best effort: a missed keepalive only shortens the idle window, and the next follows in 30s.
    private async Task SendKeepaliveAsync(string agentId)
    {
        try { await Chat.KeepaliveAsync(agentId); }
        catch (Exception ex) { Log.Debug(ex, "AgentChat: keepalive failed for agent {AgentId}", agentId); }
    }

    // ── EndChat ───────────────────────────────────────────────────────────────

    private async Task EndChat()
    {
        // Set inactive first to prevent concurrent DisposeAsync double-terminate
        _isChatActive = false;

        // Detach the reconnect handler so it cannot fire after the session ends.
        if (_reconnectedHandler is not null)
        {
            HubConnection.Reconnected -= _reconnectedHandler;
            _reconnectedHandler = null;
        }

        // Stop keepalive timer — pod is about to be terminated
        if (_keepaliveTimer is not null) { await _keepaliveTimer.DisposeAsync(); _keepaliveTimer = null; }

        await LeaveChatGroupAsync();
        await EndChatK8sModeAsync();

        _isWaitingForResponse = false;
        _activeSessionId = null;
        _messages.Clear();
        _streamingContent.Clear();
    }

    private async Task EndChatK8sModeAsync()
    {
        // Terminate the chat pod
        if (!string.IsNullOrEmpty(_selectedAgentId))
        {
            try
            {
                await Chat.TerminateAsync(_selectedAgentId);
            }
            catch (Exception ex)
            {
                Log.Warning(ex, "AgentChat: ending the chat failed for agent {AgentId}", _selectedAgentId);
            }
        }
    }

    // ── Keyboard + scroll helpers ─────────────────────────────────────────────

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendPrompt();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", "document.querySelector('.chat-messages')?.scrollTo(0, document.querySelector('.chat-messages')?.scrollHeight)");
        }
        catch (Exception ex) { Log.Debug(ex, "Failed to scroll chat to bottom"); }
    }

    private static string GetRoleIconName(ChatRole role) => role switch
    {
        ChatRole.User => "user",
        ChatRole.Agent => "bot",
        ChatRole.System => "settings",
        _ => "circle"
    };

    // ── IAsyncDisposable ──────────────────────────────────────────────────────

    public async ValueTask DisposeAsync()
    {
        // Detach the reconnect handler first, before any CTS cancellation, so that a
        // background-thread Reconnected event cannot fire after teardown begins.
        if (_reconnectedHandler is not null)
        {
            HubConnection.Reconnected -= _reconnectedHandler;
            _reconnectedHandler = null;
        }

        _chatResponseSub?.Dispose();
        _chatCompletedSub?.Dispose();

        if (_elapsedTimer is not null) { await _elapsedTimer.DisposeAsync(); _elapsedTimer = null; }
        if (_keepaliveTimer is not null) { await _keepaliveTimer.DisposeAsync(); _keepaliveTimer = null; }
        if (_cts is not null)
            await _cts.CancelAsync();
        _cts?.Dispose();

        if (_isChatActive)
            await LeaveChatGroupAsync();
        _activeSessionId = null; // prevent stale OnChatCompleted callbacks from passing the session-ID guard

        if (_isChatActive && !string.IsNullOrEmpty(_selectedAgentId))
        {
            await DisposeK8sChatAsync();
        }
    }

    private async Task DisposeK8sChatAsync()
    {
        // K8s mode: terminate the pod regardless of _isWaitingForResponse
        try
        {
            await Chat.TerminateAsync(_selectedAgentId);
        }
        catch (Exception ex)
        {
            Log.Warning(ex, "AgentChat: ending the chat failed on dispose for agent {AgentId}", _selectedAgentId);
        }
    }

    private sealed class ChatMessage
    {
        public required ChatRole Role { get; init; }
        public required string Content { get; init; }
        public required DateTime Timestamp { get; init; }
    }
}
