@page "/insights"
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models
@using CodingAgent.Pipeline.Services
@using CodingAgent.Web.Services
@using CodingAgent.Web.Components.Shared
@inject IPipelineApiRunHistoryClient RunHistory
@inject CockpitState State

@*
    Insights — trends over the most recent runs (see docs/frontend-redesign-handoff.md).
    All figures are computed from the fetched run window and labelled as such (not a fake 24h).
    Cost coverage is honest: TotalCost is null for Kiro, set for OpenCode.
    Per-gate failure ranking: PipelineRunSummary.QualityGateOutcomes (flattened from the run's
    LatestQualityReport at ToSummary) aggregated across the fetched window — failures counted per gate.
    Outcomes use RunOutcomeDisplay, so a merged PR counts as succeeded, a closed PR as cancelled and a
    conflict restart as its own (neutral) outcome — the same classification the Runs list shows.
*@

<PageTitle>Insights - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Insights</h1>
            <span class="cockpit-page-sub">Trends across the last @_total run@(_total == 1 ? "" : "s")@(_isTruncated ? $" (showing most recent {PageSize} — results may be partial)" : "")</span>
        </div>
        <div style="display: flex; align-items: center; gap: 8px;">
            @* TODO: [WARNING] OnRefresh is wired directly to LoadAsync, which sets _loading = true and
               replaces the entire page content with the "Loading…" card on every auto-refresh tick,
               causing a visible flash. Fix: extract a quiet reload variant that does not toggle _loading
               (keeping stale data visible while re-fetching) and wire the RefreshBar OnRefresh to that
               quiet path instead, matching the established convention used by Overview/Runs/Work. *@
            <RefreshBar OnRefresh="LoadAsync" IsLoading="@_loading" StorageKey="autoRefresh.insights" />

            @* TODO: [WARNING] Insights aggregates completed run metrics. The run-scoped hub events
               (OnRunCompleted) are not wired here because they are sent only to run-specific groups.
               A global "any run completed" broadcast event on the hub would enable push-based refresh.
               Until then, the RefreshBar auto-refresh polling is the only mechanism for background updates. *@
            <label class="refresh-bar-label">
                <span class="refresh-bar-interval-label">Time window:</span>
                <select class="time-window-select refresh-bar-select" @bind="_recentWindowHours" @bind:after="LoadAsync" title="Filter all metrics to runs started within this window" aria-label="Time window">
                    <option value="1">1h</option>
                    <option value="6">6h</option>
                    <option value="24">24h</option>
                    <option value="168">7d</option>
                    <option value="0">All</option>
                </select>
            </label>
        </div>
    </div>

    @if (_loading)
    {
        <div class="cockpit-card"><div class="cockpit-empty">Loading…</div></div>
    }
    else if (_error is not null)
    {
        <div class="cockpit-card"><div class="cockpit-empty">@_error</div></div>
    }
    else if (_total == 0)
    {
        <div class="cockpit-card"><div class="cockpit-empty">No completed runs yet.</div></div>
    }
    else
    {
        var showCost = _anyRunHasTokens || _totalCost > 0m;

        <div class="cockpit-stat-strip">
            <div class="cockpit-stat" title="Succeeded ÷ (succeeded + failed + cancelled). Conflict restarts are left out — the re-dispatched run carries the outcome.">
                <span class="cockpit-stat-l">Success rate · @RecentWindowLabel</span>
                <span class="cockpit-stat-v">
                    @if (_successRate is { } successRate)
                    {
                        @successRate<span style="font-size: 15px; color: var(--text-faint);">%</span>
                    }
                    else
                    {
                        <text>—</text>
                    }
                </span>
            </div>
            <div class="cockpit-stat"><span class="cockpit-stat-l">Avg cycle time · @RecentWindowLabel</span><span class="cockpit-stat-v">@_avgCycle</span></div>
            <div class="cockpit-stat"><span class="cockpit-stat-l">Retry rate · @RecentWindowLabel</span><span class="cockpit-stat-v">@_retryRate<span style="font-size: 15px; color: var(--text-faint);">%</span></span></div>
            @if (_anyRunHasTokens)
            {
                <div class="cockpit-stat"><span class="cockpit-stat-l">Avg tokens / run · @RecentWindowLabel</span><span class="cockpit-stat-v">@CostFormatter.FormatTokens(_avgTokens)</span></div>
            }
        </div>

        <div class="cockpit-card cockpit-card-pad">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 14px;">
                <h2 style="margin: 0; font-size: 15px; font-weight: 700;">Run outcomes over time</h2>
                <div style="display: flex; gap: 14px; font-size: 11.5px; color: var(--text-muted);">
                    <span style="display:inline-flex;align-items:center;gap:5px;" title="Completed or PR merged"><span style="width:9px;height:9px;border-radius:2px;background:@SucceededColor;"></span>Succeeded</span>
                    <span style="display:inline-flex;align-items:center;gap:5px;"><span style="width:9px;height:9px;border-radius:2px;background:@FailedColor;"></span>Failed</span>
                    <span style="display:inline-flex;align-items:center;gap:5px;" title="Cancelled or PR closed"><span style="width:9px;height:9px;border-radius:2px;background:@CancelledColor;"></span>Cancelled</span>
                    @if (_restarted > 0)
                    {
                        <span style="display:inline-flex;align-items:center;gap:5px;" title="Superseded by a conflict restart"><span style="width:9px;height:9px;border-radius:2px;background:@RestartedColor;"></span>Restarted</span>
                    }
                </div>
            </div>
            <div style="display: flex; align-items: flex-end; gap: 5px; height: 120px;">
                @foreach (var slot in _days)
                {
                    <div style="flex: 1; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; min-width: 0;" title="@FormatSlotLabel(slot.SlotStart) — @slot.Total run(s)">
                        @if (slot.Restarted > 0) { <div style="height: @Px(slot.Restarted)px; background: @RestartedColor;"></div> }
                        @if (slot.Cancelled > 0) { <div style="height: @Px(slot.Cancelled)px; background: @CancelledColor;"></div> }
                        @if (slot.Failed > 0) { <div style="height: @Px(slot.Failed)px; background: @FailedColor;"></div> }
                        @if (slot.Succeeded > 0) { <div style="height: @Px(slot.Succeeded)px; background: @SucceededColor;"></div> }
                    </div>
                }
            </div>
            <div style="display: flex; justify-content: space-between; margin-top: 8px; font-size: 10.5px; color: var(--text-faint);">
                <span>@(_days.Count > 0 ? FormatSlotLabel(_days[0].SlotStart) : "")</span>
                <span>@(_days.Count > 0 ? FormatSlotLabel(_days[^1].SlotStart) : "")</span>
            </div>
        </div>

        @* Two columns only when the cost card is shown — otherwise the outcome mix spans the full width
           instead of leaving an empty right-hand column. *@
        <div class="@(showCost ? "cockpit-two-col-asymmetric" : null)">
            <!-- outcome mix -->
            <div class="cockpit-card cockpit-card-pad">
                <h2 style="margin: 0 0 14px; font-size: 15px; font-weight: 700;">Outcome mix</h2>
                <div style="display: flex; height: 14px; border-radius: 5px; overflow: hidden; background: var(--surface-alt);">
                    @if (_succeeded > 0)
                    {
                        <div style="width: @Pct(_succeeded)%; background: @SucceededColor;" title="Succeeded: @_succeeded"></div>
                    }
                    @if (_failed > 0)
                    {
                        <div style="width: @Pct(_failed)%; background: @FailedColor;" title="Failed: @_failed"></div>
                    }
                    @if (_cancelled > 0)
                    {
                        <div style="width: @Pct(_cancelled)%; background: @CancelledColor;" title="Cancelled: @_cancelled"></div>
                    }
                    @if (_restarted > 0)
                    {
                        <div style="width: @Pct(_restarted)%; background: @RestartedColor;" title="Restarted: @_restarted"></div>
                    }
                </div>
                <div style="display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 12px; font-size: 12.5px; color: var(--text-muted);">
                    <span style="display: inline-flex; align-items: center; gap: 6px;" title="Completed or PR merged"><span style="width: 9px; height: 9px; border-radius: 2px; background: @SucceededColor;"></span>Succeeded <strong style="color: var(--text);">@_succeeded</strong></span>
                    <span style="display: inline-flex; align-items: center; gap: 6px;"><span style="width: 9px; height: 9px; border-radius: 2px; background: @FailedColor;"></span>Failed <strong style="color: var(--text);">@_failed</strong></span>
                    <span style="display: inline-flex; align-items: center; gap: 6px;" title="Cancelled or PR closed"><span style="width: 9px; height: 9px; border-radius: 2px; background: @CancelledColor;"></span>Cancelled <strong style="color: var(--text);">@_cancelled</strong></span>
                    @if (_restarted > 0)
                    {
                        <span style="display: inline-flex; align-items: center; gap: 6px;" title="Superseded by a conflict restart"><span style="width: 9px; height: 9px; border-radius: 2px; background: @RestartedColor;"></span>Restarted <strong style="color: var(--text);">@_restarted</strong></span>
                    }
                </div>

                <div style="margin-top: 18px; border-top: 1px solid var(--hairline); padding-top: 14px;">
                    <h3 style="margin: 0 0 10px; font-size: 13px; font-weight: 700; color: var(--text-muted);">By run type</h3>
                    @foreach (var (type, count) in _byType.OrderByDescending(kv => kv.Value))
                    {
                        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                            <span style="width: 130px; font-size: 12.5px; color: var(--text-muted); flex-shrink: 0;">@type</span>
                            <div style="flex: 1; height: 12px; background: var(--surface-alt); border-radius: 4px; overflow: hidden;">
                                <div style="width: @Pct(count)%; height: 100%; background: var(--accent); border-radius: 4px;"></div>
                            </div>
                            <span class="mono" style="font-size: 12px; font-weight: 600; width: 30px; text-align: right;">@count</span>
                        </div>
                    }
                </div>
            </div>

            <!-- cost -->
            @if (showCost)
            {
                <div class="cockpit-card cockpit-card-pad">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        <h2 style="margin: 0; font-size: 15px; font-weight: 700;">Cost</h2>
                        <span style="font-size: 11px; font-weight: 600; color: var(--warning); background: var(--warning-bg); border: 1px solid var(--warning-border); padding: 2px 8px; border-radius: 999px;">OpenCode only</span>
                    </div>
                    <div class="cockpit-two-col" style="margin-top: 14px; gap: 12px;">
                        <div><div class="cockpit-stat-l">Total (reported)</div><div style="font-size: 20px; font-weight: 800;">@CostFormatter.FormatCost(_totalCost)</div></div>
                        <div><div class="cockpit-stat-l">Runs with cost</div><div style="font-size: 20px; font-weight: 800;">@_costCoverage%</div></div>
                    </div>
                    <div style="margin-top: 14px; border-top: 1px solid var(--hairline); padding-top: 12px;">
                        <div style="height: 8px; border-radius: 4px; background: var(--surface-alt); overflow: hidden;"><div style="width: @_costCoverage%; height: 100%; background: var(--accent);"></div></div>
                        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 9px; line-height: 1.5;">
                            Kiro runs don't report cost — the rest show tokens only. Coverage grows as OpenCode usage does.
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Quality gate failures</h2><span style="font-size: 12px; color: var(--text-muted);">recent runs with gate data</span></div>
            @if (_runsWithGateData == 0)
            {
                <div class="cockpit-empty" style="padding: 24px;">No gate data for runs in this window.</div>
            }
            else if (_gateRanking.Count == 0)
            {
                <div class="cockpit-empty" style="padding: 24px;">No gate failures in @_runsWithGateData run@(_runsWithGateData == 1 ? "" : "s") with gate data.</div>
            }
            else
            {
                @foreach (var g in _gateRanking)
                {
                    var rate = g.Total > 0 ? (int)Math.Round(100.0 * g.Failed / g.Total) : 0;
                    <div class="cockpit-run-row" style="cursor: default;">
                        <div style="min-width: 0; flex: 1;">
                            <div style="font-size: 13.5px; font-weight: 600;">@g.GateName</div>
                            <div style="height: 6px; border-radius: 3px; background: var(--surface-alt); margin-top: 6px; overflow: hidden;">
                                <div style="height: 100%; width: @rate%; background: var(--error);"></div>
                            </div>
                        </div>
                        <span style="flex-shrink: 0; font-size: 12.5px; color: var(--text-muted); min-width: 130px; text-align: right;">
                            <span style="font-weight: 700; color: var(--error);">@g.Failed</span> / @g.Total failed · @rate%
                        </span>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    // One page of history; the subtitle says so when in-window runs may lie beyond it (_isTruncated).
    private const int PageSize = 500;

    // Series colours come from the theme tokens so the chart matches the status badges in both themes.
    private const string SucceededColor = "var(--success)";
    private const string FailedColor = "var(--error)";
    private const string CancelledColor = "var(--text-faint)";
    private const string RestartedColor = "var(--accent-light)";

    private readonly CancellationTokenSource _cts = new();
    private bool _loading = true;
    private string? _error;

    private int _total;
    private int _succeeded, _failed, _cancelled, _restarted;
    private int? _successRate;
    private int _retryRate, _costCoverage;
    private string _avgCycle = "—";
    private long _avgTokens;
    private bool _anyRunHasTokens;
    private decimal _totalCost;
    private Dictionary<string, int> _byType = new();
    private List<TimeBucket> _days = new();
    private int _maxBucket = 1;
    private List<GateStat> _gateRanking = new();
    private int _runsWithGateData;
    private bool _isTruncated;

    // Time window for insights. 0 = all runs (no cutoff). Default 24h.
    private int _recentWindowHours = 24;

    private string RecentWindowLabel => _recentWindowHours switch
    {
        0 => "All runs",
        1 => "Last 1h",
        6 => "Last 6h",
        168 => "Last 7d",
        _ => "Last 24h"
    };

    protected override void OnInitialized() => State.OnProjectChanged += HandleProjectChanged;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Re-compute when the top-bar project scope changes.
    private async void HandleProjectChanged()
    {
        try
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    // TODO: [WARNING] LoadAsync is invoked via @bind:after="LoadAsync" on the time-window dropdown, making
    // rapid user changes more likely to interleave concurrent loads. The _cts token is passed to
    // GetRunHistoryAsync, but the time-window filtering and field assignments after 'await' are not guarded.
    // A stale load completing after a newer one can overwrite _total, _byType, etc. with data from the
    // wrong window. Fix: capture a local snapshot of _recentWindowHours at the start of LoadAsync and
    // discard results if _recentWindowHours changed before field assignment (or use a load-serial counter).
    private async Task LoadAsync()
    {
        // Reset so switching to a project with fewer/no runs never shows stale figures.
        _loading = true;
        _error = null;
        _total = 0; _succeeded = 0; _failed = 0; _cancelled = 0; _restarted = 0;
        _successRate = null; _retryRate = 0; _costCoverage = 0;
        _avgCycle = "—"; _avgTokens = 0; _anyRunHasTokens = false; _totalCost = 0;
        _byType = new(); _days = new(); _maxBucket = 1; _gateRanking = new();
        _runsWithGateData = 0; _isTruncated = false;
        try
        {
            // Capture a single UTC timestamp so the pre-filter and BuildBuckets use the same clock
            // snapshot. Two separate UtcNow reads could straddle an hour boundary under slow I/O and
            // shift every bucket label by a full hour.
            var now = DateTimeOffset.UtcNow;

            var runs = await RunHistory.GetRunHistoryAsync(page: 1, pageSize: PageSize, feedbackOnly: false, includeActive: false, projectId: State.SelectedProjectId, ct: _cts.Token);
            var allItems = runs.Items;

            // Compute the window start using the same truncation logic as InsightsBucketer so the
            // pre-filter and chart buckets are aligned (a rolling UtcNow.AddHours(-N) cutoff would
            // under-count the first hourly bucket by up to one partial hour).
            DateTimeOffset windowStart;
            if (_recentWindowHours is 1 or 6 or 24)
            {
                // Truncate to the start of the current hour (UTC) — matches BuildHourlyBuckets.
                var windowEnd = new DateTimeOffset(now.UtcDateTime.Year, now.UtcDateTime.Month,
                    now.UtcDateTime.Day, now.UtcDateTime.Hour, 0, 0, TimeSpan.Zero);
                windowStart = windowEnd.AddHours(-_recentWindowHours);
            }
            else if (_recentWindowHours == 168)
            {
                // Start of today UTC minus 6 days — matches BuildDailyBuckets(dayCount: 7).
                var todayUtc = new DateTimeOffset(now.UtcDateTime.Date, TimeSpan.Zero);
                windowStart = todayUtc.AddDays(-6);
            }
            else
            {
                // "All" window (0): no cutoff — all items are in scope.
                windowStart = DateTimeOffset.MinValue;
            }

            var items = _recentWindowHours > 0
                ? allItems.Where(r => r.StartedAtOffset >= windowStart).ToList()
                : allItems.ToList();

            // Only flag truncation when the fetch cap may have excluded in-window runs: there are older
            // pages AND the oldest fetched run still falls inside the window.
            // TODO: [WARNING] For narrow windows (1h/6h/24h) on a busy system with >500 runs per day,
            // the banner may still fire incorrectly because runs.HasMore reflects the global page count,
            // not per-window coverage. A server-side date-filtered endpoint would make this exact.
            _isTruncated = runs.HasMore && allItems.Count > 0 &&
                allItems.Min(r => r.StartedAtOffset) >= windowStart;

            _total = items.Count;
            // TODO: [WARNING] Chart-vs-headline divergence for hourly windows. The pre-filter keeps
            // runs with StartedAtOffset >= windowStart (no upper bound), so runs in the current
            // partial hour (between windowEnd and now) are counted in _total, _successRate,
            // _retryRate, etc. But BuildHourlyBuckets only covers [windowStart, windowEnd) where
            // windowEnd is the start of the current hour — those same runs land in no chart bucket.
            // Fix: either add a trailing partial-hour bucket in BuildHourlyBuckets, or exclude
            // partial-hour runs from the headline metrics.
            if (_total == 0) { _loading = false; return; }

            foreach (var run in items)
            {
                switch (RunOutcomeDisplay.Classify(run.FinalStep))
                {
                    case RunOutcome.Succeeded: _succeeded++; break;
                    case RunOutcome.Failed: _failed++; break;
                    case RunOutcome.Cancelled: _cancelled++; break;
                    case RunOutcome.Restarted: _restarted++; break;
                }
            }

            _successRate = RunOutcomeDisplay.SuccessRate(items);
            _retryRate = (int)Math.Round(100.0 * items.Count(r => r.RetryCount > 0) / _total);

            var withCost = items.Count(r => r.TotalCost is > 0m);
            _costCoverage = (int)Math.Round(100.0 * withCost / _total);
            _totalCost = items.Sum(r => r.TotalCost ?? 0m);

            _anyRunHasTokens = items.Any(r => r.TotalTokens > 0);
            _avgTokens = _anyRunHasTokens ? (long)items.Average(r => (double)r.TotalTokens) : 0;

            var succeededWithTime = items
                .Where(r => RunOutcomeDisplay.Classify(r.FinalStep) == RunOutcome.Succeeded && r.CompletedAtOffset is not null)
                .Select(r => (r.CompletedAtOffset!.Value - r.StartedAtOffset).TotalSeconds)
                .Where(s => s > 0)
                .ToList();
            _avgCycle = succeededWithTime.Count > 0 ? FormatSeconds(succeededWithTime.Average()) : "—";

            _byType = items.GroupBy(r => RunTypeLabel(r.RunType)).ToDictionary(g => g.Key, g => g.Count());

            // Time-window-aware buckets (hourly for 1h/6h/24h, daily for 7d/All), sharing `now` with the pre-filter.
            _days = InsightsBucketer.BuildBuckets(items, _recentWindowHours, now).ToList();
            _maxBucket = Math.Max(1, _days.Count > 0 ? _days.Max(d => d.Total) : 1);

            // Per-gate failure ranking: flatten each run's gate outcomes, count runs + failures per gate.
            _runsWithGateData = items.Count(r => r.QualityGateOutcomes is { Count: > 0 });
            var gateStats = new Dictionary<string, (int Total, int Failed)>(StringComparer.Ordinal);
            foreach (var run in items)
            {
                foreach (var gate in run.QualityGateOutcomes ?? [])
                {
                    var s = gateStats.GetValueOrDefault(gate.GateName);
                    gateStats[gate.GateName] = (s.Total + 1, s.Failed + (gate.Passed ? 0 : 1));
                }
            }
            _gateRanking = gateStats
                .Where(kv => kv.Value.Failed > 0)
                .OrderByDescending(kv => kv.Value.Failed)
                .ThenByDescending(kv => kv.Value.Total == 0 ? 0 : (double)kv.Value.Failed / kv.Value.Total)
                .Select(kv => new GateStat(kv.Key, kv.Value.Total, kv.Value.Failed))
                .ToList();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to load insights: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private int Pct(int count) => _total > 0 ? (int)Math.Round(100.0 * count / _total) : 0;
    private int Px(int count) => (int)Math.Round(110.0 * count / _maxBucket);

    /// <summary>
    /// Formats a bucket's SlotStart for x-axis labels and tooltips.
    /// Hourly windows (1h/6h/24h) use "HH:mm UTC"; daily windows (7d/All) use "MMM d UTC".
    /// </summary>
    private string FormatSlotLabel(DateTimeOffset slotStart)
    {
        // TODO: [WARNING] For the 24h window, the label omits the date component (e.g. "15:00 UTC"),
        // so x-axis ticks that span two calendar days are ambiguous. Consider including the date on the
        // first bucket of each calendar-day transition, or at minimum on both axis endpoints.
        return _recentWindowHours is 1 or 6 or 24
            ? slotStart.ToString("HH:mm") + " UTC"
            : slotStart.ToString("MMM d") + " UTC";
    }

    private sealed record GateStat(string GateName, int Total, int Failed);

    private static string RunTypeLabel(PipelineRunType t) => t switch
    {
        PipelineRunType.Implementation => "Implementation",
        PipelineRunType.Review => "Review",
        PipelineRunType.DecompositionAnalysis => "Decomp. analysis",
        PipelineRunType.Decomposition => "Decomposition",
        PipelineRunType.Consolidation => "Consolidation",
        _ => t.ToString()
    };

    private static string FormatSeconds(double totalSeconds)
    {
        var d = TimeSpan.FromSeconds(totalSeconds);
        if (d.TotalHours >= 1) return $"{(int)d.TotalHours}h {d.Minutes}m";
        if (d.TotalMinutes >= 1) return $"{(int)d.TotalMinutes}m {d.Seconds}s";
        return $"{(int)d.TotalSeconds}s";
    }

    public async ValueTask DisposeAsync()
    {
        State.OnProjectChanged -= HandleProjectChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
