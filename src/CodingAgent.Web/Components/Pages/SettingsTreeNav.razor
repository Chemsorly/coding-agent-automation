@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models
@using CodingAgent.Web.Services
@inject IPipelineApiConfigClient ConfigClient

@*
    Tree nodes are plain links whose active state comes from the parent's SelectedNode, not NavLink.
    Since .NET 10, NavLinkMatch.All ignores the query string, so every "settings?section=…" NavLink matched
    /settings and the whole tree rendered as active.
*@
<div class="settings-tree">
    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleProviders" aria-expanded="@_providersExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_providersExpanded ? "chevron-down" : "chevron-right")" Size="12" /></span>
            Providers
        </button>
        @if (_providersExpanded)
        {
            <div class="tree-group-children">
                <a class="@NodeClass(SettingsNodes.ProvidersIssue)" href="@Href(SettingsNodes.ProvidersIssue)" aria-current="@AriaCurrent(SettingsNodes.ProvidersIssue)">
                    Issue
                </a>
                <a class="@NodeClass(SettingsNodes.ProvidersRepository)" href="@Href(SettingsNodes.ProvidersRepository)" aria-current="@AriaCurrent(SettingsNodes.ProvidersRepository)">
                    Repository
                </a>
                <a class="@NodeClass(SettingsNodes.ProvidersAgent)" href="@Href(SettingsNodes.ProvidersAgent)" aria-current="@AriaCurrent(SettingsNodes.ProvidersAgent)">
                    Agent
                </a>
                <a class="@NodeClass(SettingsNodes.ProvidersPipeline)" href="@Href(SettingsNodes.ProvidersPipeline)" aria-current="@AriaCurrent(SettingsNodes.ProvidersPipeline)">
                    Pipeline
                </a>
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleProjects" aria-expanded="@_projectsExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_projectsExpanded ? "chevron-down" : "chevron-right")" Size="12" /></span>
            Projects
        </button>
        @if (_projectsExpanded)
        {
            <div class="tree-group-children">
                <a class="@NodeClass(SettingsNodes.Projects)" href="@Href(SettingsNodes.Projects)" aria-current="@AriaCurrent(SettingsNodes.Projects)">
                    Manage
                </a>
                @foreach (var project in _projects)
                {
                    var nodeId = $"{SettingsNodes.ProjectDetail}:{project.Id}";
                    var isDefault = project.Id == WellKnownIds.DefaultProjectId;
                    <a class="@NodeClass(nodeId)" href="@Href(nodeId)" aria-current="@AriaCurrent(nodeId)">
                        @project.Name
                        @if (isDefault)
                        {
                            <span class="badge-default">default</span>
                        }
                    </a>
                }
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="TogglePipeline" aria-expanded="@_pipelineExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_pipelineExpanded ? "chevron-down" : "chevron-right")" Size="12" /></span>
            Global Defaults
        </button>
        @if (_pipelineExpanded)
        {
            <div class="tree-group-children">
                <a class="@NodeClass(SettingsNodes.PipelineGeneral)" href="@Href(SettingsNodes.PipelineGeneral)" aria-current="@AriaCurrent(SettingsNodes.PipelineGeneral)">
                    General
                </a>
                <a class="@NodeClass(SettingsNodes.PipelineLoop)" href="@Href(SettingsNodes.PipelineLoop)" aria-current="@AriaCurrent(SettingsNodes.PipelineLoop)">
                    Pipeline Loop
                </a>
                <a class="@NodeClass(SettingsNodes.PipelinePrompts)" href="@Href(SettingsNodes.PipelinePrompts)" aria-current="@AriaCurrent(SettingsNodes.PipelinePrompts)">
                    Prompts
                </a>
                <a class="@NodeClass(SettingsNodes.PipelineDecomposition)" href="@Href(SettingsNodes.PipelineDecomposition)" aria-current="@AriaCurrent(SettingsNodes.PipelineDecomposition)">
                    Decomposition
                </a>
                <a class="@NodeClass(SettingsNodes.PipelineImplementation)" href="@Href(SettingsNodes.PipelineImplementation)" aria-current="@AriaCurrent(SettingsNodes.PipelineImplementation)">
                    Implementation
                </a>
                <a class="@NodeClass(SettingsNodes.PipelineReview)" href="@Href(SettingsNodes.PipelineReview)" aria-current="@AriaCurrent(SettingsNodes.PipelineReview)">
                    Review
                </a>
                <a class="@NodeClass(SettingsNodes.PipelineConsolidation)" href="@Href(SettingsNodes.PipelineConsolidation)" aria-current="@AriaCurrent(SettingsNodes.PipelineConsolidation)">
                    Consolidation
                </a>
                <a class="@NodeClass(SettingsNodes.PipelineAdvanced)" href="@Href(SettingsNodes.PipelineAdvanced)" aria-current="@AriaCurrent(SettingsNodes.PipelineAdvanced)">
                    Advanced
                </a>
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleLabelRouting" aria-expanded="@_labelRoutingExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_labelRoutingExpanded ? "chevron-down" : "chevron-right")" Size="12" /></span>
            Label Routing
        </button>
        @if (_labelRoutingExpanded)
        {
            <div class="tree-group-children">
                <a class="@NodeClass(SettingsNodes.AgentProfiles)" href="@Href(SettingsNodes.AgentProfiles)" aria-current="@AriaCurrent(SettingsNodes.AgentProfiles)">
                    Agent Profiles
                </a>
                <a class="@NodeClass(SettingsNodes.QualityGateConfigs)" href="@Href(SettingsNodes.QualityGateConfigs)" aria-current="@AriaCurrent(SettingsNodes.QualityGateConfigs)">
                    Quality Gate Configs
                </a>
                <a class="@NodeClass(SettingsNodes.ReviewerConfigs)" href="@Href(SettingsNodes.ReviewerConfigs)" aria-current="@AriaCurrent(SettingsNodes.ReviewerConfigs)">
                    Reviewer Configs
                </a>
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleDataManagement" aria-expanded="@_dataManagementExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_dataManagementExpanded ? "chevron-down" : "chevron-right")" Size="12" /></span>
            Data Management
        </button>
        @if (_dataManagementExpanded)
        {
            <div class="tree-group-children">
                <a class="@NodeClass(SettingsNodes.ConfigImportExport)" href="@Href(SettingsNodes.ConfigImportExport)" aria-current="@AriaCurrent(SettingsNodes.ConfigImportExport)">
                    Import / Export
                </a>
            </div>
        }
    </div>
</div>

@code {
    private bool _providersExpanded = true;
    private bool _projectsExpanded = true;
    private bool _pipelineExpanded = true;
    private bool _labelRoutingExpanded = true;
    private bool _dataManagementExpanded = true;

    private IReadOnlyList<PipelineProject> _projects = [];

    /// <summary>The node whose section the page is showing; rendered as the only active node.</summary>
    [Parameter]
    public string? SelectedNode { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _projects = await ConfigClient.GetProjectsAsync(CancellationToken.None);
    }

    public async Task RefreshProjectsAsync()
    {
        _projects = await ConfigClient.GetProjectsAsync(CancellationToken.None);
        StateHasChanged();
    }

    private static string Href(string nodeId) => $"settings?section={Uri.EscapeDataString(nodeId)}";

    private string NodeClass(string nodeId) => nodeId == SelectedNode ? "tree-node active" : "tree-node";

    private string? AriaCurrent(string nodeId) => nodeId == SelectedNode ? "page" : null;

    private void ToggleProviders()
    {
        _providersExpanded = !_providersExpanded;
    }

    private void ToggleProjects()
    {
        _projectsExpanded = !_projectsExpanded;
    }

    private void TogglePipeline()
    {
        _pipelineExpanded = !_pipelineExpanded;
    }

    private void ToggleLabelRouting()
    {
        _labelRoutingExpanded = !_labelRoutingExpanded;
    }

    private void ToggleDataManagement()
    {
        _dataManagementExpanded = !_dataManagementExpanded;
    }
}
