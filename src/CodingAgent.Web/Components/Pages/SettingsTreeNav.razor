@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models
@using CodingAgent.Web.Services
@inject IPipelineApiConfigClient ConfigClient

@*
    TODO [WARNING]: NavLink uses Match="NavLinkMatch.All", which requires the full URL (path + query
    string) to match exactly for the `active` CSS class to be applied. This is correct for the current
    single-query-param pattern (?section=<value>), but if any additional query parameter is ever
    appended to the settings URL, all nav items will silently lose the `active` class. Consider
    switching to a custom active-class strategy (e.g. comparing only the `section` query param in
    code-behind) if the settings URL is extended in the future.
*@
<div class="settings-tree">
    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleProviders" aria-expanded="@_providersExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_providersExpanded ? "chevron-down" : "chevron-right")" /></span>
            Providers
        </button>
        @if (_providersExpanded)
        {
            <div class="tree-group-children">
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.ProvidersIssue}")" Match="NavLinkMatch.All">
                    Issue
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.ProvidersRepository}")" Match="NavLinkMatch.All">
                    Repository
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.ProvidersAgent}")" Match="NavLinkMatch.All">
                    Agent
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.ProvidersPipeline}")" Match="NavLinkMatch.All">
                    Pipeline
                </NavLink>
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleProjects" aria-expanded="@_projectsExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_projectsExpanded ? "chevron-down" : "chevron-right")" /></span>
            Projects
        </button>
        @if (_projectsExpanded)
        {
            <div class="tree-group-children">
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.Projects}")" Match="NavLinkMatch.All">
                    Manage
                </NavLink>
                @foreach (var project in _projects)
                {
                    var nodeId = $"{SettingsNodes.ProjectDetail}:{project.Id}";
                    var isDefault = project.Id == WellKnownIds.DefaultProjectId;
                    <NavLink class="tree-node" href="@($"settings?section={Uri.EscapeDataString(nodeId)}")" Match="NavLinkMatch.All">
                        @project.Name
                        @if (isDefault)
                        {
                            <span class="badge-default">default</span>
                        }
                    </NavLink>
                }
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="TogglePipeline" aria-expanded="@_pipelineExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_pipelineExpanded ? "chevron-down" : "chevron-right")" /></span>
            Global Defaults
        </button>
        @if (_pipelineExpanded)
        {
            <div class="tree-group-children">
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineGeneral}")" Match="NavLinkMatch.All">
                    General
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineLoop}")" Match="NavLinkMatch.All">
                    Pipeline Loop
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelinePrompts}")" Match="NavLinkMatch.All">
                    Prompts
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineDecomposition}")" Match="NavLinkMatch.All">
                    Decomposition
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineImplementation}")" Match="NavLinkMatch.All">
                    Implementation
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineReview}")" Match="NavLinkMatch.All">
                    Review
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineConsolidation}")" Match="NavLinkMatch.All">
                    Consolidation
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.PipelineAdvanced}")" Match="NavLinkMatch.All">
                    Advanced
                </NavLink>
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleLabelRouting" aria-expanded="@_labelRoutingExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_labelRoutingExpanded ? "chevron-down" : "chevron-right")" /></span>
            Label Routing
        </button>
        @if (_labelRoutingExpanded)
        {
            <div class="tree-group-children">
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.AgentProfiles}")" Match="NavLinkMatch.All">
                    Agent Profiles
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.QualityGateConfigs}")" Match="NavLinkMatch.All">
                    Quality Gate Configs
                </NavLink>
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.ReviewerConfigs}")" Match="NavLinkMatch.All">
                    Reviewer Configs
                </NavLink>
            </div>
        }
    </div>

    <div class="tree-group">
        <button class="tree-group-header" @onclick="ToggleDataManagement" aria-expanded="@_dataManagementExpanded.ToString().ToLower()">
            <span class="tree-chevron"><Icon Name="@(_dataManagementExpanded ? "chevron-down" : "chevron-right")" /></span>
            Data Management
        </button>
        @if (_dataManagementExpanded)
        {
            <div class="tree-group-children">
                <NavLink class="tree-node" href="@($"settings?section={SettingsNodes.ConfigImportExport}")" Match="NavLinkMatch.All">
                    Import / Export
                </NavLink>
            </div>
        }
    </div>
</div>

@code {
    private bool _providersExpanded = true;
    private bool _projectsExpanded = true;
    private bool _pipelineExpanded = true;
    private bool _labelRoutingExpanded = true;
    private bool _dataManagementExpanded = true;

    private IReadOnlyList<PipelineProject> _projects = [];

    protected override async Task OnInitializedAsync()
    {
        _projects = await ConfigClient.GetProjectsAsync(CancellationToken.None);
    }

    public async Task RefreshProjectsAsync()
    {
        _projects = await ConfigClient.GetProjectsAsync(CancellationToken.None);
        StateHasChanged();
    }

    private void ToggleProviders()
    {
        _providersExpanded = !_providersExpanded;
    }

    private void ToggleProjects()
    {
        _projectsExpanded = !_projectsExpanded;
    }

    private void TogglePipeline()
    {
        _pipelineExpanded = !_pipelineExpanded;
    }

    private void ToggleLabelRouting()
    {
        _labelRoutingExpanded = !_labelRoutingExpanded;
    }

    private void ToggleDataManagement()
    {
        _dataManagementExpanded = !_dataManagementExpanded;
    }
}
