@page "/runs"
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Interfaces
@using CodingAgent.Pipeline.Models
@using CodingAgent.Pipeline.Services
@using CodingAgent.Web.Services
@using CodingAgent.Web.Components.Shared
@using Microsoft.AspNetCore.SignalR.Client
@inject IPipelineApiRunHistoryClient RunHistory
@inject CockpitState State
@inject NavigationManager Nav
@inject IAgentHubConnection HubConnection

@*
    Runs — the list behind the Run Page (see docs/frontend-redesign-handoff.md).
    Data: IPipelineApiRunHistoryClient.GetRunHistoryAsync → PagedResult<PipelineRunSummary>.
    Consolidation runs are excluded from run history until #2567 lands; they are not
    displayed here and are not offered as filter options.

    Issue #2328: Removed Agent column; added Links column (issue URL + PR URL);
    added sortable headers (Result, Type, Duration, When — client-side, current page);
    added Type filter dropdown; sort state persisted in URL query param.
    Issue #2941: Removed duplicate Result column filter (outcome tabs are the single
    outcome control); added client-filter empty-state with Clear filters action;
    fixed pager count to reflect filtered rows; removed dead consolidation filter options;
    fixed aria-selected to lowercase; added aria-label to Feedback only checkbox.
*@

<PageTitle>Runs - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Runs</h1>
            <span class="cockpit-page-sub">Every dispatch — implementation, review, and decomposition</span>
        </div>
        <RefreshBar OnRefresh="RefreshQuietAsync" StorageKey="autoRefresh.runs" />
    </div>

    <div class="cockpit-toolbar">
        <div class="cockpit-segmented" role="tablist" aria-label="Filter runs by outcome">
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.All ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.All ? "true" : "false")" @onclick="() => SetOutcome(OutcomeFilter.All)">All</button>
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.Completed ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.Completed ? "true" : "false")" @onclick="() => SetOutcome(OutcomeFilter.Completed)">Completed</button>
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.Failed ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.Failed ? "true" : "false")" @onclick="() => SetOutcome(OutcomeFilter.Failed)">Failed</button>
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.Cancelled ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.Cancelled ? "true" : "false")" @onclick="() => SetOutcome(OutcomeFilter.Cancelled)">Cancelled</button>
        </div>
        <label class="cockpit-filter-toggle @(_feedbackOnly ? "is-on" : "")">
            <input type="checkbox" aria-label="Feedback only" checked="@_feedbackOnly" @onchange="ToggleFeedbackOnly" />
            Feedback only
        </label>
    </div>

    <div class="cockpit-card">
        @if (_loading)
        {
            <div class="cockpit-empty">Loading runs…</div>
        }
        else if (_error is not null)
        {
            <div class="cockpit-empty">@_error</div>
        }
        else if (_result is null || _result.Items.Count == 0)
        {
            <div class="cockpit-empty">No @(_outcome == OutcomeFilter.All ? "" : _outcome.ToString().ToLowerInvariant() + " ")runs@(_feedbackOnly ? " with feedback" : "") yet.</div>
        }
        else if (_filteredRuns.Count == 0)
        {
            <div class="cockpit-empty">No runs match the current filters. <button class="cockpit-link-btn" @onclick="ResetClientFilters">Clear filters</button></div>
        }
        else
        {
            <div class="monitoring-table-wrap">
                <table class="monitoring-table">
                    <colgroup>
                        <col style="width: 110px;" />  @* Result *@
                        <col style="width: 100px;" />  @* Type *@
                        <col style="width: 100px;" />  @* Initiated by *@
                        <col style="width: 300px;" />  @* Run *@
                        <col style="width: 100px;" />  @* Duration *@
                        @if (_anyRunHasTokens)
                        {
                            <col style="width: 90px;" />   @* Tokens *@
                        }
                        <col style="width: 110px;" />  @* When *@
                        <col style="width: 90px;" />   @* Links *@
                    </colgroup>
                    <thead>
                        <tr>
                            @* ── Result column: sortable only (filter removed — outcome tabs are the single outcome control) ── *@
                            <th class="@(ActiveSortClass(SortColumn.Result))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.Result)">
                                    Result @SortIndicatorForResult
                                </button>
                            </th>
                            @* ── Type column: sortable + filter ─────────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.Type))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.Type)">
                                    Type @SortIndicatorForType
                                </button>
                                <select class="column-filter" aria-label="Filter by Type"
                                        value="@_typeFilter"
                                        @onchange="e => SetTypeFilter(e.Value?.ToString() ?? string.Empty)">
                                    <option value="">All</option>
                                    <option value="Implementation">Implementation</option>
                                    <option value="Review">Review</option>
                                    <option value="Decomposition">Decomposition</option>
                                </select>
                            </th>
                            @* ── Initiated by column: filter only (not sortable) ────────────────── *@
                            @* TODO: [WARNING] Using value="@_initiatedByFilter" + @onchange is not the idiomatic Blazor two-way binding
                               form. If _initiatedByFilter is reset programmatically, the <select> element's displayed value will not
                               update in all rendering scenarios. The safe idiomatic alternative is @bind-value="@_initiatedByFilter"
                               @bind-value:event="onchange". This is consistent with how the existing _typeFilter dropdown is
                               implemented, so it is not a regression introduced here, but the same latent risk applies. *@
                            <th>
                                Initiated by
                                <select class="column-filter" aria-label="Filter by Initiated by"
                                        value="@_initiatedByFilter"
                                        @onchange="e => SetInitiatedByFilter(e.Value?.ToString() ?? string.Empty)">
                                    <option value="">All</option>
                                    <option value="@InitiatedByConstants.LoopIssue">@InitiatedByConstants.LoopIssue</option>
                                    <option value="@InitiatedByConstants.LoopReview">@InitiatedByConstants.LoopReview</option>
                                    <option value="@InitiatedByConstants.LoopDecomposition">@InitiatedByConstants.LoopDecomposition</option>
                                    <option value="@InitiatedByConstants.Manual">@InitiatedByConstants.Manual</option>
                                </select>
                            </th>
                            <th>Run</th>
                            @* ── Duration column: sortable ───────────────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.Duration))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.Duration)">
                                    Duration @SortIndicatorForDuration
                                </button>
                            </th>
                            @if (_anyRunHasTokens)
                            {
                                <th>Tokens</th>
                            }
                            @* ── When column: sortable ───────────────────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.When))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.When)">
                                    When @SortIndicatorForWhen
                                </button>
                            </th>
                            <th>Links</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in _filteredRuns)
                        {
                            var resultLabel = RunOutcomeDisplay.Label(run.FinalStep);
                            var resultClass = RunOutcomeDisplay.BadgeClass(run.FinalStep);
                            var runTypeLabel = run.RunType switch
                            {
                                PipelineRunType.Review => "Review",
                                PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition => "Decomposition",
                                PipelineRunType.Consolidation => "Consolidation",
                                _ => "Implementation"
                            };
                            <tr class="@(run.RunType == PipelineRunType.Consolidation ? "" : "monitoring-row-clickable")"
                                title="@(run.RunType == PipelineRunType.Consolidation ? "View consolidation history on the Consolidation page" : "")"
                                @onclick="() => TryOpenRun(run)">
                                <td>
                                    <span class="step-badge @resultClass" title="@run.FinalStep.ToDisplayName()">@resultLabel</span>
                                </td>
                                <td>
                                    @if (run.RunType == PipelineRunType.Review)
                                    {
                                        <span class="run-type-badge run-type-review" title="PR Review"><Icon Name="search" Size="14" /> Review</span>
                                    }
                                    else if (run.RunType is PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition)
                                    {
                                        <span class="run-type-badge run-type-decomp" title="@(run.RunType == PipelineRunType.DecompositionAnalysis ? "Decomposition Analysis" : "Decomposition")"><Icon Name="puzzle" Size="14" /> Decomp</span>
                                    }
                                    else if (run.RunType == PipelineRunType.Consolidation)
                                    {
                                        <span class="run-type-badge run-type-consolidation" title="Consolidation"><Icon Name="refresh-cw" Size="14" /> Consolidation</span>
                                    }
                                    else
                                    {
                                        <span class="run-type-badge run-type-impl" title="Implementation"><Icon Name="hammer" Size="14" /> Impl</span>
                                    }
                                </td>
                                @* TODO: [WARNING] run.InitiatedBy is declared as non-nullable string with a "manual" default, but
                                   rows deserialized from storage that predate the InitiatedBy field will deserialize with null
                                   (absent JSON field ignores C# default initializers). Passing null to ToDisplayString(string, RunMode)
                                   will produce a NullReferenceException when those legacy rows are rendered. Add a null-coalescing guard
                                   here, e.g. @InitiatedByConstants.ToDisplayString(run.InitiatedBy ?? string.Empty, run.RunMode),
                                   or update PipelineRunSummary.InitiatedBy to string? and add an overload/guard in ToDisplayString. *@
                                <td><span class="cockpit-chip">@InitiatedByConstants.ToDisplayString(run.InitiatedBy, run.RunMode)</span></td>
                                @* TODO: text-overflow: ellipsis on a <td> requires table-layout: fixed on the parent table to
                                   be reliable across browsers. Without table-layout: fixed, the computed column width comes from
                                   the <col style="width:300px"> hint but max-width: 0 on the <td> is ignored, so text-overflow
                                   may not truncate and the Run column may still overflow at narrow viewports. Consider adding
                                   table-layout: fixed to .monitoring-table (or a scoped variant) with accurate colgroup widths. *@
                                <td style="overflow: hidden; text-overflow: ellipsis; max-width: 0;">
                                    <span style="font-weight: 600;">@(run.RunType == PipelineRunType.Review ? "PR " : "")#@run.IssueIdentifier</span>
                                    <span style="color: var(--text-muted);">@Truncate(run.IssueTitle, 60)</span>
                                </td>
                                <td>@Dur(run.StartedAtOffset, run.CompletedAtOffset)</td>
                                @if (_anyRunHasTokens)
                                {
                                    <td><span class="token-badge">@CostFormatter.FormatTokens(run.TotalTokens)</span></td>
                                }
                                <td title="@run.StartedAtOffset.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@Ago(run.StartedAtOffset)</td>
                                <td class="runs-links-cell" @onclick:stopPropagation="true">
                                    @if (!string.IsNullOrEmpty(run.IssueUrl))
                                    {
                                        @* TODO: Validate that IssueUrl starts with https:// before rendering as href.
                                           Blazor HTML-encodes attribute values but does NOT strip javascript: URI schemes,
                                           so a malicious/corrupted record could produce a clickable XSS link. *@
                                        <a href="@run.IssueUrl" target="_blank" rel="noopener noreferrer" class="runs-link" title="Open issue #@run.IssueIdentifier">
                                            <Icon Name="message-square" Size="13" /> #@run.IssueIdentifier
                                        </a>
                                    }
                                    @* TODO: For PipelineRunType.Review runs, PullRequestUrl is typically null — the PR being
                                       reviewed is carried in ReviewPrUrl instead. Currently Review run rows show no PR link in
                                       the Links cell even though a URL is available. Consider falling back to ReviewPrUrl when
                                       PullRequestUrl is null and the run is a Review type. *@
                                    @if (!string.IsNullOrEmpty(run.PullRequestUrl))
                                    {
                                        @* TODO: Validate that PullRequestUrl starts with https:// before rendering as href.
                                           Same javascript: URI injection risk as IssueUrl above. *@
                                        <a href="@run.PullRequestUrl" target="_blank" rel="noopener noreferrer" class="runs-link runs-link-pr" title="Open pull request">
                                            <Icon Name="git-pull-request" Size="13" /> PR
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="cockpit-pager">
        <span class="cockpit-pager-info">Page @_page@(
            _result is { Items.Count: > 0 }
                ? (_filteredRuns.Count != _result.Items.Count
                    ? $" · {_filteredRuns.Count} of {_result.Items.Count} on this page"
                    : $" · {_filteredRuns.Count} shown")
                : "")</span>
        <div class="cockpit-pager-buttons">
            <button class="cockpit-pager-btn" disabled="@(_page <= 1 || _loading)" @onclick="PrevPage">
                <Icon Name="chevrons-left" Size="14" /> Prev
            </button>
            <button class="cockpit-pager-btn" disabled="@(_result is null || !_result.HasMore || _loading)" @onclick="NextPage">
                Next <Icon Name="chevrons-right" Size="14" />
            </button>
        </div>
    </div>
</div>

@code {
    private const int PageSize = 25;

    private readonly CancellationTokenSource _cts = new();
    private PagedResult<PipelineRunSummary>? _result;

    /// <summary>
    /// The current page's runs after applying client-side Type/InitiatedBy filters and sort.
    /// Recomputed whenever <see cref="_result"/>, <see cref="_typeFilter"/>,
    /// <see cref="_initiatedByFilter"/>, or sort state changes. Used by both the table body
    /// and the pager (which lives outside the if/else block and needs component-level state).
    /// </summary>
    private List<PipelineRunSummary> _filteredRuns = [];

    private int _page = 1;
    private bool _feedbackOnly;
    private bool _loading = true;
    private string? _error;
    private bool _anyRunHasTokens;

    // Hub subscriptions — disposed in DisposeAsync.
    private IDisposable? _stepSub;
    private IDisposable? _completedSub;
    private bool _hubSubscribed;

    // ── Column sort state ────────────────────────────────────────────────────

    private enum SortColumn { When, Result, Type, Duration }

    // Default: When descending (newest first) — query-param backed so links are shareable.
    private SortColumn _sortColumn = SortColumn.When;
    private bool _sortAsc;   // false = descending (default for When)

    // ── Column filter state (client-side, not URL-persisted) ─────────────────

    private string _typeFilter = "";
    private string _initiatedByFilter = "";

    // ── Query parameters ─────────────────────────────────────────────────────

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortFromQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sortDir")]
    public string? SortDirFromQuery { get; set; }

    // ── Server-side outcome filter ────────────────────────────────────────────

    private enum OutcomeFilter { All, Completed, Failed, Cancelled }
    private OutcomeFilter _outcome = OutcomeFilter.All;

    private PipelineStep? FinalStepFilter => _outcome switch
    {
        OutcomeFilter.Completed => PipelineStep.Completed,
        OutcomeFilter.Failed => PipelineStep.Failed,
        OutcomeFilter.Cancelled => PipelineStep.Cancelled,
        _ => null
    };

    protected override void OnInitialized()
    {
        State.OnProjectChanged += HandleProjectChanged;

        // TODO: Sort state is read from query params here in OnInitialized, but [SupplyParameterFromQuery]
        // params are re-supplied on every navigation. If the user navigates to the same page with different
        // ?sort= query params (e.g. browser back/forward), OnParametersSet fires but the sort state is
        // never re-read from SortFromQuery/SortDirFromQuery, leaving sort state stale.
        // Move this query-param parsing to OnParametersSet to handle same-component re-navigation correctly.

        // Read sort state from query params
        if (Enum.TryParse<SortColumn>(SortFromQuery, ignoreCase: true, out var col))
            _sortColumn = col;
        _sortAsc = string.Equals(SortDirFromQuery, "asc", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hubSubscribed)
            await SubscribeHubAsync();
    }

    // Subscribe to hub run-state events so the Runs list refreshes immediately when any run
    // transitions or completes — rather than waiting for the auto-refresh timer.
    // Handlers are registered globally on the shared IAgentHubConnection (one per Blazor circuit).
    // They fire for any run group the circuit is subscribed to (e.g. RunPage open in same circuit).
    private async Task SubscribeHubAsync()
    {
        // TODO: [WARNING] _hubSubscribed is set to true before the try block. If HubConnection.StartAsync
        // throws (e.g. network unreachable on first render), the exception is caught and swallowed but
        // _hubSubscribed remains true, permanently preventing any retry of hub subscription for this
        // component instance. The RefreshBar polling fallback still works, but hub-based push is silently
        // disabled forever after one transient failure. Fix: move `_hubSubscribed = true` inside the try
        // block, or reset it to false in the catch so OnAfterRenderAsync retries on the next render.
        _hubSubscribed = true;
        try
        {
            _stepSub = HubConnection.On<string, PipelineStep, DateTimeOffset>(
                HubMethodNames.OnStepTransition, (_, _, _) => OnRunStateChanged());
            _completedSub = HubConnection.On<string, JobCompletionPayload>(
                HubMethodNames.OnRunCompleted, (_, _) => OnRunStateChanged());

            if (HubConnection.State == HubConnectionState.Disconnected)
                await HubConnection.StartAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            // Hub subscription is best-effort — the RefreshBar polling fallback still works.
            Serilog.Log.Debug(ex, "Runs: failed to subscribe to hub events");
        }
    }

    // Called on any hub run-state event. Schedules a quiet data refresh on the Blazor circuit.
    private void OnRunStateChanged()
    {
        // TODO: [WARNING] OnStepTransition and OnRunCompleted are sent only to run-specific SignalR groups
        // (run-{jobId}). This page never calls SubscribeToRun, so these handlers fire only if the same
        // Blazor circuit also has a RunPage open that is subscribed to that specific run group. For a
        // standalone Runs list with no RunPage open, no push events are ever delivered and the page relies
        // entirely on manual/auto-refresh polling. A global "any run changed" broadcast on the hub would
        // make this reactive path work unconditionally without per-run group membership.
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshQuietAsync();
                StateHasChanged();
            }
            catch (ObjectDisposedException) { }
        });
    }

    // Re-query when the top-bar project scope changes (reset to the first page for the new scope).
    private async void HandleProjectChanged()
    {
        _page = 1;
        try
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task SetOutcome(OutcomeFilter outcome)
    {
        if (_outcome == outcome) return;
        _outcome = outcome;
        _page = 1;   // a new filter resets to the first page
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        // TODO: [WARNING] Resetting _anyRunHasTokens = false here causes a transient render where the Tokens
        // column header and <col> are absent while _filteredRuns still holds the previous page's rows.
        // During async data fetch (network delay), this produces a one-frame column misalignment: cells that
        // were in the token column appear shifted until the new data arrives. Previously the column was always
        // rendered, so no shift occurred. Fix: either delay the reset until after the new result is assigned,
        // or suppress intermediate renders by setting _loading = true before the reset and re-rendering only
        // after both _result and _anyRunHasTokens are updated.
        _anyRunHasTokens = false;
        try
        {
            _result = await RunHistory.GetRunHistoryAsync(
                page: _page, pageSize: PageSize, feedbackOnly: _feedbackOnly, includeActive: true,
                finalStep: FinalStepFilter, projectId: State.SelectedProjectId, ct: _cts.Token);
            _anyRunHasTokens = _result?.Items.Any(r => r.TotalTokens > 0) ?? false;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to load runs: {ex.Message}";
        }
        finally
        {
            _loading = false;
            // TODO: If GetRunHistoryAsync throws (non-cancellation), _result retains its previous
            // value. On the first load _result is null and _filteredRuns correctly becomes [].
            // On subsequent failed refreshes, _filteredRuns is recomputed from the stale _result,
            // which means the pager count and table rows will reflect the previous successful load
            // rather than clearly indicating an error state. This is not a regression, but the
            // pager count now also reads from _filteredRuns, so the inconsistency is more visible.
            _filteredRuns = FilteredSortedRuns().ToList();
        }
    }

    // Quiet tick refresh — reloads the current page + filter, no spinner, no page reset.
    private async Task RefreshQuietAsync()
    {
        try
        {
            _result = await RunHistory.GetRunHistoryAsync(
                page: _page, pageSize: PageSize, feedbackOnly: _feedbackOnly, includeActive: true,
                finalStep: FinalStepFilter, projectId: State.SelectedProjectId, ct: _cts.Token);
            _anyRunHasTokens = _result?.Items.Any(r => r.TotalTokens > 0) ?? false;
            _error = null;
        }
        catch (OperationCanceledException) { }
        catch { /* keep the current page until the next tick */ }
        finally
        {
            _filteredRuns = FilteredSortedRuns().ToList();
        }
    }

    private async Task ToggleFeedbackOnly(ChangeEventArgs e)
    {
        _feedbackOnly = e.Value is true;
        _page = 1;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (_result is null || !_result.HasMore) return;
        _page++;
        await LoadAsync();
    }

    // ── Client-side filter helpers ────────────────────────────────────────────

    // TODO: These helpers mutate _filteredRuns synchronously without calling StateHasChanged.
    // This is safe today because they are only invoked from @onchange / @onclick Blazor event
    // handlers, which trigger an implicit re-render after returning. If any of these helpers are
    // ever called from an async path (after an await), Blazor will not automatically re-render
    // and the UI will silently show stale data. Should that happen, call StateHasChanged() after
    // computing _filteredRuns. ToggleSort has the same pattern for the same reason.
    private void SetTypeFilter(string value)
    {
        _typeFilter = value;
        _filteredRuns = FilteredSortedRuns().ToList();
    }

    private void SetInitiatedByFilter(string value)
    {
        _initiatedByFilter = value;
        _filteredRuns = FilteredSortedRuns().ToList();
    }

    private void ResetClientFilters()
    {
        _typeFilter = "";
        _initiatedByFilter = "";
        _filteredRuns = FilteredSortedRuns().ToList();
    }

    // ── Sort ─────────────────────────────────────────────────────────────────

    private void ToggleSort(SortColumn col)
    {
        if (_sortColumn == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = col;
            // Default direction for each column: When = desc (newest first), others = asc
            _sortAsc = col != SortColumn.When;
        }
        PersistSortToUrl();
        _filteredRuns = FilteredSortedRuns().ToList();
    }

    private void PersistSortToUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = _sortColumn.ToString().ToLowerInvariant(),
            ["sortDir"] = _sortAsc ? "asc" : "desc",
        });
        Nav.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private IEnumerable<PipelineRunSummary> FilteredSortedRuns()
    {
        if (_result is null) return [];

        IEnumerable<PipelineRunSummary> items = _result.Items;

        // ── Client-side column filters ────────────────────────────────────────
        if (!string.IsNullOrEmpty(_typeFilter))
            items = items.Where(r => RunTypeLabel(r) == _typeFilter);

        if (!string.IsNullOrEmpty(_initiatedByFilter))
            items = items.Where(r => r.InitiatedBy == _initiatedByFilter);

        // ── Client-side sort ──────────────────────────────────────────────────
        items = _sortColumn switch
        {
            SortColumn.Result => _sortAsc
                ? items.OrderBy(r => ResultLabel(r))
                : items.OrderByDescending(r => ResultLabel(r)),
            SortColumn.Type => _sortAsc
                ? items.OrderBy(r => RunTypeLabel(r))
                : items.OrderByDescending(r => RunTypeLabel(r)),
            SortColumn.Duration => _sortAsc
                ? items.OrderBy(r => DurationSeconds(r))
                : items.OrderByDescending(r => DurationSeconds(r)),
            SortColumn.When => _sortAsc
                ? items.OrderBy(r => r.StartedAtOffset)
                : items.OrderByDescending(r => r.StartedAtOffset),
            _ => items.OrderByDescending(r => r.StartedAtOffset),
        };

        return items;
    }

    private static string ResultLabel(PipelineRunSummary r) => RunOutcomeDisplay.Label(r.FinalStep);

    private static string RunTypeLabel(PipelineRunSummary r) => r.RunType switch
    {
        PipelineRunType.Review => "Review",
        PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition => "Decomposition",
        PipelineRunType.Consolidation => "Consolidation",
        _ => "Implementation"
    };

    private static double DurationSeconds(PipelineRunSummary r)
        => r.CompletedAtOffset.HasValue ? (r.CompletedAtOffset.Value - r.StartedAtOffset).TotalSeconds : double.MaxValue;

    // ── Sort header helpers ───────────────────────────────────────────────────

    private string ActiveSortClass(SortColumn col) => _sortColumn == col ? "sort-active" : "";

    // Per-column MarkupString properties so the Razor template can embed them inline
    // without Razor mistaking the closing paren for an HTML context end.
    private MarkupString SortIndicatorForResult   => SortIndicator(SortColumn.Result);
    private MarkupString SortIndicatorForType     => SortIndicator(SortColumn.Type);
    private MarkupString SortIndicatorForDuration => SortIndicator(SortColumn.Duration);
    private MarkupString SortIndicatorForWhen     => SortIndicator(SortColumn.When);

    private MarkupString SortIndicator(SortColumn col)
    {
        if (_sortColumn != col) return new MarkupString("");
        var arrow = _sortAsc ? "↑" : "↓";
        return new MarkupString($"<span class=\"sort-indicator\">{arrow}</span>");
    }

    // NavigationManager.NavigateTo with a bare relative path resolves against BaseUri (the app
    // root), not the current page URL — this is the correct Blazor Server behaviour.
    private void OpenRun(string runId) => Nav.NavigateTo($"runs/{runId}");

    /// <summary>
    /// Navigates to the run detail page, but only for non-consolidation run types.
    /// Consolidation runs are stored in a separate table and have no /runs/{id} detail page.
    /// Issue #2629: unconditionally calling OpenRun for all rows caused consolidation rows to
    /// navigate to /runs/{id} → 404 "Run not found."
    ///
    /// Note: the guard uses run.RunType (already present in PipelineRunSummary) rather than
    /// InitiatedBy, because RunType is set from the DB/JSON summary and is the correct
    /// discriminator at the UI layer.
    /// </summary>
    private void TryOpenRun(PipelineRunSummary run)
    {
        if (run.RunType != PipelineRunType.Consolidation)
            OpenRun(run.RunId);
    }

    private static string Truncate(string? s, int n)
        => string.IsNullOrEmpty(s) ? "" : (s.Length > n ? s[..n] + "…" : s);

    private static string Dur(DateTimeOffset start, DateTimeOffset? end)
    {
        if (end is null) return "running";
        var d = end.Value - start;
        if (d.TotalHours >= 1) return $"{(int)d.TotalHours}h {d.Minutes}m";
        if (d.TotalMinutes >= 1) return $"{(int)d.TotalMinutes}m {d.Seconds}s";
        return $"{Math.Max(0, (int)d.TotalSeconds)}s";
    }

    private static string Ago(DateTimeOffset t)
    {
        var d = DateTimeOffset.UtcNow - t;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    public async ValueTask DisposeAsync()
    {
        State.OnProjectChanged -= HandleProjectChanged;
        _stepSub?.Dispose();
        _completedSub?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
