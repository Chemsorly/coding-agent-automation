<div class="dispatch-drawer-overlay @(IsOpen ? "open" : "")" @onclick="OnClose"></div>
<aside class="dispatch-drawer @(IsOpen ? "open" : "")" @attributes="@(IsOpen ? null : new Dictionary<string,object>{{"inert",""}})">
    @if (HeaderPrefix != null) { @HeaderPrefix }
    <div class="agent-detail-header">
        <h3>@Title</h3>
        <button class="agent-detail-close" @onclick="OnClose" aria-label="Close drawer">✕</button>
    </div>
    @ChildContent
</aside>

@code {
    [Parameter, EditorRequired] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public RenderFragment? HeaderPrefix { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
