@using CodingAgent.Pipeline.Interfaces
@using CodingAgent.Pipeline.Models
@inherits DispatchDrawerBase<IssueSummary>

<div class="dispatch-drawer-overlay @(IsOpen ? "open" : "")" @onclick="Close"></div>
<aside class="dispatch-drawer @(IsOpen ? "open" : "")" @attributes="@(IsOpen ? null : new Dictionary<string,object>{{"inert",""}})">
    @if (HeaderPrefix != null) { @HeaderPrefix }
    <div class="agent-detail-header">
        <h3>Browse Issues</h3>
        <button class="agent-detail-close" @onclick="Close" aria-label="Close drawer">✕</button>
    </div>

    @if (Template != null)
    {
        <div class="agent-detail-section">
            <h4>Template: @Template.Name</h4>
        </div>

        @if (IsLoading)
        {
            <div class="loading-text" style="padding: 12px;">Loading issues...</div>
        }
        else
        {
            <div style="padding: 0 0 8px;">
                <input type="text" @bind="_filter" @bind:event="oninput" @bind:after="ApplyFilter"
                       placeholder="Filter by number or title..." style="width: 100%; padding: 6px 10px; background: var(--bg); border: 1px solid var(--border); border-radius: var(--radius); color: var(--text); font-size: 0.82rem;" />
            </div>

            @if (AvailableLabels.Count > 0)
            {
                <div class="drawer-label-filter" style="padding: 0 0 8px;">
                    <div style="display: flex; align-items: center; gap: 6px; margin-bottom: 4px;">
                        <span style="font-size: 0.75rem; color: var(--text-muted);">Labels:</span>
                        @if (SelectedLabels.Count > 0)
                        {
                            <button class="btn-link" style="font-size: 0.72rem; padding: 0; color: var(--accent);" @onclick="ClearLabels">Clear</button>
                        }
                    </div>
                    <div style="display: flex; flex-wrap: wrap; gap: 4px; max-height: 72px; overflow-y: auto;">
                        @foreach (var label in AvailableLabels)
                        {
                            var isActive = SelectedLabels.Contains(label);
                            <button class="sidebar-label @UiFormatters.GetLabelClass(label) @(isActive ? "label-active" : "label-inactive")"
                                    style="cursor: pointer; font-size: 0.72rem; padding: 2px 6px; border: 1px solid @(isActive ? "var(--accent)" : "transparent"); opacity: @(isActive ? "1" : "0.7");"
                                    @onclick="() => ToggleLabel(label)">
                                @label
                            </button>
                        }
                    </div>
                </div>
            }

            @if (Issues.Count == 0)
            {
                <div class="monitoring-empty">No open issues found.</div>
            }
            else
            {
                <div class="agent-history-list" tabindex="0" @onkeydown="HandleKeyDown" @onkeydown:preventDefault="ShouldPreventDefault"
                     style="max-height: calc(100vh - 380px); overflow-y: auto;">
                    @{ var idx = 0; }
                    @foreach (var issue in FilteredItems)
                    {
                        var processingStatus = GetProcessingStatus(issue.Identifier);
                        var isProcessing = processingStatus.HasValue;
                        var readiness = Readiness.GetValueOrDefault(issue.Identifier);
                        // TODO: Guard against inconsistent DependencyCheckResult where IsReady=false but BlockedBy is empty — would render "blocked by" with no issue numbers.
                        var displayState = GetIssueDisplayState(issue, readiness, processingStatus);
                        var isBlocked = displayState == IssueDisplayState.Blocked;
                        var currentIdx = idx;
                        <div class="drawer-issue-item @(isProcessing ? "drawer-issue-dispatched" : "") @(isBlocked ? "drawer-issue-blocked" : "") @(SelectedItem?.Identifier == issue.Identifier ? "drawer-issue-selected" : "") @GetHighlightClass(currentIdx)"
                             @onclick="() => SelectItem(issue)"
                             data-testid="issue-row-@issue.Identifier"
                             style="@(isProcessing ? "opacity: 0.6; pointer-events: none;" : "")">
                            <div class="drawer-issue-header">
                                <span class="drawer-issue-number">#@issue.Identifier</span>
                                @switch (displayState)
                                {
                                    case IssueDisplayState.Running:
                                        <span class="badge-default" style="background: var(--accent-fill); color: white;">Running</span>
                                        break;
                                    case IssueDisplayState.Queued:
                                        <span class="badge-default" style="background: var(--accent-fill); color: white;">Queued</span>
                                        break;
                                    case IssueDisplayState.InProgress:
                                        <span class="badge-default" style="background: var(--accent-fill); color: white;">In progress</span>
                                        break;
                                    case IssueDisplayState.Done:
                                        <span class="badge-default" style="background: var(--success-bg); color: var(--success);">Done</span>
                                        break;
                                    case IssueDisplayState.Error:
                                        <span class="badge-default" style="background: var(--bg-error); color: var(--error);">Error</span>
                                        break;
                                    case IssueDisplayState.WontDo:
                                        <span class="badge-default" style="background: var(--bg-hover); color: var(--text-muted);">Won't do</span>
                                        break;
                                    case IssueDisplayState.NeedsRefinement:
                                        <span class="badge-default" style="background: var(--warning-bg); color: var(--warning);">Needs refinement</span>
                                        break;
                                    case IssueDisplayState.Epic:
                                        <span class="badge-default" style="background: var(--bg-hover); color: var(--text-muted);">Epic</span>
                                        break;
                                    case IssueDisplayState.Parked:
                                        <span class="badge-default" style="background: var(--bg-hover); color: var(--text-muted);">Parked</span>
                                        break;
                                    case IssueDisplayState.Blocked:
                                        <span class="badge-default drawer-badge-blocked" title="Blocked by @(string.Join(", ", readiness!.BlockedBy.Select(n => $"#{n}").Concat(readiness.BlockedByUrls ?? [])))">Blocked by @(string.Join(", ", readiness!.BlockedBy.Select(n => $"#{n}").Concat(readiness.BlockedByUrls ?? [])))</span>
                                        break;
                                    case IssueDisplayState.Ready:
                                        <span class="badge-default drawer-badge-ready">Ready</span>
                                        break;
                                }
                            </div>
                            <div class="drawer-issue-title">@issue.Title</div>
                            @if (!string.IsNullOrEmpty(issue.Description))
                            {
                                <div class="drawer-issue-preview">@UiFormatters.Truncate(GetBodyPreview(issue.Description), 100)</div>
                            }
                            <div class="drawer-issue-labels">
                                @foreach (var label in issue.Labels.Take(5))
                                {
                                    <span class="sidebar-label @UiFormatters.GetLabelClass(label)">@label</span>
                                }
                            </div>
                        </div>
                        idx++;
                    }
                </div>

                @if (HasMore || Page > 1)
                {
                    <div style="display: flex; justify-content: center; gap: 8px; padding: 8px 0;">
                        <button class="btn-page" @onclick="PrevPage" disabled="@(Page <= 1)">← Prev</button>
                        <span class="monitoring-muted" style="align-self: center; font-size: 0.8rem;">Page @Page</span>
                        <button class="btn-page" @onclick="NextPage" disabled="@(!HasMore)">Next →</button>
                    </div>
                }
            }

            @if (SelectedItem != null)
            {
                var selectedReadiness = Readiness.GetValueOrDefault(SelectedItem.Identifier);
                var selectedBlocked = selectedReadiness is { IsReady: false };
                <div class="agent-detail-section" style="margin-top: 12px; border-top: 1px solid var(--border); padding-top: 12px;">
                    <h4>#@SelectedItem.Identifier — @SelectedItem.Title</h4>
                    <div class="drawer-issue-labels" style="margin-bottom: 8px;">
                        @foreach (var label in SelectedItem.Labels)
                        {
                            <span class="sidebar-label @UiFormatters.GetLabelClass(label)">@label</span>
                        }
                    </div>
                    @if (SelectedItem.CreatedAt.HasValue)
                    {
                        <p style="font-size: 0.78rem; color: var(--text-muted); margin: 0 0 8px;">
                            Created: @SelectedItem.CreatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                        </p>
                    }
                    @if (selectedBlocked)
                    {
                        <p style="font-size: 0.78rem; color: var(--danger, #ef4444); margin: 0 0 8px;">
                            Blocked by @(string.Join(", ", selectedReadiness!.BlockedBy.Select(n => $"#{n}").Concat(selectedReadiness.BlockedByUrls ?? [])))
                        </p>
                    }
                    @* Note: the Dispatch button is intentionally enabled for issues with lifecycle labels
                       (agent:done, agent:error, etc.). Manual dispatch is a force-re-queue workflow that
                       clears the blocking label via AgentLabelOperations.SwapAsync. Do not add disabled
                       conditions for label-only states without reading IssueDrawerService.DispatchIssueAsync. *@
                    @if (CanDispatch)
                    {
                    <button class="btn-save" @onclick="DispatchSelected"
                            disabled="@(IsDispatching || selectedBlocked)"
                            title="@(selectedBlocked ? $"Blocked by open dependencies: {string.Join(", ", selectedReadiness!.BlockedBy.Select(n => $"#{n}").Concat(selectedReadiness.BlockedByUrls ?? []))}" : "")"
                            data-testid="dispatch-issue-btn">
                        @(IsDispatching ? "Dispatching..." : $"Start Pipeline on #{SelectedItem.Identifier}")
                    </button>
                    }
                </div>
            }
        }
    }
</aside>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<IssueSummary> Issues { get; set; } = [];
    [Parameter, EditorRequired] public bool HasMore { get; set; }
    [Parameter, EditorRequired] public int Page { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }
    [Parameter] public EventCallback OnPrevPage { get; set; }
    [Parameter] public Dictionary<string, DependencyCheckResult> Readiness { get; set; } = new();
    [Parameter] public IReadOnlyList<string> AvailableLabels { get; set; } = [];
    [Parameter] public IReadOnlyList<string> SelectedLabels { get; set; } = [];
    [Parameter] public EventCallback<string> OnToggleLabel { get; set; }
    [Parameter] public EventCallback OnClearLabels { get; set; }

    // Prevent default only disrupts scroll on arrow keys; keeping false avoids keyboard traps (Tab works normally)
    private static bool ShouldPreventDefault => false;

    /// <summary>
    /// Display state for an issue in the drawer, computed from WorkItem status, labels, and dependency check.
    /// Precedence: WorkItem (Running/Queued) > Labels > Dependency > Ready.
    /// </summary>
    private enum IssueDisplayState
    {
        Running, Queued, InProgress, Done, Error, WontDo, NeedsRefinement, Epic, Parked, Blocked, Ready, Unknown
    }

    /// <summary>
    /// Computes the display state for an issue based on its WorkItem status, labels, and readiness.
    /// </summary>
    private static IssueDisplayState GetIssueDisplayState(
        IssueSummary issue,
        DependencyCheckResult? readiness,
        WorkItemStatus? processingStatus)
    {
        // 1. WorkItem status takes highest precedence
        if (processingStatus == WorkItemStatus.Running || processingStatus == WorkItemStatus.Dispatched)
            return IssueDisplayState.Running;
        if (processingStatus == WorkItemStatus.Pending)
            return IssueDisplayState.Queued;

        // 2. Agent lifecycle labels — checked before dependency to prevent "Ready" for labelled issues
        var labels = issue.Labels;
        if (labels.Any(l => l.Equals(AgentLabels.InProgress, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.InProgress;
        if (labels.Any(l => l.Equals(AgentLabels.Done, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.Done;
        if (labels.Any(l => l.Equals(AgentLabels.Error, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.Error;
        if (labels.Any(l => l.Equals(AgentLabels.WontDo, StringComparison.OrdinalIgnoreCase)
                         || l.Equals(AgentLabels.Cancelled, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.WontDo;
        if (labels.Any(l => l.Equals(AgentLabels.NeedsRefinement, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.NeedsRefinement;
        if (labels.Any(l => l.Equals(AgentLabels.Next, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.Queued;
        if (labels.Any(l => l.Equals(AgentLabels.Epic, StringComparison.OrdinalIgnoreCase)
                         || l.Equals(AgentLabels.EpicApproved, StringComparison.OrdinalIgnoreCase)
                         || l.Equals(AgentLabels.EpicReview, StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.Epic;
        if (labels.Any(l => l.Equals("backlog", StringComparison.OrdinalIgnoreCase))) return IssueDisplayState.Parked;

        // 3. Dependency check
        if (readiness is { IsReady: false }) return IssueDisplayState.Blocked;

        // 4. Ready — only when none of the above applies
        if (readiness is { IsReady: true }) return IssueDisplayState.Ready;

        return IssueDisplayState.Unknown;
    }

    protected override void OnParametersSet()
    {
        Items = Issues;
        base.OnParametersSet();
    }

    protected override bool MatchesFilter(IssueSummary item, string filter) =>
        item.Identifier.Contains(filter, StringComparison.OrdinalIgnoreCase)
        || item.Title.Contains(filter, StringComparison.OrdinalIgnoreCase);

    protected override string GetIdentifier(IssueSummary item) => item.Identifier;

    private async Task NextPage() => await OnNextPage.InvokeAsync();
    private async Task PrevPage() => await OnPrevPage.InvokeAsync();
    private async Task ToggleLabel(string label) => await OnToggleLabel.InvokeAsync(label);
    private async Task ClearLabels() => await OnClearLabels.InvokeAsync();

    /// <summary>
    /// Extracts a plain-text preview from the issue body, stripping markdown headings and trimming.
    /// Returns text up to the first ## heading or the first line of content, with inline markdown stripped.
    /// </summary>
    private static string GetBodyPreview(string body)
    {
        // Take content up to first ## heading (skip leading whitespace/blank lines)
        var lines = body.Split('\n');
        foreach (var line in lines)
        {
            var trimmed = line.Trim();
            if (string.IsNullOrEmpty(trimmed)) continue;
            if (trimmed.StartsWith("##")) continue;
            // Strip leading # (title heading)
            // TODO [WARNING]: Lines starting with a single "#" have the "#" stripped but are still
            // returned as the preview. For issues whose body begins with "# Title\nDetails...", this
            // returns the title text as the preview, which duplicates the issue title already shown
            // in drawer-issue-title. Consider also skipping single-"#" heading lines (like "##" lines
            // are skipped) so the first non-heading content line is used as the preview instead.
            if (trimmed.StartsWith('#')) trimmed = trimmed.TrimStart('#').Trim();
            // Strip inline markdown syntax (bold, italic, code, blockquotes, list markers)
            return UiFormatters.StripMarkdown(trimmed);
        }
        return string.Empty;
    }
}
