@page "/fleet"
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models
@using CodingAgent.Web.Components.Shared
@inject IPipelineApiAgentClient AgentClient

@*
    Fleet — registered agents split out of Monitoring (see docs/frontend-redesign-handoff.md).
    Data: IPipelineApiAgentClient.GetAgentsAsync → AgentEntryDto[]. Status is Idle / Busy / Disconnected.
    Enrichment fields (ActiveIssueUrl, ActiveRunId, ActivePullRequestUrl, etc.) are populated by the
    API endpoint from IOrchestratorRunService and rendered as inline chips in the agent row.
*@

<PageTitle>Fleet - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Fleet</h1>
            <span class="cockpit-page-sub">Registered agents — status, capacity, and current work</span>
        </div>
        <RefreshBar OnRefresh="RefreshQuietAsync" IsLoading="@(_loading && _agents is null)" />
    </div>

    @* TODO: [WARNING] Fleet shows agent status (Idle/Busy) which changes on job assignment/completion.
       The run-scoped hub events (OnStepTransition, OnRunCompleted) are not wired here because they are
       sent only to run-specific groups and agent heartbeat/status events are not exposed via
       IAgentHubUiClient. A global agent-status push event would enable reactive Fleet updates.
       Until then, the RefreshBar auto-refresh polling is the only mechanism for background updates. *@

    @if (_loading && _agents is null)
    {
        <div class="cockpit-card"><div class="cockpit-empty">Loading agents…</div></div>
    }
    else if (_error is not null)
    {
        <div class="cockpit-card"><div class="cockpit-empty">@_error</div></div>
    }
    else
    {
        var agents = _agents ?? [];

        <div class="cockpit-stat-strip">
            <div class="cockpit-stat"><span class="cockpit-stat-l">Agents</span><span class="cockpit-stat-v">@agents.Count</span></div>
            <div class="cockpit-stat" title="@(_pool is { Total: > 0 } ? "Kiro credential (PVC) slots available / configured" : "Credential pooling not configured")">
                <span class="cockpit-stat-l">Kiro Credentials <span class="cockpit-chip" style="font-size: 9.5px; padding: 1px 5px; vertical-align: middle;">kiro</span></span>
                <span class="cockpit-stat-v">
                    @if (_pool is { Total: > 0 } p)
                    {
                        <span style="color: @(p.Available == 0 ? "var(--error)" : "var(--success)");">@p.Available</span><span style="font-size: 15px; color: var(--text-faint);">/@p.Total</span>
                    }
                    else
                    {
                        <span style="font-size: 15px; color: var(--text-faint);">—</span>
                    }
                </span>
            </div>
        </div>
        @if (_pool is { Total: > 0, Available: 0 })
        {
            <div class="cockpit-card cockpit-card-pad" style="color: var(--error); font-size: 12.5px; border-color: var(--error);">
                <Icon Name="alert-triangle" Size="14" /> Credential pool exhausted — all @_pool.Total slots are claimed, so new work can't dispatch until one frees up.
            </div>
        }

        <div class="cockpit-card">
            @if (agents.Count == 0)
            {
                <div class="cockpit-empty">No agents registered.</div>
            }
            else
            {
                <div class="monitoring-table-wrap">
                    <table class="monitoring-table">
                        <thead>
                            <tr>
                                <th>Agent</th>
                                <th>Labels</th>
                                <th>Status</th>
                                <th>Active work</th>
                                <th>Heartbeat</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in agents.OrderBy(a => a.Status).ThenBy(a => a.AgentId.Value))
                            {
                                var isOpen = _expandedId == a.AgentId.Value;
                                <tr class="monitoring-row-clickable" @onclick="() => Toggle(a.AgentId.Value)">
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 9px;">
                                            <span class="fleet-chevron"><Icon Name="@(isOpen ? "chevron-down" : "chevron-right")" Size="14" /></span>
                                            <div>
                                                <div class="monitoring-mono" style="font-weight: 600;">@a.AgentId.Value</div>
                                                <div class="monitoring-mono monitoring-muted" style="font-size: 0.72rem;">@a.Hostname</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        @foreach (var label in a.Labels)
                                        {
                                            <span class="cockpit-chip mono">@label</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="monitoring-status monitoring-status-@a.Status.ToString().ToLowerInvariant()">@a.Status</span>
                                        @if (a.Disabled)
                                        {
                                            <span class="cockpit-chip" style="color: var(--warning); background: var(--warning-bg); margin-left: 5px;">Disabled</span>
                                        }
                                    </td>
                                    <td class="fleet-work-cell" @onclick:stopPropagation="true">
                                        @if (!string.IsNullOrEmpty(a.ActiveIssueUrl))
                                        {
                                            @* TODO: Validate that ActiveIssueUrl starts with https:// before rendering as href.
                                               Blazor HTML-encodes attribute values but does NOT strip javascript: URI schemes,
                                               so a malicious/corrupted record could produce a clickable XSS link. *@
                                            <a href="@a.ActiveIssueUrl" target="_blank" rel="noopener noreferrer" class="runs-link" title="Open issue @a.ActiveIssueIdentifier">
                                                <Icon Name="message-square" Size="13" /> #@a.ActiveIssueIdentifier
                                                @if (!string.IsNullOrEmpty(a.ActiveIssueTitle))
                                                {
                                                    <span class="monitoring-muted"> — @Truncate(a.ActiveIssueTitle, 35)</span>
                                                }
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(a.ActiveRunId))
                                        {
                                            <a href="/runs/@a.ActiveRunId" class="runs-link" title="Open pipeline run">
                                                <Icon Name="play-circle" Size="13" /> Run
                                            </a>
                                        }
                                        @if (!string.IsNullOrEmpty(a.ActivePullRequestUrl))
                                        {
                                            @* TODO: Validate that ActivePullRequestUrl starts with https:// before rendering as href.
                                               Same javascript: URI injection risk as ActiveIssueUrl above. *@
                                            <a href="@a.ActivePullRequestUrl" target="_blank" rel="noopener noreferrer" class="runs-link runs-link-pr" title="Open pull request">
                                                <Icon Name="git-pull-request" Size="13" /> PR
                                            </a>
                                        }
                                        @if (string.IsNullOrEmpty(a.ActiveIssueUrl) && string.IsNullOrEmpty(a.ActiveRunId) && string.IsNullOrEmpty(a.ActivePullRequestUrl))
                                        {
                                            <span class="monitoring-mono monitoring-muted">—</span>
                                        }
                                    </td>
                                    <td title="@Abs(a.LastHeartbeatAt)">@Ago(a.LastHeartbeatAt)</td>
                                </tr>
                                @if (isOpen)
                                {
                                    <tr class="fleet-detail-row">
                                        <td colspan="5">
                                            <div class="cockpit-detail-grid">
                                                <div class="cockpit-detail-item"><div class="k">Hostname</div><div class="v mono">@a.Hostname</div></div>
                                                <div class="cockpit-detail-item"><div class="k">Connection ID</div><div class="v mono">@a.ConnectionId</div></div>
                                                <div class="cockpit-detail-item"><div class="k">Registered</div><div class="v" title="@Abs(a.RegisteredAt)">@Ago(a.RegisteredAt)</div></div>
                                                <div class="cockpit-detail-item"><div class="k">Last heartbeat</div><div class="v" title="@Abs(a.LastHeartbeatAt)">@Ago(a.LastHeartbeatAt)</div></div>
                                                @if (a.BusySince is not null)
                                                {
                                                    <div class="cockpit-detail-item"><div class="k">Busy since</div><div class="v" title="@Abs(a.BusySince.Value)">@Ago(a.BusySince.Value)</div></div>
                                                }
                                                @if (!string.IsNullOrEmpty(a.ActiveIssueIdentifier))
                                                {
                                                    <div class="cockpit-detail-item">
                                                        <div class="k">Active issue</div>
                                                        <div class="v">
                                                            @if (!string.IsNullOrEmpty(a.ActiveIssueUrl))
                                                            {
                                                                @* TODO: Validate that ActiveIssueUrl starts with https:// before rendering as href.
                                                                   Blazor HTML-encodes attribute values but does NOT strip javascript: URI schemes,
                                                                   so a malicious/corrupted record could produce a clickable XSS link. *@
                                                                <a href="@a.ActiveIssueUrl" target="_blank" rel="noopener noreferrer">#@a.ActiveIssueIdentifier</a>
                                                            }
                                                            else
                                                            {
                                                                <span class="mono">#@a.ActiveIssueIdentifier</span>
                                                            }
                                                            @if (!string.IsNullOrEmpty(a.ActiveIssueTitle))
                                                            {
                                                                <span class="monitoring-muted"> @a.ActiveIssueTitle</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(a.ActiveRunId))
                                                {
                                                    <div class="cockpit-detail-item">
                                                        <div class="k">Active run</div>
                                                        <div class="v"><a href="/runs/@a.ActiveRunId" class="mono">@a.ActiveRunId</a></div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(a.ActivePullRequestUrl))
                                                {
                                                    <div class="cockpit-detail-item">
                                                        <div class="k">Pull request</div>
                                                        @* TODO: Validate that ActivePullRequestUrl starts with https:// before rendering as href.
                                                           Blazor HTML-encodes attribute values but does NOT strip javascript: URI schemes,
                                                           so a malicious/corrupted record could produce a clickable XSS link. *@
                                                        <div class="v"><a href="@a.ActivePullRequestUrl" target="_blank" rel="noopener noreferrer">@a.ActivePullRequestUrl</a></div>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(a.ActiveChatSessionId))
                                                {
                                                    <div class="cockpit-detail-item"><div class="k">Active chat</div><div class="v mono">@a.ActiveChatSessionId</div></div>
                                                }
                                                @if (a.LastJobCompletedAt is not null)
                                                {
                                                    <div class="cockpit-detail-item"><div class="k">Last job completed</div><div class="v" title="@Abs(a.LastJobCompletedAt.Value)">@Ago(a.LastJobCompletedAt.Value)</div></div>
                                                }
                                                @if (a.DisconnectedAt is not null)
                                                {
                                                    <div class="cockpit-detail-item"><div class="k">Disconnected</div><div class="v" title="@Abs(a.DisconnectedAt.Value)">@Ago(a.DisconnectedAt.Value)</div></div>
                                                }
                                                @if (a.OrphanRestoredAt is not null)
                                                {
                                                    <div class="cockpit-detail-item"><div class="k">Orphan restored</div><div class="v" title="@Abs(a.OrphanRestoredAt.Value)">@Ago(a.OrphanRestoredAt.Value)</div></div>
                                                }
                                                <div class="cockpit-detail-item"><div class="k">Disabled</div><div class="v">@(a.Disabled ? "Yes — excluded from job selection" : "No")</div></div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private IReadOnlyList<AgentEntryDto>? _agents;
    private CredentialPoolStatus? _pool;
    private bool _loading = true;
    private string? _error;
    private string? _expandedId;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private void Toggle(string agentId) => _expandedId = _expandedId == agentId ? null : agentId;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _agents = await AgentClient.GetAgentsAsync(_cts.Token);
            await LoadPoolAsync();
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to load agents: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // Credential pool is secondary — a failure here must not fault the agents view.
    private async Task LoadPoolAsync()
    {
        try { _pool = await AgentClient.GetCredentialPoolAsync(_cts.Token); }
        catch (OperationCanceledException) { throw; }
        catch { _pool = null; }
    }

    // Quiet tick refresh — no spinner, keeps the expanded row and stale data on a transient error.
    private async Task RefreshQuietAsync()
    {
        try
        {
            _agents = await AgentClient.GetAgentsAsync(_cts.Token);
            await LoadPoolAsync();
            _error = null;
        }
        catch (OperationCanceledException) { }
        catch { /* keep last-known agents until the next tick */ }
    }

    private static string Ago(DateTimeOffset t)
    {
        var d = DateTimeOffset.UtcNow - t;
        if (d.TotalSeconds < 60) return $"{Math.Max(0, (int)d.TotalSeconds)}s ago";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    private static string Abs(DateTimeOffset t) => t.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string Truncate(string? s, int max) =>
        string.IsNullOrEmpty(s) ? "" : s.Length <= max ? s : s[..max] + "…";

    public async ValueTask DisposeAsync()
    {
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
