@page "/overview"
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models
@using CodingAgent.Pipeline.Services
@using CodingAgent.Web.Services
@using CodingAgent.Web.Components.Shared
@inject ILoopStatusService LoopService
@inject IPipelineApiRunHistoryClient RunHistory
@inject IPipelineApiAgentClient AgentClient
@inject IPipelineApiWorkItemClient WorkItems
@inject CockpitState State
@inject NavigationManager Nav

@*
    Overview — the cockpit landing (see docs/frontend-redesign-handoff.md).
    Loop status is read-only here (control lives in Pipelines). Stats are computed from the
    fetched run page and labelled "recent" — a true 24h aggregate needs a stats endpoint.
*@

<PageTitle>Overview - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Overview</h1>
            <span class="cockpit-page-sub">Fleet status at a glance</span>
        </div>
    </div>

    <AutoRefresh IntervalSeconds="10" OnTick="RefreshDataAsync" />

    <!-- loop status hero -->
    <div class="cockpit-card cockpit-card-pad" style="display: flex; align-items: center; justify-content: space-between; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <span style="width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; background: @LoopIconBg; color: @LoopIconColor;">
                <Icon Name="refresh-cw" Size="20" />
            </span>
            <div style="display: flex; flex-direction: column; gap: 3px;">
                <span style="font-size: 15px; font-weight: 700;">@LoopTitle</span>
                <span style="font-size: 12.5px; color: var(--text-muted);">@LoopSubtitle</span>
            </div>
        </div>
        <a href="pipelines" class="cockpit-pager-btn" style="text-decoration: none;">Manage <Icon Name="chevrons-right" Size="14" /></a>
    </div>

    <!-- stat strip -->
    <div class="cockpit-stat-strip">
        <div class="cockpit-stat"><span class="cockpit-stat-l">Active</span><span class="cockpit-stat-v">@_activeCount</span></div>
        <div class="cockpit-stat"><span class="cockpit-stat-l">Queue</span><span class="cockpit-stat-v">@_queueCount</span></div>
        <div class="cockpit-stat"><span class="cockpit-stat-l">Agents</span><span class="cockpit-stat-v">@_agentsOnline</span></div>
        <div class="cockpit-stat"><span class="cockpit-stat-l">Success · last 100</span><span class="cockpit-stat-v">@(_successRate is { } rate ? $"{rate}%" : "—")</span></div>
        @if (_anyRunHasTokens)
        {
            <div class="cockpit-stat"><span class="cockpit-stat-l">Tokens · recent</span><span class="cockpit-stat-v">@CostFormatter.FormatTokens(_tokensRecent)</span></div>
        }
    </div>

    @if (_attnNeedsRefinement + _attnFailed + _attnPlans > 0)
    {
        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Needs attention</h2><a href="attention" style="font-size: 12.5px; font-weight: 600;">View all →</a></div>
            <div class="cockpit-kpi-3col">
                <a href="attention" style="display: flex; align-items: center; gap: 11px; padding: 14px 18px; border-right: 1px solid var(--hairline); text-decoration: none; color: inherit;">
                    <span style="width: 34px; height: 34px; border-radius: 9px; background: var(--warning-bg); color: var(--warning); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon Name="alert-triangle" Size="17" /></span>
                    <div><div style="font-size: 18px; font-weight: 800;">@_attnNeedsRefinement</div><div style="font-size: 12px; color: var(--text-muted);">Needs refinement</div></div>
                </a>
                <a href="attention" style="display: flex; align-items: center; gap: 11px; padding: 14px 18px; border-right: 1px solid var(--hairline); text-decoration: none; color: inherit;">
                    <span style="width: 34px; height: 34px; border-radius: 9px; background: var(--error-bg); color: var(--error); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon Name="x-circle" Size="17" /></span>
                    <div><div style="font-size: 18px; font-weight: 800;">@_attnFailed</div><div style="font-size: 12px; color: var(--text-muted);">Failed runs</div></div>
                </a>
                <a href="attention" style="display: flex; align-items: center; gap: 11px; padding: 14px 18px; text-decoration: none; color: inherit;">
                    <span style="width: 34px; height: 34px; border-radius: 9px; background: var(--bg-active); color: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon Name="puzzle" Size="17" /></span>
                    <div><div style="font-size: 18px; font-weight: 800;">@_attnPlans</div><div style="font-size: 12px; color: var(--text-muted);">Plans to approve</div></div>
                </a>
            </div>
        </div>
    }

    <div class="cockpit-two-col">
        <!-- active runs -->
        <div class="cockpit-card">
            <div class="cockpit-card-header">
                <h2>Active runs</h2>
                @if (_activeRuns.Count > ActiveRunsPreview)
                {
                    <a href="runs" style="font-size: 12.5px; font-weight: 600;">All @_activeRuns.Count →</a>
                }
                else
                {
                    <span style="font-size: 12px; color: var(--text-muted);">@_activeRuns.Count</span>
                }
            </div>
            @if (_activeRuns.Count == 0)
            {
                <div class="cockpit-empty" style="padding: 24px;">No runs in flight.</div>
            }
            else
            {
                @foreach (var run in _activeRuns.Take(ActiveRunsPreview))
                {
                    <div class="cockpit-run-row" @onclick="() => OpenRun(run.RunId)">
                        <div style="min-width: 0;">
                            <div style="font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">#@run.IssueIdentifier @run.IssueTitle</div>
                            <div class="mono" style="font-size: 11px; color: var(--text-muted);">@(run.AgentId ?? "—") · @run.FinalStep.ToDisplayName()</div>
                        </div>
                        <span class="step-badge step-running" style="flex-shrink: 0;">Running</span>
                    </div>
                }
            }
        </div>

        <!-- recent activity -->
        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Recent activity</h2><a href="runs" style="font-size: 12.5px; font-weight: 600;">All runs →</a></div>
            @if (_recentRuns.Count == 0)
            {
                <div class="cockpit-empty" style="padding: 24px;">No completed runs yet.</div>
            }
            else
            {
                @foreach (var run in _recentRuns.Take(6))
                {
                    var cls = RunOutcomeDisplay.BadgeClass(run.FinalStep);
                    var label = RunOutcomeDisplay.Label(run.FinalStep);
                    <div class="cockpit-run-row" @onclick="() => OpenRun(run.RunId)">
                        <div style="min-width: 0;">
                            <div style="font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">#@run.IssueIdentifier @run.IssueTitle</div>
                            <div class="mono" style="font-size: 11px; color: var(--text-muted);">@(run.AgentId ?? "—")@(run.TotalTokens > 0 ? " · " + CostFormatter.FormatTokens(run.TotalTokens) : "")</div>
                        </div>
                        <span class="step-badge @cls" style="flex-shrink: 0;">@label</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cts = new();

    private const int ActiveRunsPreview = 5;

    private int _activeCount;
    private int _queueCount;
    private int _agentsOnline;
    private int? _successRate;
    private long _tokensRecent;
    private bool _anyRunHasTokens;
    private int _attnNeedsRefinement, _attnFailed, _attnPlans;
    private List<PipelineRunSummary> _activeRuns = new();
    private List<PipelineRunSummary> _recentRuns = new();

    protected override void OnInitialized()
    {
        LoopService.OnChange += HandleLoopChanged;
        State.OnProjectChanged += HandleProjectChanged;
    }

    protected override async Task OnInitializedAsync() => await RefreshDataAsync();

    // Re-fetch when the top-bar project scope changes.
    private async void HandleProjectChanged()
    {
        try
        {
            await RefreshDataAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    // Re-fetched on load and on each auto-refresh tick. Degrades quietly (keeps prior values).
    private async Task RefreshDataAsync()
    {
        // Agents
        try
        {
            var agents = await AgentClient.GetAgentsAsync(_cts.Token);
            _agentsOnline = agents.Count(a => a.Status != AgentStatus.Disconnected);
        }
        catch (OperationCanceledException) { return; }
        catch { /* degrade — leave zeros */ }

        // Queue (pending work items)
        try
        {
            var pending = await WorkItems.GetPendingAsync(maxResults: 100, projectId: State.SelectedProjectId, ct: _cts.Token);
            _queueCount = pending.Count;
        }
        catch (OperationCanceledException) { return; }
        catch { }

        // Runs — one page, active + recent, aggregated client-side
        try
        {
            // pageSize matches Attention.razor and Insights.razor (both use 100) so that the "Failed runs"
            // count on the Overview card agrees with those pages. Consider a dedicated server-side
            // counts/stats endpoint so none of the pages depend on a client-side page window.
            var runs = await RunHistory.GetRunHistoryAsync(page: 1, pageSize: 100, feedbackOnly: false, includeActive: true, projectId: State.SelectedProjectId, ct: _cts.Token);
            var items = runs.Items;

            _activeRuns = items.Where(r => RunOutcomeDisplay.IsActive(r.FinalStep)).ToList();
            _recentRuns = items.Where(r => !RunOutcomeDisplay.IsActive(r.FinalStep)).ToList();
            _activeCount = _activeRuns.Count;

            _successRate = RunOutcomeDisplay.SuccessRate(_recentRuns);
            // TODO: [WARNING] _tokensRecent sums all fetched items including active (in-flight) runs, which
            // have partial token counts that will fluctuate each refresh cycle. Previously only completed
            // runs were summed. The label "Tokens · recent" may be misleading since active-run tokens are
            // included and will visibly jump every 10 s for long-running jobs. Consider summing only
            // _recentRuns (non-active) to restore the previous semantic, or update the label to clarify.
            _tokensRecent = items.Sum(r => r.TotalTokens);
            _anyRunHasTokens = items.Any(r => r.TotalTokens > 0);

            var attn = AttentionAggregator.Aggregate(_recentRuns);
            _attnNeedsRefinement = attn.NeedsRefinement.Count;
            _attnFailed = attn.FailedRuns.Count;
            _attnPlans = attn.PlansToApprove.Count;
        }
        catch (OperationCanceledException) { return; }
        catch { }
    }

    // NavigationManager.NavigateTo with a bare relative path resolves against BaseUri (the app
    // root), not the current page URL — this is the correct Blazor Server behaviour.
    private void OpenRun(string runId) => Nav.NavigateTo($"runs/{runId}");

    // ── loop hero (read-only) ───────────────────────────────────────────────
    private string LoopTitle => LoopService.IsSchedulerUnreachable ? "Scheduler unavailable"
        : LoopService.IsCircuitBroken ? "Loop paused — circuit broken"
        : LoopService.IsLoopActive ? "Closed-loop active" : "Loop idle";

    private string LoopSubtitle
    {
        get
        {
            if (LoopService.IsSchedulerUnreachable) return "Loop controls are disabled until the scheduler is reachable.";
            if (LoopService.IsLoopActive)
                return $"Polling template {LoopService.CurrentCycleTemplateIndex + 1} of {LoopService.CurrentCycleTemplateCount} · processed {LoopService.ProcessedCount} · failed {LoopService.FailedCount}";
            return "Start the closed loop from Pipelines to auto-dispatch queued work.";
        }
    }

    private string LoopIconBg => LoopService.IsSchedulerUnreachable || LoopService.IsCircuitBroken ? "var(--warning-bg)"
        : LoopService.IsLoopActive ? "var(--bg-info)" : "var(--surface-alt)";
    private string LoopIconColor => LoopService.IsSchedulerUnreachable || LoopService.IsCircuitBroken ? "var(--warning)"
        : LoopService.IsLoopActive ? "#0E7490" : "var(--text-muted)";

    private async void HandleLoopChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        LoopService.OnChange -= HandleLoopChanged;
        State.OnProjectChanged -= HandleProjectChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
