@using CodingAgent.Api.Client
@using CodingAgent.Pipeline.Models

<section class="settings-section">
    <h2>Advanced</h2>
    <p class="section-description">Agent routing, the brain repository, issue images, data retention and comment delivery.</p>
    <div class="provider-form">
        <div class="config-sub-fields">
            <h3>Agent Routing</h3>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.DefaultRequiredAgentLabels)">
                <div class="label-with-hint">
                    <label>Default Required Agent Labels</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Global fallback for agent label routing when a repo's provider config doesn't specify labels. Comma-separated (e.g. 'kiro,dotnet'). Leave empty for any idle agent.">?</span>
                </div>
                <input type="text" @bind="_defaultRequiredAgentLabels" placeholder="(any agent)" />
                <span class="form-hint">Comma-separated. Empty = any idle agent can be selected.</span>
            </div>
        </div>

        <div class="config-sub-fields" style="margin-top: 1rem;">
            <h3>Brain Repository</h3>
            <div class="form-group form-checkbox" data-setting="@nameof(PipelineConfiguration.BrainReadOnly)">
                <label>
                    <input type="checkbox" @bind="_brainReadOnly" />
                    Brain Read-Only
                </label>
                <span class="form-hint">Runs read the brain but never write to it, and brain consolidation does not run. A project or template can also turn this on.</span>
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.BrainPushMaxRetries)">
                <div class="label-with-hint">
                    <label>Brain Push Max Retries</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Retry attempts when brain repo push fails with non-fast-forward (concurrent conflict). Each retry fetches, rebases, resolves conflicts. Default: 3">?</span>
                </div>
                <input type="number" @bind="_brainPushMaxRetries" min="@SettingLimits.Min(nameof(PipelineConfiguration.BrainPushMaxRetries))" max="@SettingLimits.Max(nameof(PipelineConfiguration.BrainPushMaxRetries))" />
            </div>
        </div>

        <div class="config-sub-fields" style="margin-top: 1rem;">
            <h3>Issue Images</h3>
            <div class="form-group form-checkbox" data-setting="@nameof(PipelineConfiguration.EnableIssueImageExtraction)">
                <label>
                    <input type="checkbox" @bind="_enableIssueImageExtraction" />
                    Download Images from Issues and PRs
                </label>
            </div>
            <div class="form-group form-checkbox" data-setting="@nameof(PipelineConfiguration.EnableNativeImageParts)">
                <label>
                    <input type="checkbox" @bind="_enableNativeImageParts" disabled="@(!_enableIssueImageExtraction)" />
                    Send Images to the Agent as Images
                </label>
                <span class="form-hint">Turn off for models without image input; the prompt still references the downloaded files.</span>
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.MaxIssueImages)">
                <div class="label-with-hint">
                    <label>Max Images per Issue</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Maximum images downloaded per issue or PR. Default: 10">?</span>
                </div>
                <input type="number" @bind="_maxIssueImages" min="@SettingLimits.Min(nameof(PipelineConfiguration.MaxIssueImages))" max="@SettingLimits.Max(nameof(PipelineConfiguration.MaxIssueImages))" disabled="@(!_enableIssueImageExtraction)" />
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.MaxImageSizeBytes)">
                <div class="label-with-hint">
                    <label>Max Image Size (MB)</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Larger images are skipped. Default: 5 MB">?</span>
                </div>
                <input type="number" @bind="_maxImageSizeMegabytes" min="@SettingLimits.Min(nameof(PipelineConfiguration.MaxImageSizeBytes), SettingUnit.Megabytes)" max="@SettingLimits.Max(nameof(PipelineConfiguration.MaxImageSizeBytes), SettingUnit.Megabytes)" disabled="@(!_enableIssueImageExtraction)" />
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.MaxTotalImageSizeBytes)">
                <div class="label-with-hint">
                    <label>Max Total Image Size (MB)</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Download stops once the images of one issue reach this size. Default: 20 MB">?</span>
                </div>
                <input type="number" @bind="_maxTotalImageSizeMegabytes" min="@SettingLimits.Min(nameof(PipelineConfiguration.MaxTotalImageSizeBytes), SettingUnit.Megabytes)" max="@SettingLimits.Max(nameof(PipelineConfiguration.MaxTotalImageSizeBytes), SettingUnit.Megabytes)" disabled="@(!_enableIssueImageExtraction)" />
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.TotalImageDownloadTimeoutSeconds)">
                <div class="label-with-hint">
                    <label>Image Download Time Budget (seconds)</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Total time for downloading the images of one issue or PR. Default: 60s">?</span>
                </div>
                <input type="number" @bind="_totalImageDownloadTimeoutSeconds" min="@SettingLimits.Min(nameof(PipelineConfiguration.TotalImageDownloadTimeoutSeconds))" max="@SettingLimits.Max(nameof(PipelineConfiguration.TotalImageDownloadTimeoutSeconds))" disabled="@(!_enableIssueImageExtraction)" />
            </div>
        </div>

        <div class="config-sub-fields" style="margin-top: 1rem;">
            <h3>Data Retention</h3>
            <div class="form-hint">
                <Icon Name="info" /> The hourly retention sweep keeps the newest finished rows of each project and deletes older ones. Active work is never deleted. 0 keeps every row.
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.PipelineRunRetentionCount)">
                <div class="label-with-hint">
                    <label>Runs Kept per Project</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Completed pipeline runs kept per project. 0 = keep all. Default: 0">?</span>
                </div>
                <input type="number" @bind="_pipelineRunRetentionCount" min="0" max="@SettingLimits.Max(nameof(PipelineConfiguration.PipelineRunRetentionCount))" />
            </div>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.WorkItemRetentionCount)">
                <div class="label-with-hint">
                    <label>Finished Work Items Kept per Project</label>
                    <span class="form-hint-icon" aria-hidden="true" title="Succeeded, failed and cancelled work items kept per project. 0 = keep all. Default: 0">?</span>
                </div>
                <input type="number" @bind="_workItemRetentionCount" min="0" max="@SettingLimits.Max(nameof(PipelineConfiguration.WorkItemRetentionCount))" />
            </div>
        </div>

        <div class="config-sub-fields" style="margin-top: 1rem;">
            <h3>Comment Delivery</h3>
            <div class="form-group" data-setting="@nameof(PipelineConfiguration.FeedbackCommentOutboxMaxAttempts)">
                <div class="label-with-hint">
                    <label>Feedback Comment Delivery Attempts</label>
                    <span class="form-hint-icon" aria-hidden="true" title="How often the Scheduler tries to post a run's feedback comment before giving up on it. Default: 5">?</span>
                </div>
                <input type="number" @bind="_feedbackCommentOutboxMaxAttempts" min="@SettingLimits.Min(nameof(PipelineConfiguration.FeedbackCommentOutboxMaxAttempts))" max="@SettingLimits.Max(nameof(PipelineConfiguration.FeedbackCommentOutboxMaxAttempts))" />
            </div>
        </div>

        <div class="pipeline-form-actions">
            <button class="btn-save" @onclick="SaveAsync">Save Advanced Settings</button>
        </div>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public IPipelineApiConfigClient ConfigClient { get; set; } = default!;
    [Parameter] public EventCallback<(string Message, bool IsError)> OnShowStatus { get; set; }

    private string _defaultRequiredAgentLabels = "";
    private bool _brainReadOnly;
    private int _brainPushMaxRetries = 3;
    private bool _enableIssueImageExtraction = true;
    private bool _enableNativeImageParts = true;
    private int _maxIssueImages = 10;
    private int _maxImageSizeMegabytes = 5;
    private int _maxTotalImageSizeMegabytes = 20;
    private int _totalImageDownloadTimeoutSeconds = 60;
    private int _pipelineRunRetentionCount;
    private int _workItemRetentionCount;
    private int _feedbackCommentOutboxMaxAttempts = PipelineConstants.DefaultFeedbackCommentOutboxMaxAttempts;

    protected override async Task OnInitializedAsync()
    {
        var config = await ConfigClient.GetPipelineConfigAsync(CancellationToken.None);
        _defaultRequiredAgentLabels = config.DefaultRequiredAgentLabels ?? "";
        _brainReadOnly = config.BrainReadOnly;
        _brainPushMaxRetries = config.BrainPushMaxRetries;
        _enableIssueImageExtraction = config.EnableIssueImageExtraction;
        _enableNativeImageParts = config.EnableNativeImageParts;
        _maxIssueImages = config.MaxIssueImages;
        _maxImageSizeMegabytes = SettingLimits.ToMegabytes(config.MaxImageSizeBytes);
        _maxTotalImageSizeMegabytes = SettingLimits.ToMegabytes(config.MaxTotalImageSizeBytes);
        _totalImageDownloadTimeoutSeconds = config.TotalImageDownloadTimeoutSeconds;
        // -1 is the stored form of "keep every row" from before 0 meant the same.
        _pipelineRunRetentionCount = Math.Max(0, config.PipelineRunRetentionCount);
        _workItemRetentionCount = Math.Max(0, config.WorkItemRetentionCount);
        _feedbackCommentOutboxMaxAttempts = config.FeedbackCommentOutboxMaxAttempts;
    }

    private async Task SaveAsync()
    {
        try
        {
            var labels = string.IsNullOrWhiteSpace(_defaultRequiredAgentLabels)
                ? null
                : _defaultRequiredAgentLabels.Trim();

            await ConfigClient.UpdatePipelineConfigAsync(
                current => current with
                {
                    DefaultRequiredAgentLabels = labels,
                    BrainReadOnly = _brainReadOnly,
                    BrainPushMaxRetries = _brainPushMaxRetries,
                    EnableIssueImageExtraction = _enableIssueImageExtraction,
                    EnableNativeImageParts = _enableNativeImageParts,
                    MaxIssueImages = _maxIssueImages,
                    MaxImageSizeBytes = SettingLimits.FromMegabytes(_maxImageSizeMegabytes),
                    MaxTotalImageSizeBytes = SettingLimits.FromMegabytes(_maxTotalImageSizeMegabytes),
                    TotalImageDownloadTimeoutSeconds = _totalImageDownloadTimeoutSeconds,
                    PipelineRunRetentionCount = _pipelineRunRetentionCount,
                    WorkItemRetentionCount = _workItemRetentionCount,
                    FeedbackCommentOutboxMaxAttempts = _feedbackCommentOutboxMaxAttempts
                },
                CancellationToken.None);
            await OnShowStatus.InvokeAsync(("Advanced settings saved.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to save: {ex.Message}", true));
        }
    }
}
