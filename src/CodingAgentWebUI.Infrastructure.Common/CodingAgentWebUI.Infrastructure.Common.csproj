<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Shared cross-cutting infrastructure (telemetry, leader election, secret masking, Serilog OTLP).
       Consumers reach internal helpers (e.g. ActivityTags) via these entries — mirrors Pipeline's set. -->
  <ItemGroup>
    <InternalsVisibleTo Include="CodingAgentWebUI.Pipeline" />
    <InternalsVisibleTo Include="CodingAgentWebUI.Pipeline.UnitTests" />
    <InternalsVisibleTo Include="CodingAgentWebUI.UnitTests" />
    <InternalsVisibleTo Include="CodingAgentWebUI.Orchestration.UnitTests" />
    <InternalsVisibleTo Include="CodingAgentWebUI.Infrastructure.UnitTests" />
    <InternalsVisibleTo Include="CodingAgentWebUI.Agent.UnitTests" />
    <InternalsVisibleTo Include="CodingAgentWebUI.IntegrationTests" />
    <InternalsVisibleTo Include="CodingAgentWebUI.TestUtilities" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Resilience" />
    <PackageReference Include="OpenTelemetry.Api" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <!-- Infrastructure.Common references Contracts (shared enums/types) but NEVER Pipeline. -->
    <ProjectReference Include="..\CodingAgentWebUI.Contracts\CodingAgentWebUI.Contracts.csproj" />
  </ItemGroup>

</Project>
