@using System.Text.RegularExpressions
@using CodingAgent.Pipeline.Models
@using static CodingAgent.Web.Components.Pages.TemplateTableSection

@* Repository settings editor — agent labels, secrets, setup steps, steering, blacklist. *@
@* Used inside TemplateAddForm.razor and RepositoryPage.razor. *@

<div class="repository-settings-editor">
    <h4>Repository Settings</h4>
    <p class="form-hint">These settings apply to agent runs on this template's repository.</p>

    @if (!HideLabels)
    {
        <div class="form-group">
            <label>Required Agent Labels <span class="form-hint">(comma-separated — determines agent routing and quality gates)</span></label>
            <input type="text" value="@_labelsText" @onchange="OnLabelsChanged" placeholder="e.g. kiro, dotnet, dotnet10" />
        </div>
    }

    <div class="form-group">
        <div class="label-with-hint">
            <label>Blacklisted Paths</label>
            <span class="form-hint-icon" aria-hidden="true" title="Comma-separated path prefixes excluded from agent commits (e.g. .kiro, .github). Leave empty to use global defaults.">?</span>
        </div>
        <input type="text" value="@_blacklistedPathsText" @onchange="OnBlacklistedPathsChanged" placeholder=".kiro, .github, .brain" />
    </div>

    <Collapsible CssClass="secrets-section" HeaderClass="secrets-section-header" BodyClass="secrets-section-body"
                 IsExpanded="_secretsExpanded" IsExpandedChanged="v => _secretsExpanded = v">
        <Header>🔑 Secrets (@_secrets.Count)</Header>
        <ChildContent>
            @if (SecretsWriteOnly)
            {
                @* Write-only mode: show key names only, never render stored values. *@
                @for (var i = 0; i < _secrets.Count; i++)
                {
                    var index = i;
                    var secret = _secrets[index];
                    <div class="secret-row">
                        <span class="secret-key-readonly">@secret.Key</span>
                        @if (_replacingSecrets.Contains(index))
                        {
                            <input type="text"
                                   class="secret-value-input"
                                   value="@secret.Value"
                                   @onchange="e => UpdateSecretValue(index, e.Value?.ToString() ?? string.Empty)"
                                   placeholder="new value (blank = keep existing)" />
                            <button type="button" class="btn-icon" title="Cancel replace" @onclick="() => CancelReplace(index)">✕</button>
                        }
                        else
                        {
                            <span class="secret-value-masked">••••••••</span>
                            <button type="button" class="btn-icon" title="Replace" @onclick="() => StartReplace(index)">Replace</button>
                        }
                        <button type="button" class="btn-icon btn-icon-danger" title="Remove" @onclick="() => RemoveSecret(index)">🗑</button>
                    </div>
                    @if (!string.IsNullOrEmpty(secret.ValidationError))
                    {
                        <div class="secret-validation-error">@secret.ValidationError</div>
                    }
                }
                <button type="button" class="btn-add-inline" @onclick="AddSecret">+ Add Secret</button>
            }
            else
            {
                @for (var i = 0; i < _secrets.Count; i++)
                {
                    var index = i;
                    var secret = _secrets[index];
                    var isRevealed = _revealedSecrets.Contains(index);
                    <div class="secret-row">
                        <input type="text"
                               class="secret-key-input"
                               value="@secret.Key"
                               @onchange="e => UpdateSecretKey(index, e.Value?.ToString() ?? string.Empty)"
                               placeholder="ENV_VAR_NAME" />
                        <input type="@(isRevealed ? "text" : "password")"
                               class="secret-value-input"
                               value="@secret.Value"
                               @onchange="e => UpdateSecretValue(index, e.Value?.ToString() ?? string.Empty)"
                               placeholder="secret value" />
                        <button type="button" class="btn-icon" title="@(isRevealed ? "Hide" : "Reveal")" @onclick="() => ToggleSecretVisibility(index)">@(isRevealed ? "🙈" : "👁")</button>
                        <button type="button" class="btn-icon btn-icon-danger" title="Remove" @onclick="() => RemoveSecret(index)">🗑</button>
                    </div>
                    @if (!string.IsNullOrEmpty(secret.ValidationError))
                    {
                        <div class="secret-validation-error">@secret.ValidationError</div>
                    }
                }
                <button type="button" class="btn-add-inline" @onclick="AddSecret">+ Add Secret</button>
            }
        </ChildContent>
    </Collapsible>

    <Collapsible CssClass="setup-steps-section" HeaderClass="setup-steps-section-header" BodyClass="setup-steps-section-body"
                 IsExpanded="_setupStepsExpanded" IsExpandedChanged="v => _setupStepsExpanded = v">
        <Header><Icon Name="settings" /> Setup Steps (@_setupSteps.Count)</Header>
        <ChildContent>
            <span class="form-hint">Each step runs as a full shell command via <code>/bin/bash -c</code> after clone. The name is a label for logs only.</span>
            @for (var i = 0; i < _setupSteps.Count; i++)
            {
                var index = i;
                var step = _setupSteps[index];
                <div class="setup-step-row">
                    <div class="setup-step-header">
                        <span class="setup-step-number">@(index + 1).</span>
                        <input type="text"
                               class="setup-step-name-input"
                               value="@step.Name"
                               @onchange="e => UpdateSetupStepName(index, e.Value?.ToString() ?? string.Empty)"
                               placeholder="Label (e.g. Restore dependencies)" />
                        <div class="setup-step-actions">
                            <button type="button" class="btn-icon" title="Move up" disabled="@(index == 0)" @onclick="() => MoveSetupStepUp(index)">↑</button>
                            <button type="button" class="btn-icon" title="Move down" disabled="@(index == _setupSteps.Count - 1)" @onclick="() => MoveSetupStepDown(index)">↓</button>
                            <button type="button" class="btn-icon btn-icon-danger" title="Remove" @onclick="() => RemoveSetupStep(index)">🗑</button>
                        </div>
                    </div>
                    <textarea class="setup-step-command-input"
                              rows="2"
                              @onchange="e => UpdateSetupStepCommand(index, e.Value?.ToString() ?? string.Empty)"
                              placeholder="Full shell command (e.g. dotnet restore, npm install)">@step.Command</textarea>
                    @if (!string.IsNullOrEmpty(step.ValidationError))
                    {
                        <div class="setup-step-validation-error">@step.ValidationError</div>
                    }
                </div>
            }
            <button type="button" class="btn-add-inline" @onclick="AddSetupStep">+ Add Step</button>
        </ChildContent>
    </Collapsible>

    <div class="form-group">
        <label>Steering Instructions</label>
        <p class="form-hint">@SteeringHint</p>
        <textarea @bind="SteeringContentBinding" rows="15" placeholder="@SteeringPlaceholder"></textarea>
    </div>
</div>

@code {
    private const string DefaultSteeringHint =
        "These instructions are provided to agents working on this repository. Use them for repo-specific conventions like architecture constraints, build/test commands, or file organization rules.";

    private const string SteeringPlaceholder =
        "## Architecture\n- This is a Spring Boot application using Gradle\n- All REST endpoints require OpenAPI annotations\n" +
        "- Database migrations live in src/main/resources/db/migration/\n\n" +
        "## Build Commands\n- Build: ./gradlew build\n- Test: ./gradlew test\n- Lint: ./gradlew spotlessCheck";

    private static readonly Regex SecretKeyPattern = new(@"^[A-Za-z_][A-Za-z0-9_]*$", RegexOptions.Compiled, matchTimeout: TimeSpan.FromSeconds(1));

    [Parameter, EditorRequired] public TemplateFormModel Form { get; set; } = default!;

    /// <summary>
    /// When true, the Required Agent Labels input is suppressed. Use this when the page has a
    /// dedicated labels field in another card (e.g. the Binding card on RepositoryPage) to prevent
    /// two divergent editors for the same field.
    /// </summary>
    [Parameter] public bool HideLabels { get; set; }

    /// <summary>
    /// When true, stored secret values are never rendered. Each secret shows its key name with a
    /// "Replace" action that reveals an empty input for a new value. Blank replacement = keep existing.
    /// </summary>
    [Parameter] public bool SecretsWriteOnly { get; set; }

    /// <summary>Override the steering hint text shown above the textarea.</summary>
    [Parameter] public string? SteeringHintOverride { get; set; }

    private string SteeringHint => SteeringHintOverride ?? DefaultSteeringHint;

    private bool _initialized;
    private string _labelsText = "";
    private string _blacklistedPathsText = "";
    private string? _steeringContent;
    private List<SecretEntry> _secrets = new();
    private List<SetupStepEntry> _setupSteps = new();
    private readonly HashSet<int> _revealedSecrets = new();
    private readonly HashSet<int> _replacingSecrets = new();
    private bool _secretsExpanded;
    private bool _setupStepsExpanded;

    protected override void OnParametersSet()
    {
        // Initialize-once: only populate local state from Form on the first render.
        // Subsequent parent re-renders (e.g. from a sibling card save) must not overwrite
        // in-progress edits or clear Replace inputs.
        if (_initialized) return;
        _initialized = true;

        if (!HideLabels)
            _labelsText = Form.RequiredLabels is { Count: > 0 } ? string.Join(", ", Form.RequiredLabels) : "";
        _blacklistedPathsText = Form.BlacklistedPaths is { Count: > 0 } ? string.Join(", ", Form.BlacklistedPaths) : "";
        _steeringContent = Form.SteeringContent;
        if (SecretsWriteOnly)
        {
            // In write-only mode, populate key names only; never populate values from Form.
            _secrets = Form.Secrets?.Select(kv => new SecretEntry { Key = kv.Key, Value = "" }).ToList() ?? new();
        }
        else
        {
            _secrets = Form.Secrets?.Select(kv => new SecretEntry { Key = kv.Key, Value = kv.Value }).ToList() ?? new();
        }
        _setupSteps = Form.SetupSteps?.Select(s => new SetupStepEntry { Name = s.Name, Command = s.Command }).ToList() ?? new();
    }

    // ── Labels ─────────────────────────────────────────────────────────────

    private void OnLabelsChanged(ChangeEventArgs e)
    {
        _labelsText = e.Value?.ToString() ?? "";
        var labels = _labelsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        Form.RequiredLabels = labels.Length > 0 ? labels : null;
    }

    // ── Blacklisted Paths ──────────────────────────────────────────────────

    private void OnBlacklistedPathsChanged(ChangeEventArgs e)
    {
        _blacklistedPathsText = e.Value?.ToString() ?? "";
        var paths = _blacklistedPathsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        Form.BlacklistedPaths = paths.Length > 0 ? paths : null;
    }

    // ── Secrets ────────────────────────────────────────────────────────────

    private void AddSecret()
    {
        _secrets.Add(new SecretEntry());
        UpdateFormSecrets();
    }

    private void RemoveSecret(int index)
    {
        _secrets.RemoveAt(index);
        _revealedSecrets.Remove(index);
        _replacingSecrets.Remove(index);
        UpdateFormSecrets();
    }

    private void UpdateSecretKey(int index, string key)
    {
        _secrets[index] = _secrets[index] with { Key = key, ValidationError = ValidateSecretKey(key) };
        UpdateFormSecrets();
    }

    private void UpdateSecretValue(int index, string value)
    {
        _secrets[index] = _secrets[index] with { Value = value };
        UpdateFormSecrets();
    }

    private void ToggleSecretVisibility(int index)
    {
        if (!_revealedSecrets.Remove(index))
            _revealedSecrets.Add(index);
    }

    // ── Write-only secret replace helpers ─────────────────────────────────

    private void StartReplace(int index)
    {
        _replacingSecrets.Add(index);
        // Reset value to empty so the user types a new one; blank on save = keep existing.
        _secrets[index] = _secrets[index] with { Value = "" };
        UpdateFormSecrets();
    }

    private void CancelReplace(int index)
    {
        _replacingSecrets.Remove(index);
        // NOTE: CancelReplace does not restore Form.Secrets to its pre-replace state.
        // Scenario: (1) user clicks Replace, (2) types a new value — UpdateFormSecrets writes it into
        // Form.Secrets, (3) user clicks Cancel. After clearing Value to "" and calling UpdateFormSecrets
        // the write-only merge does not overwrite the already-stored new value, so the "cancelled" value
        // survives into the next Save. Fix: either track the original value per-index and restore it, or
        // defer all Form.Secrets writes to the Cancel/Confirm step rather than the @onchange handler.
        // (Correctness review finding, issue #3576)
        // Clear the in-progress value; the key name is preserved in _secrets.
        _secrets[index] = _secrets[index] with { Value = "" };
        UpdateFormSecrets();
    }

    private static string? ValidateSecretKey(string key) =>
        !string.IsNullOrEmpty(key) && !SecretKeyPattern.IsMatch(key)
            ? "Key must start with a letter or underscore and contain only letters, digits and underscores."
            : null;

    private void UpdateFormSecrets()
    {
        if (SecretsWriteOnly)
        {
            // In write-only mode: only include entries where the user has typed a new value.
            // An empty value means "keep existing" — do not overwrite the stored secret.
            var replacements = _secrets
                .Where(s => !string.IsNullOrEmpty(s.Key) && !string.IsNullOrEmpty(s.Value))
                .ToList();
            // Merge: start from the existing Form.Secrets (preserving unchanged keys),
            // then apply any replacements the user typed.
            var merged = Form.Secrets != null
                ? new Dictionary<string, string>(Form.Secrets)
                : new Dictionary<string, string>();
            foreach (var r in replacements)
                merged[r.Key] = r.Value;
            // Remove keys the user deleted from _secrets.
            var currentKeys = new HashSet<string>(_secrets.Select(s => s.Key).Where(k => !string.IsNullOrEmpty(k)));
            foreach (var key in merged.Keys.ToList())
            {
                if (!currentKeys.Contains(key))
                    merged.Remove(key);
            }
            Form.Secrets = merged.Count > 0 ? merged : null;
        }
        else
        {
            var valid = _secrets.Where(s => !string.IsNullOrEmpty(s.Key)).ToList();
            Form.Secrets = valid.Count > 0
                ? valid.ToDictionary(s => s.Key, s => s.Value)
                : null;
        }
    }

    // ── Setup Steps ────────────────────────────────────────────────────────

    private void AddSetupStep()
    {
        _setupSteps.Add(new SetupStepEntry());
        UpdateFormSetupSteps();
    }

    private void RemoveSetupStep(int index)
    {
        _setupSteps.RemoveAt(index);
        UpdateFormSetupSteps();
    }

    private void UpdateSetupStepName(int index, string name)
    {
        _setupSteps[index] = _setupSteps[index] with { Name = name };
        UpdateFormSetupSteps();
    }

    private void UpdateSetupStepCommand(int index, string command)
    {
        _setupSteps[index] = _setupSteps[index] with { Command = command };
        UpdateFormSetupSteps();
    }

    private void MoveSetupStepUp(int index)
    {
        if (index <= 0) return;
        (_setupSteps[index - 1], _setupSteps[index]) = (_setupSteps[index], _setupSteps[index - 1]);
        UpdateFormSetupSteps();
    }

    private void MoveSetupStepDown(int index)
    {
        if (index >= _setupSteps.Count - 1) return;
        (_setupSteps[index], _setupSteps[index + 1]) = (_setupSteps[index + 1], _setupSteps[index]);
        UpdateFormSetupSteps();
    }

    private void UpdateFormSetupSteps()
    {
        Form.SetupSteps = _setupSteps.Count > 0
            ? _setupSteps.Select(s => new SetupStep { Name = s.Name, Command = s.Command }).ToList()
            : null;
    }

    // ── Steering ───────────────────────────────────────────────────────────

    private string? SteeringContentBinding
    {
        get => _steeringContent;
        set
        {
            _steeringContent = value;
            Form.SteeringContent = string.IsNullOrEmpty(value) ? null : value;
        }
    }

    // ── Internal DTOs (same pattern as RepoProviderSection) ───────────────

    private sealed record SecretEntry
    {
        public string Key { get; init; } = "";
        public string Value { get; init; } = "";
        public string? ValidationError { get; init; }
    }

    private sealed record SetupStepEntry
    {
        public string Name { get; init; } = "";
        public string Command { get; init; } = "";
        public string? ValidationError { get; init; }
    }
}
