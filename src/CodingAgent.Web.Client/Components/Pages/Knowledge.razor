@page "/knowledge"
@attribute [Authorize(Policy = AccessPolicies.AnyAccess)]
@layout CockpitLayout
@implements IDisposable
@using CodingAgent.Pipeline.Models
@using CodingAgent.Pipeline.Services
@using CodingAgent.Web.Services
@using CodingAgent.Web.Components.Shared
@inject IUiRunClient RunHistory
@inject CockpitState State
@inject CurrentAccess Access

@*
    Knowledge — brain skills and inbox metrics across the fetched run window.
    Uses per-run fields: BrainSkillsBytes, BrainInboxFile, BrainPushFailed, BrainUpdatesPushed.
    For global readers: fetches the last brain consolidation run per brain provider and shows the
    review summary card.
*@

<PageTitle>Knowledge - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Knowledge</h1>
            <span class="cockpit-page-sub">Brain skills and inbox across recent runs</span>
        </div>
    </div>

    @if (_loading)
    {
        <div class="cockpit-card"><div class="cockpit-empty">Loading…</div></div>
    }
    else if (_error is not null)
    {
        <div class="cockpit-card"><div class="cockpit-empty">@_error</div></div>
    }
    else if (_total == 0)
    {
        <div class="cockpit-card"><div class="cockpit-empty">No runs in the recent window yet.</div></div>
    }
    else
    {
        <div class="cockpit-stat-strip">
            <div class="cockpit-stat"><span class="cockpit-stat-l">Runs · recent</span><span class="cockpit-stat-v">@_total</span></div>
            <div class="cockpit-stat"><span class="cockpit-stat-l">Skills injected</span><span class="cockpit-stat-v">@_skillsInjected</span></div>
            <div class="cockpit-stat"><span class="cockpit-stat-l">Avg skills size</span><span class="cockpit-stat-v">@_avgSkillsKb.ToString("0.0") KB</span></div>
            <div class="cockpit-stat"><span class="cockpit-stat-l">Inbox pushed</span><span class="cockpit-stat-v">@_inboxPushed</span></div>
            <div class="cockpit-stat"><span class="cockpit-stat-l">Inbox push failures</span><span class="cockpit-stat-v">@_inboxFailed</span></div>
        </div>

        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Does the brain help?</h2><span style="font-size: 12px; color: var(--text-muted);">completed-rate over the recent window</span></div>
            <div class="cockpit-card-pad">
                @if (_withSkillsRuns == 0 || _withoutSkillsRuns == 0)
                {
                    <div style="font-size: 12.5px; color: var(--text-muted);">Needs runs both with and without skills in this window to compare (@_withSkillsRuns with · @_withoutSkillsRuns without).</div>
                }
                else
                {
                    <div style="display: grid; grid-template-columns: 140px 1fr 120px; gap: 10px 14px; align-items: center;">
                        <span style="font-size: 13px; font-weight: 600;">With skills</span>
                        <div style="height: 10px; border-radius: 5px; background: var(--surface-alt); overflow: hidden;"><div style="height: 100%; width: @_withSkillsSuccess%; background: var(--success);"></div></div>
                        <span style="font-size: 12.5px; color: var(--text-muted); text-align: right;">@_withSkillsSuccess% · @_withSkillsRuns runs</span>

                        <span style="font-size: 13px; font-weight: 600;">Without skills</span>
                        <div style="height: 10px; border-radius: 5px; background: var(--surface-alt); overflow: hidden;"><div style="height: 100%; width: @_withoutSkillsSuccess%; background: var(--text-faint);"></div></div>
                        <span style="font-size: 12.5px; color: var(--text-muted); text-align: right;">@_withoutSkillsSuccess% · @_withoutSkillsRuns runs</span>
                    </div>
                    <div style="margin-top: 12px; font-size: 12.5px;">
                        @{ var _lift = _withSkillsSuccess - _withoutSkillsSuccess; }
                        <span style="font-weight: 700; color: @(_lift >= 0 ? "var(--success)" : "var(--error)");">@(_lift >= 0 ? "+" : "")@_lift pts</span>
                        <span style="color: var(--text-muted);"> completed-rate on runs that got brain skills — a correlation over a small recent window, not a causal measure.</span>
                    </div>
                }
            </div>
        </div>

        @if (Access.HasGlobalRead && _lastReviews is { Count: > 0 })
        {
            @foreach (var _review in _lastReviews)
            {
                @if (_review.BrainConsolidationOutcome is { } _brain)
                {
                    <div class="cockpit-card cockpit-card-pad" data-testid="last-brain-review">
                        <div class="cockpit-card-header" style="margin-bottom:8px;"><h2>Last brain review</h2></div>
                        <div style="font-size:13.5px; margin-bottom:6px;">
                            @_review.StartedAtOffset.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                            · @_brain.Promoted promoted · @_brain.Appended appended · @_brain.Retired retired · @_brain.MissedAgain missed again
                        </div>
                        @if (_brain.Checks.Count > 0)
                        {
                            <div style="margin-top:8px; font-size:13px;">
                                @foreach (var _check in _brain.Checks)
                                {
                                    <div style="margin-top:3px;">@_check.Cause — <span class="monitoring-muted">@_check.SuggestedHome</span></div>
                                }
                            </div>
                        }
                        @if (_brain.FlakyTests.Count > 0)
                        {
                            <div style="margin-top:8px; font-size:13px;">
                                @foreach (var _ft in _brain.FlakyTests)
                                {
                                    <div style="margin-top:2px;">@_ft.Name (@_ft.Count)</div>
                                }
                            </div>
                        }
                        <div style="margin-top:10px;">
                            <a href="/runs/@_review.RunId" class="cockpit-link-chip">Open run →</a>
                        </div>
                    </div>
                }
            }
        }

        <div class="cockpit-card cockpit-card-pad" style="display: flex; gap: 12px; align-items: flex-start; font-size: 12.5px; color: var(--text-muted); line-height: 1.55;">
            <span style="flex-shrink: 0; color: var(--accent);"><Icon Name="info" Size="15" /></span>
            <span>
                <a href="/consolidation">Consolidation</a> runs the brain review, which promotes recurring causes into skills.
            </span>
        </div>
    }
</div>

@code {
    private readonly CancellationTokenSource _cts = new();
    private bool _loading = true;
    private string? _error;

    private int _total, _skillsInjected, _inboxPushed, _inboxFailed;
    private double _avgSkillsKb;
    private int _withSkillsRuns, _withoutSkillsRuns, _withSkillsSuccess, _withoutSkillsSuccess;
    private List<PipelineRunSummary>? _lastReviews;

    protected override void OnInitialized() => State.OnProjectChanged += HandleProjectChanged;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async void HandleProjectChanged()
    {
        try { await LoadAsync(); await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { /* Already disposed. */ }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _total = _skillsInjected = _inboxPushed = _inboxFailed = 0;
        _avgSkillsKb = 0;
        _withSkillsRuns = _withoutSkillsRuns = _withSkillsSuccess = _withoutSkillsSuccess = 0;
        _lastReviews = null;
        try
        {
            var runs = await RunHistory.GetRunHistoryAsync(
                new RunHistoryQuery(Page: 1, PageSize: 100, FeedbackOnly: false, IncludeActive: false, ProjectId: State.SelectedProjectId),
                _cts.Token);

            // Exclude consolidation runs from the tiles and comparison (spec 054 8B.2).
            var items = runs.Items.Where(r => r.RunType != PipelineRunType.Consolidation).ToList();
            _total = items.Count;
            if (_total == 0) { _loading = false; return; }

            _skillsInjected = items.Count(r => r.BrainSkillsBytes > 0);
            var skillsRuns = items.Where(r => r.BrainSkillsBytes > 0).ToList();
            _avgSkillsKb = skillsRuns.Count > 0 ? skillsRuns.Average(r => r.BrainSkillsBytes!.Value) / 1024.0 : 0.0;
            _inboxPushed = items.Count(r => r.BrainUpdatesPushed && !string.IsNullOrEmpty(r.BrainInboxFile));
            _inboxFailed = items.Count(r => r.BrainPushFailed == true);

            // "Does the brain help?": with skills = BrainSkillsBytes > 0.
            var withSkills = items.Where(r => r.BrainSkillsBytes > 0).ToList();
            var withoutSkills = items.Where(r => !(r.BrainSkillsBytes > 0)).ToList();
            _withSkillsRuns = withSkills.Count;
            _withoutSkillsRuns = withoutSkills.Count;
            _withSkillsSuccess = _withSkillsRuns > 0
                ? (int)Math.Round(100.0 * withSkills.Count(r => r.FinalStep == PipelineStep.Completed) / _withSkillsRuns)
                : 0;
            _withoutSkillsSuccess = _withoutSkillsRuns > 0
                ? (int)Math.Round(100.0 * withoutSkills.Count(r => r.FinalStep == PipelineStep.Completed) / _withoutSkillsRuns)
                : 0;

            // Last brain review card: global readers only, no project scope (would 403).
            if (Access.HasGlobalRead)
            {
                var consolidationRuns = await RunHistory.GetRunHistoryAsync(
                    new RunHistoryQuery(Page: 1, PageSize: 20, RunType: PipelineRunType.Consolidation),
                    _cts.Token);

                // Newest per BrainProviderConfigId, only brain consolidation runs.
                _lastReviews = consolidationRuns.Items
                    .Where(r => r.ConsolidationType == ConsolidationRunType.BrainConsolidation)
                    .GroupBy(r => r.BrainProviderConfigId)
                    .Select(g => g.MaxBy(r => r.StartedAtOffset)!)
                    .ToList();
            }
        }
        catch (OperationCanceledException) { /* Expected on cancellation. */ }
        catch (Exception ex)
        {
            _error = $"Failed to load knowledge metrics: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        State.OnProjectChanged -= HandleProjectChanged;
        _cts.Cancel();
        _cts.Dispose();
    }
}
