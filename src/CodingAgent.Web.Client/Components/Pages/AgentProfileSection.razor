@using CodingAgent.Pipeline
@using CodingAgent.Pipeline.Models

<section class="settings-section">
    <h2>Agent Profiles</h2>
    <p class="section-description">A profile is how an agent runs: the Helm job template it runs on (which sets the tool), the tool's settings and its MCP servers. Which profile, model and effort run each task type is set in Routing.</p>

    @if (_profiles.Count == 0)
    {
        <div class="monitoring-empty">No agent profiles configured. Create at least one profile, then set the default route in Routing.</div>
    }
    else
    {
        <div class="monitoring-table-wrap">
            <table class="monitoring-table">
                <colgroup>
                    <col style="width: 200px;" />  @* Name *@
                    <col style="width: 260px;" />  @* Job template *@
                    <col style="width: 60px;" />   @* MCP *@
                    <col style="width: 70px;" />   @* Enabled *@
                    <col style="width: 100px;" />  @* Actions *@
                </colgroup>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Job template</th>
                        <th>MCP</th>
                        <th>Enabled</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var profile in _profiles.OrderBy(p => p.DisplayName, StringComparer.OrdinalIgnoreCase))
                    {
                        var key = profile.JobTemplateKey();
                        var template = TemplateOf(key);
                        <tr data-testid="profile-row-@profile.Id">
                            <td>@profile.DisplayName</td>
                            <td>
                                <code class="monitoring-mono">@(string.IsNullOrEmpty(key) ? "—" : key)</code>
                                @if (AgentToolCatalog.Find(template?.Tool) is { } tool)
                                {
                                    <span class="sidebar-label" data-testid="profile-tool">@tool.DisplayName</span>
                                }
                                @if (_jobTemplates.Count > 0 && template is null)
                                {
                                    <span class="badge-disabled-table" data-testid="profile-missing-template" title="The Helm values define no job template with this key, so work routed to this profile is not started.">Missing job template</span>
                                }
                                else if (template is { Tool.Length: 0 })
                                {
                                    <span class="badge-disabled-table" data-testid="profile-no-tool" title="The job template has no providerType, so work routed to this profile is refused.">No tool</span>
                                }
                            </td>
                            <td>@(profile.McpServers?.Count(s => !s.Disabled) ?? 0)</td>
                            <td><StatusIcon Enabled="profile.Enabled" /></td>
                            <td>
                                <button class="btn-edit" @onclick="() => EditProfile(profile)">Edit</button>
                                <button class="btn-delete" @onclick="() => ConfirmDelete(profile)">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (_showForm)
    {
        var formTool = AgentToolCatalog.Find(TemplateOf(_form.JobTemplate)?.Tool);
        <div class="provider-form-row" style="margin-top: 12px;">
        <div class="provider-form">
            <h3>@(_editingProfile != null ? "Edit" : "Create") Agent Profile</h3>

            @if (!string.IsNullOrEmpty(_formError))
            {
                <div class="settings-status status-error">@_formError</div>
            }

            <div class="form-group">
                <label>Display Name *</label>
                <input type="text" @bind="_form.DisplayName" placeholder="e.g. Kiro .NET Agent" />
            </div>
            <div class="form-group">
                <label>Job Template * <span class="form-hint">(a Helm <code>jobTemplates[]</code> entry; its <code>providerType</code> is the tool)</span></label>
                @if (_jobTemplates.Count > 0)
                {
                    <select data-testid="profile-job-template" @bind="_form.JobTemplate">
                        <option value="">-- Select --</option>
                        @foreach (var template in _jobTemplates)
                        {
                            <option value="@template.Key">@template.Key (@(AgentToolCatalog.Find(template.Tool)?.DisplayName ?? "no tool"))</option>
                        }
                        @if (!string.IsNullOrEmpty(_form.JobTemplate) && TemplateOf(_form.JobTemplate) is null)
                        {
                            <option value="@_form.JobTemplate">@_form.JobTemplate (missing)</option>
                        }
                    </select>
                }
                else
                {
                    <input type="text" data-testid="profile-job-template" @bind="_form.JobTemplate" placeholder="e.g. dotnet,kiro" />
                }
            </div>
            @if (formTool == AgentToolCatalog.Kiro)
            {
                <div class="form-group">
                    <label>Agent Name</label>
                    <input type="text" data-testid="profile-agent-name" @bind="_form.AgentName" placeholder="Blank: the CLI's own agent" />
                </div>
            }
            else if (formTool == AgentToolCatalog.OpenCode)
            {
                <div class="form-group">
                    <label>Base URL</label>
                    <input type="text" data-testid="profile-base-url" @bind="_form.BaseUrl" placeholder="@AgentDefaults.OpenCodeBaseUrl" />
                </div>
            }
            else if (formTool == AgentToolCatalog.ClaudeCode)
            {
                <div class="form-group">
                    <label>Auth Mode</label>
                    <select data-testid="profile-auth-mode" @bind="_form.AuthMode">
                        <option value="@ClaudeCodeAuthModes.Auto">auto — API key if configured, otherwise subscription token</option>
                        <option value="@ClaudeCodeAuthModes.ApiKey">API key — billed per token</option>
                        <option value="@ClaudeCodeAuthModes.Subscription">Subscription token — Claude plan, from claude setup-token</option>
                    </select>
                    <span class="form-hint">Which credential from the agent Secret the CLI uses: <code>claude-api-key</code> or <code>claude-oauth-token</code>. Only that one reaches the CLI.</span>
                </div>
            }
            else if (!string.IsNullOrEmpty(_form.JobTemplate) && _jobTemplates.Count > 0)
            {
                <p class="form-hint" data-testid="profile-no-tool-hint">This job template has no <code>providerType</code> in the Helm values, so work routed to this profile is refused until it has one.</p>
            }
            <div class="form-group form-checkbox">
                <label>
                    <input type="checkbox" @bind="_form.Enabled" />
                    Enabled
                </label>
            </div>

            <div class="form-group">
                <label>MCP Servers</label>
                @if (_form.McpServers.Count > 0)
                {
                    <div class="monitoring-table-wrap" style="margin-bottom: 8px;">
                        <table class="monitoring-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Type</th>
                                    <th>Command / URL</th>
                                    <th>Enabled</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var (server, idx) in _form.McpServers.Select((s, i) => (s, i)))
                                {
                                    <tr>
                                        <td class="monitoring-mono">@server.Name</td>
                                        <td>@server.Type</td>
                                        <td class="monitoring-mono">@(server.Type == "http" ? server.Url : $"{server.Command} {server.Args}".Trim())</td>
                                        <td><StatusIcon Enabled="server.Enabled" /></td>
                                        <td>
                                            <button class="btn-edit" @onclick="() => EditMcpServer(idx)">Edit</button>
                                            <button class="btn-delete" @onclick="() => RemoveMcpServer(idx)">Remove</button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @if (_showMcpForm)
                {
                    <div class="provider-form" style="margin-top: 8px;">
                        <h4 style="margin-top: 0;">@(_editingMcpIndex >= 0 ? "Edit" : "Add") MCP Server</h4>
                        <div class="form-group">
                            <label>Name *</label>
                            <input type="text" @bind="_mcpForm.Name" placeholder="e.g. context7" />
                        </div>
                        <div class="form-group">
                            <label>Type</label>
                            <select @bind="_mcpForm.Type">
                                <option value="stdio">stdio (command-based)</option>
                                <option value="http">HTTP (URL-based)</option>
                            </select>
                        </div>
                        @if (_mcpForm.Type == "http")
                        {
                            <div class="form-group">
                                <label>URL *</label>
                                <input type="text" @bind="_mcpForm.Url" placeholder="e.g. https://mcp.context7.com/mcp" />
                            </div>
                            <div class="form-group">
                                <label>Headers <span class="form-hint">(one per line, KEY=VALUE — use for auth tokens)</span></label>
                                <textarea rows="3" @bind="_mcpForm.Headers" @bind:event="oninput" placeholder="@McpHeadersPlaceholder"></textarea>
                            </div>
                        }
                        else
                        {
                            <div class="form-group">
                                <label>Command *</label>
                                <input type="text" @bind="_mcpForm.Command" placeholder="e.g. uvx" />
                            </div>
                            <div class="form-group">
                                <label>Arguments <span class="form-hint">(space-separated)</span></label>
                                <input type="text" @bind="_mcpForm.Args" placeholder="e.g. context7-mcp@latest" />
                            </div>
                            <div class="form-group">
                                <label>Environment Variables <span class="form-hint">(one per line, KEY=VALUE)</span></label>
                                <textarea rows="3" @bind="_mcpForm.EnvVars" @bind:event="oninput" placeholder="FASTMCP_LOG_LEVEL=ERROR"></textarea>
                            </div>
                        }
                        <div class="form-group form-checkbox">
                            <label>
                                <input type="checkbox" @bind="_mcpForm.Enabled" />
                                Enabled
                            </label>
                        </div>
                        <div class="form-buttons">
                            <button class="btn-save" @onclick="SaveMcpServer">Save Server</button>
                            <button class="btn-cancel" @onclick="() => _showMcpForm = false">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <div style="display: flex; gap: 8px; margin-top: 4px;">
                        <button class="btn-add" @onclick="ShowAddMcpForm">+ Add MCP Server</button>
                    </div>
                }
            </div>

            <div class="form-buttons">
                <button class="btn-save" @onclick="SaveProfile">Save</button>
                <button class="btn-cancel" @onclick="CancelForm">Cancel</button>
            </div>
        </div>
        <div class="provider-help">
            @if (formTool == AgentToolCatalog.Kiro)
            {
                <h4><Icon Name="bot" /> Kiro CLI</h4>
                <p>The agent runs the Kiro CLI, bundled with the Kiro images. Run <code>kiro-cli login</code> once per credential PVC (device code flow).</p>
                <p class="help-heading">Fields:</p>
                <ul>
                    <li><strong>Agent Name</strong> — leave blank unless you have a custom agent configured</li>
                </ul>
            }
            else if (formTool == AgentToolCatalog.ClaudeCode)
            {
                <h4><Icon Name="bot" /> Claude Code</h4>
                <p>The agent runs the Claude Code CLI headless (<code>claude -p</code>), bundled with the <code>claude-*</code> images.</p>
                <p class="help-heading">Credentials (agent Secret, e.g. via external-secrets):</p>
                <ul>
                    <li><code>claude-api-key</code> — Anthropic API key from the Claude Console, billed per token</li>
                    <li><code>claude-oauth-token</code> — one-year subscription token from <code>claude setup-token</code> (Pro, Max, Team or Enterprise). Renew it before it expires; the CLI gives no warning</li>
                </ul>
                <p class="help-tip">💡 The CLI also loads the repository's own <code>CLAUDE.md</code>, <code>.claude/</code> settings, hooks and <code>.mcp.json</code>. Pipeline steering goes to <code>~/.claude/rules/</code>, outside the repository.</p>
            }
            else if (formTool == AgentToolCatalog.OpenCode)
            {
                <h4>🌐 OpenCode</h4>
                <p>The agent talks to an OpenCode server over HTTP; it runs as a sidecar in the agent container.</p>
                <p class="help-heading">Fields:</p>
                <ul>
                    <li><strong>Base URL</strong> — the OpenCode server URL (default: <code>http://127.0.0.1:4096</code>, container-internal)</li>
                </ul>
                <p class="help-heading">Configuration:</p>
                <ul>
                    <li>Set <code>OPENCODE_CONFIG_CONTENT</code> env var with provider JSON config</li>
                    <li>Or mount config to <code>~/.config/opencode/opencode.json</code></li>
                    <li>LLM API keys: <code>ANTHROPIC_API_KEY</code>, <code>OPENAI_API_KEY</code>, or <code>OPENROUTER_API_KEY</code></li>
                </ul>
            }
            else
            {
                <h4><Icon Name="bot" /> Job template</h4>
                <p>Pick the Helm job template the profile runs on. Its <code>providerType</code> decides the tool and the settings shown here.</p>
            }
            <p class="help-tip">💡 The model and effort are set per task type in Routing, not on the profile.</p>
        </div>
        </div>
    }
    else
    {
        <button class="btn-add" style="margin-top: 12px;" @onclick="ShowAddForm">+ Add Agent Profile</button>
    }

    @if (_showDeleteConfirm && _deletingProfile != null)
    {
        <div class="agent-detail-confirm" style="margin-top: 12px;">
            <p>Delete profile <strong>@_deletingProfile.DisplayName</strong>?</p>
            <div class="confirm-buttons">
                <button class="btn-delete" @onclick="DeleteProfile">Delete</button>
                <button class="btn-cancel" @onclick="() => _showDeleteConfirm = false">Cancel</button>
            </div>
        </div>
    }
</section>

@code {
    // A multi-line placeholder is a C# string: in an attribute of a rendered element, "&#10;" would show up as text.
    private const string McpHeadersPlaceholder = "Authorization=Bearer mytoken\nX-Org=myorg";

    [Parameter, EditorRequired] public IUiSettingsClient ConfigClient { get; set; } = default!; // NOSONAR S8970 — Razor compiler generates #nullable disable; ! is required here to satisfy C# nullable analysis
    [Parameter] public EventCallback<(string Message, bool IsError)> OnShowStatus { get; set; }

    private List<AgentProfile> _profiles = new();
    private IReadOnlyList<UiJobTemplate> _jobTemplates = [];
    private bool _showForm;
    private AgentProfile? _editingProfile;
    private ProfileForm _form = new();
    private string? _formError;
    private bool _showDeleteConfirm;
    private AgentProfile? _deletingProfile;

    // MCP form state
    private bool _showMcpForm;
    private int _editingMcpIndex = -1;
    private McpServerFormModel _mcpForm = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadProfiles();
    }

    private async Task LoadProfiles()
    {
        try
        {
            var page = await ConfigClient.GetAgentProfilesAsync(CancellationToken.None);
            _profiles = page.Profiles.ToList();
            _jobTemplates = page.JobTemplates;
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to load profiles: {ex.Message}", true));
        }
    }

    /// <summary>The Helm job template with this key (normalized as the API does), or null.</summary>
    private UiJobTemplate? TemplateOf(string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return null;
        var normalized = new AgentProfile { DisplayName = "", JobTemplate = key }.JobTemplateKey();
        return _jobTemplates.FirstOrDefault(t => string.Equals(t.Key, normalized, StringComparison.Ordinal));
    }

    private void ShowAddForm()
    {
        _editingProfile = null;
        _form = new ProfileForm { Enabled = true };
        _formError = null;
        _showMcpForm = false;
        _editingMcpIndex = -1;
        _showForm = true;
    }

    private void EditProfile(AgentProfile profile)
    {
        _editingProfile = profile;
        var settings = profile.Settings ?? new Dictionary<string, string>();
        _form = new ProfileForm
        {
            DisplayName = profile.DisplayName,
            JobTemplate = profile.JobTemplateKey(),
            Enabled = profile.Enabled,
            AgentName = settings.GetValueOrDefault(ProviderSettingKeys.AgentName, ""),
            BaseUrl = settings.GetValueOrDefault(ProviderSettingKeys.BaseUrl, AgentDefaults.OpenCodeBaseUrl),
            AuthMode = ClaudeCodeAuthModes.Normalize(settings.GetValueOrDefault(ProviderSettingKeys.AuthMode)),
            McpServers = profile.McpServers.Select(s => new McpServerFormModel
            {
                Name = s.Name,
                Type = s.Type ?? "stdio",
                Command = s.Command ?? "",
                Args = string.Join(" ", s.Args),
                Url = s.Url ?? "",
                EnvVars = string.Join("\n", s.Env?.Select(kv => $"{kv.Key}={kv.Value}") ?? []),
                Headers = string.Join("\n", s.Headers?.Select(kv => $"{kv.Key}={kv.Value}") ?? []),
                Enabled = !s.Disabled
            }).ToList()
        };
        _formError = null;
        _showMcpForm = false;
        _editingMcpIndex = -1;
        _showForm = true;
    }

    private void CancelForm()
    {
        _showForm = false;
        _formError = null;
    }

    private async Task SaveProfile()
    {
        _formError = ValidateProfileForm();
        if (_formError is not null) return;

        // A new record rather than the loaded one with changes: the retired labels, provider config and priority stay
        // empty, so the configuration move never takes the profile for an unconverted one.
        var profile = new AgentProfile
        {
            Id = _editingProfile?.Id ?? Guid.NewGuid().ToString(),
            DisplayName = _form.DisplayName.Trim(),
            JobTemplate = _form.JobTemplate.Trim(),
            Enabled = _form.Enabled,
            Settings = BuildSettings(AgentToolCatalog.Find(TemplateOf(_form.JobTemplate)?.Tool)),
            McpServers = _form.McpServers.Select(MapMcpServerFormToConfig).ToList()
        };

        try
        {
            await ConfigClient.SaveAgentProfileAsync(profile, CancellationToken.None);
            _showForm = false;
            await LoadProfiles();
            await OnShowStatus.InvokeAsync(("Agent profile saved.", false));
        }
        catch (Exception ex)
        {
            _formError = $"Failed to save: {ex.Message}";
        }
    }

    private string? ValidateProfileForm()
    {
        if (string.IsNullOrWhiteSpace(_form.DisplayName))
            return "Display Name is required.";
        if (string.IsNullOrWhiteSpace(_form.JobTemplate))
            return "Job Template is required.";
        return null;
    }

    /// <summary>
    /// The tool settings of <paramref name="tool"/> from the form (spec 053 req 1.1). The MCP config path is not on the
    /// form and keeps its stored value.
    /// </summary>
    private Dictionary<string, string> BuildSettings(AgentTool? tool)
    {
        var settings = new Dictionary<string, string>();
        if (tool == AgentToolCatalog.Kiro && !string.IsNullOrWhiteSpace(_form.AgentName))
            settings[ProviderSettingKeys.AgentName] = _form.AgentName.Trim();
        else if (tool == AgentToolCatalog.OpenCode)
            settings[ProviderSettingKeys.BaseUrl] = string.IsNullOrWhiteSpace(_form.BaseUrl) ? AgentDefaults.OpenCodeBaseUrl : _form.BaseUrl.Trim();
        else if (tool == AgentToolCatalog.ClaudeCode)
            settings[ProviderSettingKeys.AuthMode] = ClaudeCodeAuthModes.Normalize(_form.AuthMode);

        if (_editingProfile?.Settings?.GetValueOrDefault(ProviderSettingKeys.McpConfigPath) is { Length: > 0 } mcpConfigPath)
            settings[ProviderSettingKeys.McpConfigPath] = mcpConfigPath;
        return settings;
    }

    private McpServerConfig MapMcpServerFormToConfig(McpServerFormModel s)
    {
        string? command;
        if (s.Type == "http") command = null;
        else if (string.IsNullOrWhiteSpace(s.Command)) command = null;
        else command = s.Command.Trim();

        return new McpServerConfig
        {
            Name = s.Name.Trim(),
            Type = s.Type,
            Command = command,
            Args = string.IsNullOrWhiteSpace(s.Args) ? [] : s.Args.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList(),
            Url = s.Type == "http" ? s.Url.Trim() : null,
            Env = ParseEnvVars(s.EnvVars),
            // TODO: SSE servers also support headers (OpenCodeAgentProvider treats "http" and "sse" identically),
            // but this condition discards headers for SSE-type servers on save. A user who opens an existing
            // SSE server record with stored Headers, then saves without changes, will have those headers silently
            // cleared. Fix by extending the condition to also include "sse": s.Type is "http" or "sse".
            Headers = s.Type == "http" ? ParseEnvVars(s.Headers) : new Dictionary<string, string>(),
            Disabled = !s.Enabled,
            AutoApprove = []
        };
    }


    private void ConfirmDelete(AgentProfile profile)
    {
        _deletingProfile = profile;
        _showDeleteConfirm = true;
    }

    private async Task DeleteProfile()
    {
        if (_deletingProfile == null) return;

        var profileId = _deletingProfile.Id;
        _showDeleteConfirm = false;
        _deletingProfile = null;
        try
        {
            await ConfigClient.DeleteAgentProfileAsync(profileId, CancellationToken.None);
            await LoadProfiles();
            await OnShowStatus.InvokeAsync(("Agent profile deleted.", false));
        }
        catch (Exception ex)
        {
            // A profile that routes name is refused with the list of those routes.
            await OnShowStatus.InvokeAsync(($"Failed to delete: {ex.Message}", true));
        }
    }

    private sealed class ProfileForm
    {
        public string DisplayName { get; set; } = "";
        public string JobTemplate { get; set; } = "";
        public bool Enabled { get; set; } = true;
        public string AgentName { get; set; } = "";
        public string BaseUrl { get; set; } = AgentDefaults.OpenCodeBaseUrl;
        public string AuthMode { get; set; } = ClaudeCodeAuthModes.Auto;
        public List<McpServerFormModel> McpServers { get; set; } = new();
    }

    private sealed class McpServerFormModel
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "stdio";
        public string Command { get; set; } = "";
        public string Args { get; set; } = "";
        public string Url { get; set; } = "";
        public string EnvVars { get; set; } = "";
        public string Headers { get; set; } = "";
        public bool Enabled { get; set; } = true;
    }

    private void ShowAddMcpForm()
    {
        _editingMcpIndex = -1;
        _mcpForm = new McpServerFormModel();
        _showMcpForm = true;
    }

    private void EditMcpServer(int index)
    {
        _editingMcpIndex = index;
        var server = _form.McpServers[index];
        _mcpForm = new McpServerFormModel
        {
            Name = server.Name,
            Type = server.Type,
            Command = server.Command,
            Args = server.Args,
            Url = server.Url,
            EnvVars = server.EnvVars,
            Headers = server.Headers,
            Enabled = server.Enabled
        };
        _showMcpForm = true;
    }

    private void RemoveMcpServer(int index)
    {
        _form.McpServers.RemoveAt(index);
    }

    private void SaveMcpServer()
    {
        if (string.IsNullOrWhiteSpace(_mcpForm.Name))
            return;

        // Validate based on type
        if (_mcpForm.Type == "http" && string.IsNullOrWhiteSpace(_mcpForm.Url))
            return;
        if (_mcpForm.Type != "http" && string.IsNullOrWhiteSpace(_mcpForm.Command))
            return;

        var entry = new McpServerFormModel
        {
            Name = _mcpForm.Name.Trim(),
            Type = _mcpForm.Type,
            Command = _mcpForm.Command?.Trim() ?? "",
            Args = _mcpForm.Args?.Trim() ?? "",
            Url = _mcpForm.Url?.Trim() ?? "",
            EnvVars = _mcpForm.EnvVars?.Trim() ?? "",
            Headers = _mcpForm.Headers?.Trim() ?? "",
            Enabled = _mcpForm.Enabled
        };

        if (_editingMcpIndex >= 0)
            _form.McpServers[_editingMcpIndex] = entry;
        else
            _form.McpServers.Add(entry);

        _showMcpForm = false;
        _editingMcpIndex = -1;
    }

    private static IReadOnlyDictionary<string, string> ParseEnvVars(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return new Dictionary<string, string>();
        var dict = new Dictionary<string, string>();
        foreach (var line in input.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eqIdx = line.IndexOf('=');
            if (eqIdx > 0)
                dict[line[..eqIdx].Trim()] = line[(eqIdx + 1)..].Trim();
        }
        return dict;
    }
}
