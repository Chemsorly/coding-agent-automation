    // ── Refactoring modal ──

    private async Task OpenRefactoringModal(string templateId, string templateName)
    {
        _modalTemplateId = templateId;
        _modalTemplateName = templateName;
        _modalAutoDispatch = false;
        _modalFocus = RefactoringScanFocus.All;
        _showRefactoringModal = true;
        _modalJustOpened = true;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ConfirmRefactoringModal()
    {
        _showRefactoringModal = false;
        if (_modalTemplateId is not null)
        {
            var error = await PageService.TriggerRefactoringScanAsync(_modalTemplateId, _modalAutoDispatch, _modalFocus);
            if (error is not null)
            {
                _errorMessage = error;
            }
        }
    }

    private void DismissRefactoringModal() => _showRefactoringModal = false;

    private async Task HandleRefactoringModalKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") DismissRefactoringModal();
        else if (e.Key == "Enter") await ConfirmRefactoringModal();
    }

    // ── Helpers ──

    private static string GetProviderDisplay(string? providerId, params IEnumerable<ProviderConfig>[] providerLists)
    {
        if (string.IsNullOrEmpty(providerId)) return "—";
        foreach (var list in providerLists)
        {
            var p = list.FirstOrDefault(x => x.Id == providerId);
            if (p is not null) return p.DisplayName;
        }
        return UiFormatters.Truncate(providerId, 12);
    }

    public void Dispose() { /* Drawers are scoped and disposed by DI */ }
