@page "/pipelines/{TemplateId}"
@attribute [Authorize(Policy = AccessPolicies.AnyAccess)]
@layout CockpitLayout
@implements IDisposable
@using CodingAgent.Pipeline.Models
@using CodingAgent.Pipeline
@using CodingAgent.Web.Services
@inject RepositoryPageService PageService
@inject CurrentAccess Access

<PageTitle>@(_template?.Name ?? "Repository") - Coding Agent</PageTitle>

@if (_isLoading)
{
    <div class="cockpit-page">
        <div class="monitoring-empty">Loading…</div>
    </div>
}
else if (!string.IsNullOrEmpty(_loadError))
{
    <div class="cockpit-page">
        <div class="settings-status status-error">@_loadError</div>
    </div>
}
else if (!PageService.CanView())
{
    <div class="cockpit-page">
        <div class="monitoring-empty">Template not found.</div>
    </div>
}
else
{
    var template = PageService.Template!;
    var project = PageService.Project;
    var repoProvider = PageService.RepoProviders.FirstOrDefault(p => p.Id == template.RepoProviderId)
                       ?? PageService.BrainProviders.FirstOrDefault(p => p.Id == template.RepoProviderId);
    var repoWebUrl = repoProvider is not null ? RepositoryPageService.GetRepositoryWebUrl(repoProvider) : null;

    <div class="cockpit-page">

        @* ═══ Toast stack ═══ *@
        <div class="agent-toast-stack">
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <div class="settings-status settings-status-toast status-error">
                    <span class="toast-message">@_errorMessage</span>
                    <button class="agent-summary-dismiss" @onclick="DismissError" title="Dismiss">✕</button>
                </div>
            }
        </div>

        @* ═══ Header ═══ *@
        <div class="cockpit-page-header">
            <div class="cockpit-page-titles">
                <div class="cockpit-breadcrumb">
                    <a href="/pipelines">Pipelines</a>
                    @if (project is not null)
                    {
                        <span class="cockpit-breadcrumb-sep">›</span>
                        <span>@project.Name</span>
                    }
                    <span class="cockpit-breadcrumb-sep">›</span>
                    <span>@template.Name</span>
                </div>
                <h1>@template.Name</h1>
                <div class="cockpit-page-chips">
                    <span class="feature-badge @(template.Enabled ? "feature-on" : "feature-off")">
                        @(template.Enabled ? "Enabled" : "Disabled")
                    </span>
                    @if (project is not null)
                    {
                        <span class="badge-project">@project.Name</span>
                    }
                </div>
            </div>
            <div class="cockpit-page-actions">
                @if (repoWebUrl is not null)
                {
                    <a href="@repoWebUrl" target="_blank" rel="noopener noreferrer" class="btn-cancel">
                        Open repository ↗
                    </a>
                }
                @if (Access.HasGlobalOperate && template.RepoProviderId is not null)
                {
                    <button class="btn-save" @onclick="() => OpenRefactoringModal(template.Id, template.Name)"
                            title="Trigger refactoring scan for this repository">
                        <Icon Name="search" Size="14" /> Scan for refactorings
                    </button>
                }
                <button class="btn-save" @onclick="OpenIssueDrawer"
                        disabled="@(!PageService.CanDispatch())"
                        title="@(!PageService.CanDispatch() ? "Operator access required to dispatch" : null)"
                        data-testid="browse-issues-btn">
                    Browse issues
                </button>
                @if (template.ReviewEnabled)
                {
                    <button class="btn-save" @onclick="OpenPrDrawer"
                            disabled="@(!PageService.CanDispatch())"
                            title="@(!PageService.CanDispatch() ? "Operator access required to dispatch" : null)"
                            data-testid="browse-prs-btn">
                        Browse pull requests
                    </button>
                }
                @if (template.DecompositionEnabled)
                {
                    <button class="btn-save" @onclick="OpenEpicDrawer"
                            disabled="@(!PageService.CanDispatch())"
                            title="@(!PageService.CanDispatch() ? "Operator access required to dispatch" : null)"
                            data-testid="browse-epics-btn">
                        Browse epics
                    </button>
                }
            </div>
        </div>

        <div class="agent-content-layout">
            <div class="agent-main">

                @* ═══ Binding card ═══ *@
                <section class="settings-section" data-testid="binding-card">
                    <div class="cockpit-card-header">
                        <h2><Icon Name="link" Size="16" /> Binding</h2>
                        @if (!Access.IsAdmin)
                        {
                            <span class="monitoring-muted" style="font-size:0.8rem;">Managed by the operator</span>
                        }
                    </div>

                    @if (!string.IsNullOrEmpty(_bindingError))
                    {
                        <div class="settings-status status-error">@_bindingError</div>
                    }
                    @if (!string.IsNullOrEmpty(_bindingSuccess))
                    {
                        <div class="settings-status status-success">@_bindingSuccess</div>
                    }

                    <div class="form-group">
                        <label>Repository</label>
                        <div class="settings-readonly-row">
                            <span class="monitoring-mono">@(GetProviderDisplay(template.RepoProviderId, PageService.RepoProviders, PageService.BrainProviders))</span>
                            @if (Access.IsAdmin)
                            {
                                <a href="@($"/settings?section={SettingsNodes.ProvidersRepository}")" class="btn-cancel" style="font-size:0.75rem; padding: 2px 8px;">Connection ›</a>
                            }
                        </div>
                    </div>

                    <div class="form-group">
                        <label>Issue Tracker</label>
                        <div class="settings-readonly-row">
                            <span class="monitoring-mono">@(GetProviderDisplay(template.IssueProviderId, PageService.IssueProviders))</span>
                            @if (Access.IsAdmin)
                            {
                                <a href="@($"/settings?section={SettingsNodes.ProvidersIssue}")" class="btn-cancel" style="font-size:0.75rem; padding: 2px 8px;">Connection ›</a>
                            }
                        </div>
                    </div>

                    @if (Access.IsAdmin)
                    {
                        <div class="form-group">
                            <label>Brain Provider (optional)</label>
                            <div class="settings-readonly-row">
                                <select @bind="_bindingForm.BrainProviderId">
                                    <option value="">— None —</option>
                                    @foreach (var p in PageService.BrainProviders)
                                    {
                                        <option value="@p.Id">@p.DisplayName</option>
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(_bindingForm.BrainProviderId))
                                {
                                    <a href="@($"/settings?section={SettingsNodes.ProvidersRepository}")" class="btn-cancel" style="font-size:0.75rem; padding: 2px 8px;">Connection ›</a>
                                }
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(_bindingForm.BrainProviderId))
                        {
                            <div class="form-group form-checkbox">
                                <label>
                                    <input type="checkbox" @bind="_bindingForm.BrainReadOnly" />
                                    Brain Repository Read-Only
                                    <span class="form-hint-icon" aria-hidden="true" title="When enabled, the brain repo is cloned and read by the agent but no changes are written back.">?</span>
                                </label>
                            </div>
                        }
                        <div class="form-group">
                            <label>Pipeline/CI Provider (optional)</label>
                            <div class="settings-readonly-row">
                                <select @bind="_bindingForm.PipelineProviderId">
                                    <option value="">— None —</option>
                                    @foreach (var p in PageService.PipelineProviders)
                                    {
                                        <option value="@p.Id">@p.DisplayName</option>
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(_bindingForm.PipelineProviderId))
                                {
                                    <a href="@($"/settings?section={SettingsNodes.ProvidersPipeline}")" class="btn-cancel" style="font-size:0.75rem; padding: 2px 8px;">Connection ›</a>
                                }
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Stack labels <span class="form-hint">(comma-separated · pick quality gates and reviewers, for example dotnet, dotnet10)</span></label>
                            <input type="text" data-testid="binding-stack-labels" value="@_bindingLabelsText" @onchange="OnBindingLabelsChanged"
                                   placeholder="e.g. dotnet, dotnet10" />
                            @if (_bindingForm.RequiredLabels is not { Count: > 0 })
                            {
                                <span class="form-hint" data-testid="binding-no-labels-note">@NoStackLabelsNote</span>
                            }
                        </div>
                        @if (_labelPreview is { Labels.Count: > 0 })
                        {
                            <LabelPreviewInline Preview="_labelPreview" />
                        }
                        <div class="form-group form-checkbox">
                            <label>
                                <input type="checkbox" @bind="_bindingForm.Enabled" aria-label="@($"Enable {template.Name}")" />
                                Enabled
                            </label>
                        </div>
                        <div class="form-buttons">
                            <button class="btn-save" @onclick="SaveBinding" disabled="@_bindingSaving">Save</button>
                            <span class="monitoring-muted" style="font-size:0.8rem;">Changes apply from the next poll cycle.</span>
                        </div>

                        <div class="config-sub-fields" style="margin-top: 1rem;" data-testid="binding-routing">
                            <h3>Agent routing</h3>
                            <p class="form-hint">Which agent profile runs each task type of this repository, with which model and effort. A task type without its own row inherits the global routing. Changes apply to work created after saving.</p>
                            @if (PageService.RoutingPage is { } routing)
                            {
                                <RouteTable Rows="_routeRows" Profiles="routing.Profiles" Inherited="routing.Routing" />
                                @if (!string.IsNullOrEmpty(_routesError))
                                {
                                    <div class="settings-status status-error" data-testid="binding-routing-error" style="white-space: pre-line;">@_routesError</div>
                                }
                                @if (!string.IsNullOrEmpty(_routesSuccess))
                                {
                                    <div class="settings-status status-success">@_routesSuccess</div>
                                }
                                <div class="form-buttons">
                                    <button class="btn-save" data-testid="binding-routing-save" @onclick="SaveRoutes" disabled="@_routesSaving">Save routing</button>
                                </div>
                            }
                            else
                            {
                                <div class="settings-status status-error">@PageService.RoutingLoadError</div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Read-only view for non-admins *@
                        <div class="form-group">
                            <label>Brain Provider</label>
                            <span class="monitoring-mono">@(string.IsNullOrEmpty(template.BrainProviderId) ? "—" : GetProviderDisplay(template.BrainProviderId, PageService.BrainProviders))</span>
                        </div>
                        @if (template.BrainReadOnly)
                        {
                            <div class="form-group">
                                <label>Brain Read-Only</label>
                                <span class="feature-badge feature-on">Yes</span>
                            </div>
                        }
                        <div class="form-group">
                            <label>Pipeline/CI Provider</label>
                            <span class="monitoring-mono">@(string.IsNullOrEmpty(template.PipelineProviderId) ? "—" : GetProviderDisplay(template.PipelineProviderId, PageService.PipelineProviders))</span>
                        </div>
                        <div class="form-group">
                            <label>Stack labels</label>
                            <span data-testid="binding-stack-labels">@(template.RequiredLabels is { Count: > 0 } ? string.Join(", ", template.RequiredLabels) : "(none)")</span>
                            @if (template.RequiredLabels is not { Count: > 0 })
                            {
                                <span class="form-hint" data-testid="binding-no-labels-note">@NoStackLabelsNote</span>
                            }
                        </div>
                        <div class="form-group">
                            <label>Status</label>
                            <span class="feature-badge @(template.Enabled ? "feature-on" : "feature-off")">@(template.Enabled ? "Enabled" : "Disabled")</span>
                        </div>
                        <div class="form-group" data-testid="binding-routes">
                            <label>Agent routing</label>
                            <div class="monitoring-table-wrap">
                                <table class="monitoring-table">
                                    <thead>
                                        <tr><th>Task type</th><th>Route</th><th>Source</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var route in PageService.Routes)
                                        {
                                            <tr data-testid="binding-route-@route.TaskType.ToString().ToLowerInvariant()">
                                                <td>@AgentRouteLabels.TaskType(route.TaskType)</td>
                                                <td>
                                                    @RouteText.Describe(route)
                                                    @if (route.ProfileName is not null && route.Problem is not null)
                                                    {
                                                        <span class="badge-disabled-table" title="@route.Problem"><Icon Name="alert-triangle" Size="12" /></span>
                                                    }
                                                </td>
                                                <td>@RouteText.Source(route)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                </section>

                @* ═══ Behaviour card ═══ *@
                <section class="settings-section" data-testid="behaviour-card">
                    <div class="cockpit-card-header">
                        <h2><Icon Name="settings" Size="16" /> Behaviour</h2>
                    </div>
                    <p class="form-hint">These run in the agent pod next to the agent's credentials, like the repository's own hooks.</p>

                    @if (!string.IsNullOrEmpty(_behaviourError))
                    {
                        <div class="settings-status status-error">@_behaviourError</div>
                    }
                    @if (!string.IsNullOrEmpty(_behaviourSuccess))
                    {
                        <div class="settings-status status-success">@_behaviourSuccess</div>
                    }

                    @if (Access.IsAdmin)
                    {
                        <div class="form-group">
                            <label>Name *</label>
                            <input type="text" @bind="_behaviourForm.Name" placeholder="e.g. DotNet Main Repo" />
                        </div>

                        <div class="form-group">
                            <label>Workflow Switches</label>
                            <div class="feature-config-toggles">
                                <label class="feature-config-toggle">
                                    <label class="toggle-switch">
                                        <input type="checkbox" @bind="_behaviourForm.ImplementationEnabled"
                                               aria-label="@($"Enable Implementation for {template.Name}")" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span title="Dispatches implementation jobs from issues">Implementation</span>
                                </label>
                                <label class="feature-config-toggle">
                                    <label class="toggle-switch">
                                        <input type="checkbox" @bind="_behaviourForm.ReviewEnabled"
                                               aria-label="@($"Enable PR Review for {template.Name}")" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span title="Dispatches PR review jobs">PR Review</span>
                                </label>
                                <label class="feature-config-toggle">
                                    <label class="toggle-switch">
                                        <input type="checkbox" @bind="_behaviourForm.DecompositionEnabled"
                                               aria-label="@($"Enable Decomposition for {template.Name}")" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span title="Dispatches epic decomposition jobs">Decomposition</span>
                                </label>
                                <label class="feature-config-toggle">
                                    <label class="toggle-switch">
                                        <input type="checkbox" @bind="_behaviourForm.HousekeepingEnabled"
                                               aria-label="@($"Enable Housekeeping for {template.Name}")" />
                                        <span class="toggle-slider"></span>
                                    </label>
                                    <span title="Automatically keeps agent-created PR branches up-to-date with the base branch">Housekeeping</span>
                                </label>
                            </div>
                        </div>

                        @if (_behaviourForm.HousekeepingEnabled)
                        {
                            <div class="form-group" data-testid="housekeeping-limit">
                                <div class="label-with-hint">
                                    <label>Housekeeping Concurrency Limit</label>
                                    <span class="form-hint-icon" aria-hidden="true" title="Max PRs in 'update triggered' state per repository at once. Leave blank to inherit global setting.">?</span>
                                </div>
                                <input type="number" @bind="_behaviourForm.HousekeepingConcurrencyLimit"
                                       min="@SettingLimits.Min(nameof(PipelineConfiguration.HousekeepingConcurrencyLimit))"
                                       max="@SettingLimits.Max(nameof(PipelineConfiguration.HousekeepingConcurrencyLimit))"
                                       placeholder="Inherited from global" />
                                <span class="form-hint">Leave blank to inherit the global setting.</span>
                            </div>
                            <div class="form-group form-checkbox" data-testid="housekeeping-cleanup">
                                <label>
                                    <input type="checkbox" @bind="_behaviourForm.HousekeepingBranchCleanupEnabled"
                                           aria-label="@($"Enable Branch Cleanup for {template.Name}")" />
                                    Branch Cleanup
                                    <span class="form-hint-icon" title="Periodically deletes stale agent branches with no open PR and an inactive issue label.">?</span>
                                </label>
                            </div>
                        }

                        <RepositorySettingsEditor Form="_behaviourSettingsForm" HideLabels="true" SecretsWriteOnly="true"
                                                  SteeringHintOverride="Written next to the project's steering for every run of this repository." />

                        <div class="form-buttons">
                            <button class="btn-save" @onclick="SaveBehaviour" disabled="@_behaviourSaving">Save</button>
                            <span class="monitoring-muted" style="font-size:0.8rem;">Changes apply from the next poll cycle.</span>
                        </div>
                    }
                    else
                    {
                        @* Read-only view for non-admins *@
                        <div class="form-group">
                            <label>Name</label>
                            <span>@template.Name</span>
                        </div>
                        <div class="form-group">
                            <label>Implementation</label>
                            <span class="feature-badge @(template.ImplementationEnabled ? "feature-on" : "feature-off")">@(template.ImplementationEnabled ? "On" : "Off")</span>
                        </div>
                        <div class="form-group">
                            <label>PR Review</label>
                            <span class="feature-badge @(template.ReviewEnabled ? "feature-on" : "feature-off")">@(template.ReviewEnabled ? "On" : "Off")</span>
                        </div>
                        <div class="form-group">
                            <label>Decomposition</label>
                            <span class="feature-badge @(template.DecompositionEnabled ? "feature-on" : "feature-off")">@(template.DecompositionEnabled ? "On" : "Off")</span>
                        </div>
                        <div class="form-group">
                            <label>Housekeeping</label>
                            <span class="feature-badge @(template.HousekeepingEnabled ? "feature-on" : "feature-off")">@(template.HousekeepingEnabled ? "On" : "Off")</span>
                        </div>
                        <div class="form-group">
                            <label>Secrets</label>
                            <span>@(template.Secrets is { Count: > 0 } ? $"{template.Secrets.Count} configured" : "None")</span>
                        </div>
                        <div class="form-group">
                            <label>Setup Steps</label>
                            <span>@(template.SetupSteps is { Count: > 0 } ? $"{template.SetupSteps.Count} step(s)" : "None")</span>
                        </div>
                    }
                </section>

            </div>
        </div>
    </div>

    @* ═══ Dispatch drawers ═══ *@
    <IssueDispatchDrawer IsOpen="PageService.IsIssueDrawerOpen"
        Template="PageService.IssueDrawerTemplate"
        CanDispatch="PageService.CanDispatch()"
        Issues="PageService.DrawerIssues"
        IsLoading="PageService.DrawerLoading"
        HasMore="PageService.DrawerHasMore"
        Page="PageService.DrawerPage"
        IsDispatching="PageService.IssueDrawerDispatching"
        GetProcessingStatus="@(_ => null)"
        Readiness="PageService.DrawerReadiness"
        AvailableLabels="PageService.DrawerLabels"
        SelectedLabels="PageService.DrawerSelectedLabels"
        OnToggleLabel="l => { PageService.DrawerToggleLabel(l); StateHasChanged(); }"
        OnClearLabels="() => { PageService.DrawerClearLabels(); StateHasChanged(); }"
        OnClose="CloseIssueDrawer"
        OnNextPage="DrawerNextPage"
        OnPrevPage="DrawerPrevPage"
        OnDispatch="DispatchFromIssueDrawer" />

    <PrDispatchDrawer IsOpen="PageService.IsPrDrawerOpen"
        Template="PageService.PrDrawerTemplate"
        CanDispatch="PageService.CanDispatch()"
        PullRequests="PageService.PrDrawerPrs"
        IsLoading="PageService.PrDrawerLoading"
        HasMore="PageService.PrDrawerHasMore"
        Page="PageService.PrDrawerPage"
        IsDispatching="PageService.PrDrawerDispatching"
        GetProcessingStatus="@(_ => null)"
        AvailableLabels="PageService.PrDrawerLabels"
        SelectedLabels="PageService.PrDrawerSelectedLabels"
        OnToggleLabel="l => { PageService.PrDrawerToggleLabel(l); StateHasChanged(); }"
        OnClearLabels="() => { PageService.PrDrawerClearLabels(); StateHasChanged(); }"
        OnClose="ClosePrDrawer"
        OnNextPage="PrDrawerNextPage"
        OnPrevPage="PrDrawerPrevPage"
        OnDispatch="DispatchFromPrDrawer" />

    <EpicDispatchDrawer IsOpen="PageService.IsEpicDrawerOpen"
        Template="PageService.EpicDrawerTemplate"
        CanDispatch="PageService.CanDispatch()"
        Issues="PageService.EpicDrawerIssues"
        IsLoading="PageService.EpicDrawerLoading"
        HasMore="PageService.EpicDrawerHasMore"
        Page="PageService.EpicDrawerPage"
        IsDispatching="PageService.EpicDrawerDispatching"
        GetProcessingStatus="@(_ => null)"
        AvailableLabels="PageService.EpicDrawerLabels"
        SelectedLabels="PageService.EpicDrawerSelectedLabels"
        OnToggleLabel="l => { PageService.EpicDrawerToggleLabel(l); StateHasChanged(); }"
        OnClearLabels="() => { PageService.EpicDrawerClearLabels(); StateHasChanged(); }"
        OnClose="CloseEpicDrawer"
        OnNextPage="EpicDrawerNextPage"
        OnPrevPage="EpicDrawerPrevPage"
        OnDispatch="DispatchFromEpicDrawer" />

    @* ═══ Refactoring scan pre-flight modal ═══ *@
    @if (_showRefactoringModal)
    {
        <div class="modal-overlay" tabindex="-1" @ref="_modalOverlayRef"
             @onclick="DismissRefactoringModal"
             @onkeydown="HandleRefactoringModalKeyDown">
            <div class="modal-card" @onclick:stopPropagation="true"
                 role="dialog" aria-modal="true" aria-labelledby="refactoring-modal-title">
                <h3 id="refactoring-modal-title">Trigger Refactoring Scan</h3>
                <p class="modal-description">Template: <strong>@_modalTemplateName</strong></p>

                <div class="form-group">
                    <label>Issue Labels</label>
                    <div class="refactoring-modal-labels">
                        <span class="label-badge label-badge-static">agent:generated</span>
                        <div class="form-checkbox">
                            <label>
                                <input type="checkbox" @bind="_modalAutoDispatch" @onkeydown:stopPropagation="true" />
                                <span class="label-badge label-badge-optional">agent:next</span>
                                — auto-dispatch created issues for agent execution
                            </label>
                        </div>
                    </div>
                </div>

                <div class="form-group">
                    <label for="repo-refactoring-focus">Focus</label>
                    <select id="repo-refactoring-focus" data-testid="refactoring-focus"
                            @bind="_modalFocus" @onkeydown:stopPropagation="true">
                        <option value="@RefactoringScanFocus.All">All — every category</option>
                        <option value="@RefactoringScanFocus.Structure">Structure — duplication, structural drift, complexity, over-engineering</option>
                        <option value="@RefactoringScanFocus.Correctness">Correctness — bugs, dead code, TODOs, stale documentation</option>
                        <option value="@RefactoringScanFocus.Design">Design — naming, primitive obsession</option>
                        <option value="@RefactoringScanFocus.Tests">Tests — untested code (runs the tests with coverage)</option>
                    </select>
                </div>

                <div class="form-buttons">
                    <button class="btn-save" @onclick="ConfirmRefactoringModal">Start Scan</button>
                    <button class="btn-cancel" @onclick="DismissRefactoringModal">Cancel</button>
                </div>
            </div>
        </div>
    }
}

@code {
    [Parameter] public string TemplateId { get; set; } = "";

    private bool _isLoading = true;
    private string? _loadError;
    private string? _errorMessage;
    private string? _bindingError;
    private string? _bindingSuccess;
    private string? _behaviourError;
    private string? _behaviourSuccess;
    private bool _bindingSaving;
    private bool _behaviourSaving;

    // Cached template reference for rendering
    private PipelineJobTemplate? _template;

    // Binding form state
    private RepositoryPageService.BindingFormModel _bindingForm = new();
    private string _bindingLabelsText = "";
    private TemplateTableSection.LabelPreviewResult? _labelPreview;

    // Spec 053 req 5.5: what a template without stack labels gets.
    private const string NoStackLabelsNote = "Without stack labels, only the quality gates and reviewers that have no match labels apply.";

    // Repository rows (spec 053 req 3.2), edited by the global admin.
    private List<RouteRow> _routeRows = [];
    private string? _routesError;
    private string? _routesSuccess;
    private bool _routesSaving;

    // Behaviour form state — uses TemplateTableSection.TemplateFormModel for RepositorySettingsEditor compatibility
    private RepositoryPageService.BehaviourFormModel _behaviourForm = new();

    // The TemplateFormModel wrapping the BehaviourForm for RepositorySettingsEditor
    private TemplateTableSection.TemplateFormModel _behaviourSettingsForm = new();

    // Refactoring modal state
    private bool _showRefactoringModal;
    private bool _modalJustOpened;
    private string? _modalTemplateId;
    private string? _modalTemplateName;
    private bool _modalAutoDispatch;
    private RefactoringScanFocus _modalFocus;
    private ElementReference _modalOverlayRef;

    protected override async Task OnInitializedAsync()
    {
        _loadError = await PageService.InitializeAsync(TemplateId);
        _isLoading = false;

        if (!string.IsNullOrEmpty(_loadError) || !PageService.CanView()) return;

        InitForms();
        RefreshLabelPreview();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_showRefactoringModal && _modalJustOpened)
        {
            _modalJustOpened = false;
            try { await _modalOverlayRef.FocusAsync(); }
            catch (Exception) { /* Element may not be rendered yet */ }
        }
    }

    private void InitForms()
    {
        var template = PageService.Template;
        if (template is null) return;

        _template = template;
        _bindingForm = RepositoryPageService.BindingFormModel.FromTemplate(template);
        _routeRows = RouteRow.ForRepository(template.AgentRoutes);
        _bindingLabelsText = template.RequiredLabels is { Count: > 0 }
            ? string.Join(", ", template.RequiredLabels)
            : "";

        _behaviourForm = RepositoryPageService.BehaviourFormModel.FromTemplate(template);
        // Wire up the TemplateFormModel for RepositorySettingsEditor
        _behaviourSettingsForm = new TemplateTableSection.TemplateFormModel
        {
            Name = template.Name,
            Secrets = template.Secrets != null ? new Dictionary<string, string>(template.Secrets) : null,
            SetupSteps = template.SetupSteps,
            SteeringContent = template.SteeringContent,
            BlacklistedPaths = template.BlacklistedPaths,
        };
    }

    private void RefreshLabelPreview()
    {
        _labelPreview = PageService.GetLabelPreview(_bindingForm.RequiredLabels);
    }

    private void OnBindingLabelsChanged(ChangeEventArgs e)
    {
        _bindingLabelsText = e.Value?.ToString() ?? "";
        var labels = _bindingLabelsText.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _bindingForm.RequiredLabels = labels.Length > 0 ? labels : null;
        RefreshLabelPreview();
    }

    private async Task SaveBinding()
    {
        _bindingError = null;
        _bindingSuccess = null;
        _bindingSaving = true;
        try
        {
            var (success, error, message) = await PageService.SaveBindingAsync(_bindingForm);
            if (!success) { _bindingError = error; }
            else
            {
                _bindingSuccess = message;
                _template = PageService.Template;
                _ = ClearBindingSuccessAfterDelay();
            }
        }
        finally { _bindingSaving = false; }
    }

    private async Task SaveRoutes()
    {
        _routesError = null;
        _routesSuccess = null;
        _routesSaving = true;
        try
        {
            // The API refuses an invalid row with one line per row.
            var (success, error, message) = await PageService.SaveRoutesAsync(_routeRows);
            if (!success) { _routesError = error; }
            else
            {
                _routesSuccess = message;
                _template = PageService.Template;
            }
        }
        finally { _routesSaving = false; }
    }

    private async Task SaveBehaviour()
    {
        _behaviourError = null;
        _behaviourSuccess = null;
        _behaviourSaving = true;

        // Sync the RepositorySettingsEditor form values back to _behaviourForm
        _behaviourForm.Secrets = _behaviourSettingsForm.Secrets;
        _behaviourForm.SetupSteps = _behaviourSettingsForm.SetupSteps;
        _behaviourForm.SteeringContent = _behaviourSettingsForm.SteeringContent;
        _behaviourForm.BlacklistedPaths = _behaviourSettingsForm.BlacklistedPaths;

        try
        {
            var (success, error, message) = await PageService.SaveBehaviourAsync(_behaviourForm);
            if (!success) { _behaviourError = error; }
            else
            {
                _behaviourSuccess = message;
                _template = PageService.Template;
                _ = ClearBehaviourSuccessAfterDelay();
            }
        }
        finally { _behaviourSaving = false; }
    }

    private void DismissError() => _errorMessage = null;

    private async Task ClearBindingSuccessAfterDelay()
    {
        await Task.Delay(4000);
        _bindingSuccess = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task ClearBehaviourSuccessAfterDelay()
    {
        await Task.Delay(4000);
        _behaviourSuccess = null;
        await InvokeAsync(StateHasChanged);
    }

