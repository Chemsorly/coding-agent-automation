@page "/settings"
@attribute [Authorize(Policy = AccessPolicies.Admin)]
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgent.Pipeline.Interfaces
@using CodingAgent.Pipeline.Models
@using CodingAgent.Web.Services
@using CodingAgent.Web.Components.Shared
@inject ILogger<Settings> Logger
@inject IUiSettingsClient SettingsClient
@inject IUiProviderClient ProviderClient
@inject NotificationService NotificationService
@inject NavigationManager NavigationManager

<PageTitle>Settings - Coding Agent</PageTitle>

<div class="cockpit-page settings-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Settings</h1>
            <span class="cockpit-page-sub">Providers, templates, and agent configuration</span>
        </div>
    </div>

    <div class="settings-layout">
        <SettingsTreeNav @ref="_treeNav" SelectedNode="@_selectedNode" />

        <div class="settings-content">
            <InlineStatus Message="@_statusMessage" IsError="@_isError" OnDismissed="ClearStatus" />
            @switch (_selectedNode)
            {
                case SettingsNodes.Projects:
                    <ProjectsListSection
                        ConfigClient="SettingsClient"
                        OnNavigateToProject="NavigateToProjectDetail"
                        OnProjectsChanged="RefreshTreeNavProjects"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.ProvidersIssue:
                    <IssueProviderSection
                        Providers="_issueProviders"
                        ProviderClient="ProviderClient"
                        OnDelete="id => DeleteProvider(id, ProviderKind.Issue)"
                        OnSaved="OnIssueProviderSaved"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.ProvidersRepository:
                    <RepoProviderSection
                        Providers="_repoProviders"
                        ProviderClient="ProviderClient"
                        OnDelete="id => DeleteProvider(id, ProviderKind.Repository)"
                        OnSaved="OnGitHubProviderSaved"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.ProvidersPipeline:
                    <PipelineProviderSection
                        Providers="_pipelineProviders"
                        ProviderClient="ProviderClient"
                        OnDelete="id => DeleteProvider(id, ProviderKind.Pipeline)"
                        OnSaved="OnGitHubProviderSaved"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineGeneral:
                    <PipelineGeneralSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineLoop:
                    <PipelineLoopSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelinePrompts:
                    <PipelinePromptsSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineCi:
                    <PipelineCiSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineCodeReview:
                    <PipelineCodeReviewSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineDecomposition:
                    <PipelineDecompositionSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineConsolidation:
                    <PipelineConsolidationSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineTriage:
                    <PipelineTriageSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.PipelineAdvanced:
                    <PipelineAdvancedSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.AgentProfiles:
                    <AgentProfileSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.AgentRouting:
                    <AgentRoutingSection
                        SettingsClient="SettingsClient"
                        ProviderClient="ProviderClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.QualityGateConfigs:
                    <QualityGateConfigSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.ReviewerConfigs:
                    <ReviewerConfigSection
                        ConfigClient="SettingsClient"
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)" />
                    break;
                case SettingsNodes.ConfigImportExport:
                    <ConfigImportExportSection
                        OnShowStatus="s => ShowStatus(s.Message, s.IsError)"
                        OnImportCompleted="LoadAllData" />
                    break;
            }
        </div>
    </div>
</div>

<SettingsModals @ref="_modals"
    ProviderClient="ProviderClient"
    IssueProviders="_issueProviders"
    RepoProviders="_repoProviders"
    PipelineProviders="_pipelineProviders"
    OnLabelsConfigured="LoadAllData"
    OnProvidersCreated="OnRelatedProvidersCreated" />

@code {
    private readonly CancellationTokenSource _cts = new();
    private CancellationTokenSource? _toastCts;
    private SettingsModals? _modals;
    private SettingsTreeNav? _treeNav;

    // Resolved optionally — only available in k8s mode
    // TODO: Restore template label validation via GET /api/config/job-templates when API client is wired here.
    // JobTemplateStore removed from Settings.razor (Spec 045 Req 1b.2 / Task 8) — the ConfigMap mount
    // moved to the Job Controller pod in Spec 043; the orchestrator no longer has access to it.
    // Template label validation was cosmetic only (warning when a label doesn't match a known template).
    // ModelFetchJobService removed (Spec 045 Req 7a.3): models come from ProviderClient.GetModelsAsync
    private string _selectedNode = SettingsNodes.ProvidersIssue;

    [Parameter]
    [SupplyParameterFromQuery(Name = "section")]
    public string? SectionFromQuery { get; set; }

    private List<ProviderConfig> _issueProviders = new();
    private List<ProviderConfig> _repoProviders = new();
    private List<ProviderConfig> _pipelineProviders = new();

    private string? _statusMessage;
    private bool _isError;

    /// <summary>
    /// Returns true if <paramref name="section"/> is a recognised SettingsNodes constant.
    /// </summary>
    private static bool IsKnownSection(string section) =>
        section == SettingsNodes.ProvidersIssue ||
        section == SettingsNodes.ProvidersRepository ||
        section == SettingsNodes.ProvidersAgent ||
        section == SettingsNodes.ProvidersPipeline ||
        section == SettingsNodes.PipelineGeneral ||
        section == SettingsNodes.PipelineLoop ||
        section == SettingsNodes.PipelinePrompts ||
        section == SettingsNodes.PipelineCi ||
        section == SettingsNodes.PipelineCodeReview ||
        section == SettingsNodes.PipelineDecomposition ||
        section == SettingsNodes.PipelineConsolidation ||
        section == SettingsNodes.PipelineTriage ||
        section == SettingsNodes.PipelineAdvanced ||
        section == SettingsNodes.AgentProfiles ||
        section == SettingsNodes.AgentRouting ||
        section == SettingsNodes.QualityGateConfigs ||
        section == SettingsNodes.ReviewerConfigs ||
        section == SettingsNodes.Projects ||
        section == SettingsNodes.ConfigImportExport;

    protected override async Task OnInitializedAsync()
    {
        // Select before the first await so a deep link never flashes the default section.
        SelectNodeFromQuery();
        await LoadAllData();
    }

    protected override Task OnParametersSetAsync()
    {
        // Pick up section changes from URL navigation (Back/Forward, tree and sidebar links).
        // OnInitializedAsync does not re-run for in-app navigation — this override does.
        SelectNodeFromQuery();
        return Task.CompletedTask;
    }

    /// <summary>
    /// The URL is the only source of the selected section: a missing or unknown section means the
    /// default one, so the sidebar's plain /settings link returns to it instead of keeping the last section.
    /// The former agent provider node opens Agent Profiles, where the tool settings are now (spec 053 req 1.6).
    /// </summary>
    private void SelectNodeFromQuery() =>
        _selectedNode = SectionFromQuery switch
        {
            SettingsNodes.ProvidersAgent => SettingsNodes.AgentProfiles,
            { Length: > 0 } section when IsKnownSection(section) => section,
            _ => SettingsNodes.ProvidersIssue,
        };

    private async Task LoadAllData()
    {
        try
        {
            _issueProviders = (await ProviderClient.GetProviderConfigsAsync(ProviderKind.Issue, _cts.Token)).ToList();
            _repoProviders = (await ProviderClient.GetProviderConfigsAsync(ProviderKind.Repository, _cts.Token)).ToList();
            _pipelineProviders = (await ProviderClient.GetProviderConfigsAsync(ProviderKind.Pipeline, _cts.Token)).ToList();
        }
        catch (OperationCanceledException) { /* Expected on cancellation. */ }
        catch (Exception ex)
        {
            ShowStatus($"Failed to load settings: {ex.Message}", isError: true);
        }
    }

    private async Task OnIssueProviderSaved(ProviderConfig config)
    {
        await LoadAllData();
        ShowStatus("Issue provider saved.");

        var hasLabels = false;
        try
        {
            hasLabels = await ProviderClient.HasAgentLabelsAsync(config.Id, _cts.Token);
        }
        catch (OperationCanceledException) { return; }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to check agent labels for provider {ProviderId}", config.Id);
        }

        if (_cts.IsCancellationRequested) return;

        if (!hasLabels)
            _modals?.ShowConfigureLabels(config);
        else
            _modals?.ShowRelatedProviders(config);
    }

    private async Task OnGitHubProviderSaved(ProviderConfig config)
    {
        await LoadAllData();
        ShowStatus($"{config.Kind} provider saved.");
        _modals?.ShowRelatedProviders(config);
    }

    private async Task OnRelatedProvidersCreated()
    {
        await LoadAllData();
        ShowStatus("Related providers created.");
    }

    private async Task DeleteProvider(string id, ProviderKind kind)
    {
        try
        {
            await ProviderClient.DeleteProviderConfigAsync(id, kind, _cts.Token);
            await LoadAllData();
            ShowStatus($"{kind} provider deleted.");
        }
        catch (OperationCanceledException) { /* Expected on cancellation. */ }
        catch (Exception ex)
        {
            ShowStatus($"Failed to delete: {ex.Message}", isError: true);
        }
    }

    private void ShowStatus(string message, bool isError = false)
    {
        _statusMessage = message;
        _isError = isError;

        NotificationService.Add(message, isError ? NotificationSeverity.Error : NotificationSeverity.Success);

        // Errors don't auto-dismiss — user must dismiss manually via InlineStatus
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        _toastCts = null;

        if (!isError)
        {
            _toastCts = new CancellationTokenSource();
            _ = DismissAfterDelay(_toastCts.Token);
        }
    }

    private void ClearStatus()
    {
        _statusMessage = null;
        StateHasChanged();
    }

    private async Task DismissAfterDelay(CancellationToken token)
    {
        try
        {
            await Task.Delay(4000, token);
            _statusMessage = null;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) { /* Expected on cancellation. */ }
    }

    private async Task NavigateToProjectDetail(string projectId)
    {
        NavigationManager.NavigateTo($"projects/{projectId}");
        if (_treeNav is not null)
            await _treeNav.RefreshProjectsAsync();
    }

    private async Task RefreshTreeNavProjects()
    {
        if (_treeNav is not null)
            await _treeNav.RefreshProjectsAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_toastCts is not null) await _toastCts.CancelAsync();
        _toastCts?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
