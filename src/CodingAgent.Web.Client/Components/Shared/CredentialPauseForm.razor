@inject IUiCredentialsClient Credentials
@inject IAccessGuard Guard
@inject ILogger<CredentialPauseForm> Logger

@* Spec 056 req 2.1: pause one credential until a time (empty: until resumed) with an optional note. Global operators only;
   the API checks the same (DD8). *@
<div class="credential-pause-form" data-testid="credential-pause-form-@Credential">
    <label>
        Until
        <input type="datetime-local" value="@_until" @onchange="e => _until = e.Value?.ToString()" aria-label="@($"Pause {DisplayName} until")" data-testid="credential-pause-until" />
    </label>
    <label>
        Note
        <input type="text" maxlength="200" @bind="_note" placeholder="Why (optional)" aria-label="@($"Note for pausing {DisplayName}")" data-testid="credential-pause-note" />
    </label>
    <button type="button" class="btn-save" disabled="@_busy" @onclick="PauseAsync" data-testid="credential-pause-submit">Pause</button>
    <button type="button" class="btn-cancel-small" disabled="@_busy" @onclick="OnCancel">Cancel</button>
    <InlineStatus Message="@_error" IsError="true" OnDismissed="() => _error = null" />
</div>

@code {
    [Parameter, EditorRequired] public string Credential { get; set; } = "";
    [Parameter, EditorRequired] public string DisplayName { get; set; } = "";
    [Parameter] public EventCallback OnPaused { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    private string? _until; // "yyyy-MM-ddTHH:mm" or with seconds, as the browser sends it
    private string? _note;
    private bool _busy;
    private string? _error;

    private async Task PauseAsync()
    {
        try { await Guard.DemandAsync(AccessRole.Operator, null, "PauseAgentCredential"); }
        catch (AccessDeniedException) { _error = "Pausing a credential needs the global operator role."; return; }

        _busy = true;
        _error = null;
        try
        {
            // datetime-local is the browser's local time.
            DateTimeOffset? until = null;
            if (!string.IsNullOrWhiteSpace(_until))
            {
                if (!DateTime.TryParse(_until, System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.None, out var local))
                {
                    _error = "Enter the end time as a date and time.";
                    return;
                }
                until = new DateTimeOffset(DateTime.SpecifyKind(local, DateTimeKind.Unspecified), TimeZoneInfo.Local.GetUtcOffset(local));
            }
            await Credentials.PauseAsync(Credential, until, string.IsNullOrWhiteSpace(_note) ? null : _note.Trim());
            await OnPaused.InvokeAsync();
        }
        catch (Exception ex) when (ex is InvalidOperationException or HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "Pausing credential {Credential} failed", Credential);
            _error = ex is InvalidOperationException ? ex.Message : "The credential could not be paused. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }
}
