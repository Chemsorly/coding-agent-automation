@inject IUiCredentialsClient Credentials
@inject CurrentAccess Access
@inject IAccessGuard Guard
@inject ILogger<CredentialPauseBanner> Logger

@* Spec 056 req 4.1: one banner per paused credential on Work and Fleet — what is paused, why, since and until when, and
   how much work waits for it. Global operators can resume it or change its end time. The host page refreshes it with
   its RefreshBar (there is no push). *@
@foreach (var c in _paused)
{
    <div class="cockpit-banner credential-pause-banner" role="alert" data-testid="credential-pause-banner-@c.Credential">
        <Icon Name="alert-triangle" Size="14" />
        <span class="credential-pause-banner-text">
            <strong>@c.Text</strong>
            @if (!string.IsNullOrWhiteSpace(c.Detail))
            {
                <span class="credential-pause-banner-detail" data-testid="credential-pause-detail">@c.Detail</span>
            }
            @if (c.HeldItems > 0)
            {
                <span class="credential-pause-banner-held">@c.HeldItems @(c.HeldItems == 1 ? "work item waits" : "work items wait") for it.</span>
            }
        </span>
        @if (Access.HasGlobalOperate)
        {
            <button type="button" class="btn-save" disabled="@_busy" data-testid="credential-resume-@c.Credential"
                    @onclick="() => ResumeAsync(c.Credential)">Resume</button>
            <button type="button" class="btn-cancel-small" data-testid="credential-pause-until-@c.Credential"
                    @onclick="() => _editing = _editing == c.Credential ? null : c.Credential">Pause until…</button>
        }
    </div>
    @if (_editing == c.Credential)
    {
        <CredentialPauseForm Credential="@c.Credential" DisplayName="@c.DisplayName" OnPaused="ChangedAsync" OnCancel="() => _editing = null" />
    }
}
<InlineStatus Message="@_error" IsError="true" OnDismissed="() => _error = null" />

@code {
    /// <summary>Raised after this banner paused or resumed a credential, so the page can reload what depends on it.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<UiAgentCredential> _paused = [];
    private string? _editing;
    private bool _busy;
    private string? _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    /// <summary>Reloads the credentials; the host page calls it from its RefreshBar.</summary>
    public async Task RefreshAsync()
    {
        try
        {
            var page = await Credentials.GetAsync();
            _paused = page.Credentials.Where(c => c.Paused).ToList();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            // The banner is a hint; an unreachable API must not break the page it sits on.
            Logger.LogWarning(ex, "CredentialPauseBanner: failed to load the agent credentials");
        }
        StateHasChanged();
    }

    private async Task ResumeAsync(string credential)
    {
        try { await Guard.DemandAsync(AccessRole.Operator, null, "ResumeAgentCredential"); }
        catch (AccessDeniedException) { return; }

        _busy = true;
        try
        {
            await Credentials.ResumeAsync(credential);
            await ChangedAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Resuming credential {Credential} failed", credential);
            _error = ex is InvalidOperationException ? ex.Message : "The credential could not be resumed. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangedAsync()
    {
        _editing = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}
