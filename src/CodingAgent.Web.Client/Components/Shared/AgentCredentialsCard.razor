@inject IUiCredentialsClient Credentials
@inject CurrentAccess Access
@inject IAccessGuard Guard
@inject ILogger<AgentCredentialsCard> Logger

@* Spec 056 req 4.2: every credential in use with its state, the work waiting for it and — for global operators — Pause
   and Resume. On Fleet (operators) and in Settings → Agents → Credentials, which also lists the profiles per credential. *@
<div class="cockpit-card" data-testid="agent-credentials-card">
    <div class="cockpit-card-header"><h2>Credentials</h2></div>
    @if (_loading)
    {
        <div class="cockpit-empty">Loading credentials…</div>
    }
    else if (_loadError is not null)
    {
        <div class="cockpit-empty">@_loadError</div>
    }
    else if (_credentials.Count == 0)
    {
        <div class="cockpit-empty">No agent profile uses a credential yet.</div>
    }
    else
    {
        <div class="monitoring-table-wrap">
            <table class="monitoring-table">
                <thead>
                    <tr>
                        <th>Credential</th><th>State</th><th>Waiting</th>
                        @if (ShowProfiles)
                        {
                            <th>Profiles</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _credentials)
                    {
                        <tr data-testid="credential-row-@c.Credential">
                            <td>@c.DisplayName</td>
                            <td>
                                @if (c.Paused)
                                {
                                    <span class="cockpit-chip credential-paused-chip">Paused</span>
                                    <span class="monitoring-muted" title="@c.Detail">@c.Text</span>
                                }
                                else
                                {
                                    <span class="cockpit-chip">Available</span>
                                }
                            </td>
                            <td>@(c.HeldItems > 0 ? c.HeldItems.ToString() : "—")</td>
                            @if (ShowProfiles)
                            {
                                <td>@(c.Profiles.Count == 0 ? "—" : string.Join(", ", c.Profiles))</td>
                            }
                            <td style="text-align: right;">
                                @if (Access.HasGlobalOperate)
                                {
                                    @if (c.Paused)
                                    {
                                        <button type="button" class="btn-save" disabled="@_busy" data-testid="credential-card-resume-@c.Credential"
                                                @onclick="() => ResumeAsync(c.Credential)">Resume</button>
                                    }
                                    <button type="button" class="btn-cancel-small" data-testid="credential-card-pause-@c.Credential"
                                            @onclick="() => _editing = _editing == c.Credential ? null : c.Credential">
                                        @(c.Paused ? "Pause until…" : "Pause")
                                    </button>
                                }
                            </td>
                        </tr>
                        @if (_editing == c.Credential)
                        {
                            <tr>
                                <td colspan="@(ShowProfiles ? 5 : 4)">
                                    <CredentialPauseForm Credential="@c.Credential" DisplayName="@c.DisplayName" OnPaused="ChangedAsync" OnCancel="() => _editing = null" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <InlineStatus Message="@_error" IsError="true" OnDismissed="() => _error = null" />
    }
</div>

@code {
    /// <summary>Also lists the profiles that use each credential (Settings).</summary>
    [Parameter] public bool ShowProfiles { get; set; }

    /// <summary>Raised after this card paused or resumed a credential.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<UiAgentCredential> _credentials = [];
    private bool _loading = true;
    private string? _loadError;
    private string? _editing;
    private bool _busy;
    private string? _error;

    protected override Task OnInitializedAsync() => RefreshAsync();

    /// <summary>Reloads the credentials; the host page calls it from its RefreshBar.</summary>
    public async Task RefreshAsync()
    {
        try
        {
            _credentials = (await Credentials.GetAsync()).Credentials;
            _loadError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "AgentCredentialsCard: failed to load the agent credentials");
            _loadError = "The credentials could not be loaded.";
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task ResumeAsync(string credential)
    {
        try { await Guard.DemandAsync(AccessRole.Operator, null, "ResumeAgentCredential"); }
        catch (AccessDeniedException) { return; }

        _busy = true;
        try
        {
            await Credentials.ResumeAsync(credential);
            await ChangedAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Resuming credential {Credential} failed", credential);
            _error = ex is InvalidOperationException ? ex.Message : "The credential could not be resumed. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangedAsync()
    {
        _editing = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}
