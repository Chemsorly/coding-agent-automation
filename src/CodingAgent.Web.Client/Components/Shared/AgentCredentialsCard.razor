@using CodingAgent.Pipeline.Models
@inject IUiCredentialsClient Credentials
@inject CurrentAccess Access
@inject IAccessGuard Guard
@inject ILogger<AgentCredentialsCard> Logger

@* Spec 056 req 4.2: every credential in use with its state, the work waiting for it and — for global operators — Pause
   and Resume. On Fleet (operators) and in Settings → Agents → Credentials, which also lists the profiles per credential. *@
<div class="cockpit-card" data-testid="agent-credentials-card">
    <div class="cockpit-card-header"><h2>Credentials</h2></div>
    @if (_loading)
    {
        <div class="cockpit-empty">Loading credentials…</div>
    }
    else if (_loadError is not null)
    {
        <div class="cockpit-empty">@_loadError</div>
    }
    else if (_credentials.Count == 0)
    {
        <div class="cockpit-empty">No agent profile uses a credential yet.</div>
    }
    else
    {
        <div class="monitoring-table-wrap">
            <table class="monitoring-table">
                <thead>
                    <tr>
                        <th>Credential</th><th>State</th><th>Waiting</th>
                        @if (ShowProfiles)
                        {
                            <th>Profiles</th>
                        }
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in _credentials)
                    {
                        <tr data-testid="credential-row-@c.Credential">
                            <td>@c.DisplayName</td>
                            <td>
                                @if (c.Paused)
                                {
                                    <span class="cockpit-chip credential-paused-chip">Paused</span>
                                    <span class="monitoring-muted" title="@c.Detail">@c.Text</span>
                                }
                                else
                                {
                                    <span class="cockpit-chip">Available</span>
                                }
                                @if (c.Usage is { Count: > 0 } usage)
                                {
                                    @* The last usage reading per window, against its threshold. *@
                                    <div class="form-hint" data-testid="credential-usage-@c.Credential">
                                        @foreach (var u in usage)
                                        {
                                            <span title="@UsageTitle(u)" style="margin-right: 12px;">@UsageText(u)</span>
                                        }
                                    </div>
                                }
                            </td>
                            <td>@(c.HeldItems > 0 ? c.HeldItems.ToString() : "—")</td>
                            @if (ShowProfiles)
                            {
                                <td>@(c.Profiles.Count == 0 ? "—" : string.Join(", ", c.Profiles))</td>
                            }
                            <td>
                                @if (Access.HasGlobalOperate)
                                {
                                    <div class="credential-actions">
                                        @if (c.Paused)
                                        {
                                            <button type="button" class="btn-save" disabled="@_busy" data-testid="credential-card-resume-@c.Credential"
                                                    @onclick="() => ResumeAsync(c.Credential)">Resume</button>
                                        }
                                        <button type="button" class="@(c.Paused ? "btn-edit" : "btn-cancel-small")" data-testid="credential-card-pause-@c.Credential"
                                                @onclick="() => _editing = _editing == c.Credential ? null : c.Credential">
                                            @(c.Paused ? "Pause until…" : "Pause")
                                        </button>
                                    </div>
                                }
                            </td>
                        </tr>
                        @if (_editing == c.Credential)
                        {
                            <tr>
                                <td colspan="@(ShowProfiles ? 5 : 4)">
                                    <CredentialPauseForm Credential="@c.Credential" DisplayName="@c.DisplayName" OnPaused="ChangedAsync" OnCancel="() => _editing = null" />
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        @if (ShowProfiles && Access.IsAdmin && _thresholds is not null
             && _credentials.Any(c => c.Credential == AgentCredentials.ClaudeSubscription))
        {
            <div class="credential-thresholds" data-testid="usage-thresholds">
                <h3>Usage thresholds — Claude subscription</h3>
                <p class="form-hint">
                    New work waits once a window reaches its threshold, until the window resets. Running work finishes.
                    Resume lets the window through until it resets. 0 switches a threshold off. Saving applies the new
                    thresholds to the last readings at once.
                </p>
                <div class="credential-threshold-fields">
                    <div class="form-group">
                        <label for="usage-threshold-five-hour">5-hour window (%)</label>
                        <input id="usage-threshold-five-hour" type="number" min="0" max="@CredentialUsageThresholds.MaxPercent"
                               data-testid="usage-threshold-five-hour" @bind="_fiveHour" />
                    </div>
                    <div class="form-group">
                        <label for="usage-threshold-seven-day">7-day window (%)</label>
                        <input id="usage-threshold-seven-day" type="number" min="0" max="@CredentialUsageThresholds.MaxPercent"
                               data-testid="usage-threshold-seven-day" @bind="_sevenDay" />
                    </div>
                </div>
                <div class="form-buttons">
                    <button type="button" class="btn-save" disabled="@_busy" data-testid="usage-thresholds-save"
                            @onclick="SaveThresholdsAsync">Save</button>
                </div>
            </div>
        }
        <InlineStatus Message="@_error" IsError="true" OnDismissed="() => _error = null" />
    }
</div>

@code {
    /// <summary>Also lists the profiles that use each credential (Settings).</summary>
    [Parameter] public bool ShowProfiles { get; set; }

    /// <summary>Raised after this card paused or resumed a credential.</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private IReadOnlyList<UiAgentCredential> _credentials = [];
    private bool _loading = true;
    private string? _loadError;
    private string? _editing;
    private bool _busy;
    private string? _error;
    private CredentialUsageThresholds? _thresholds;
    private int _fiveHour;
    private int _sevenDay;

    protected override Task OnInitializedAsync() => RefreshAsync();

    /// <summary>Reloads the credentials; the host page calls it from its RefreshBar.</summary>
    public async Task RefreshAsync()
    {
        try
        {
            var page = await Credentials.GetAsync();
            _credentials = page.Credentials;
            // Only stored thresholds that changed overwrite the inputs: a pause or resume in this card reloads it, and
            // must not throw away an edit that is not saved yet.
            if (page.UsageThresholds != _thresholds)
            {
                _thresholds = page.UsageThresholds;
                _fiveHour = _thresholds?.FiveHourPercent ?? 0;
                _sevenDay = _thresholds?.SevenDayPercent ?? 0;
            }
            _loadError = null;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException or System.Text.Json.JsonException)
        {
            Logger.LogWarning(ex, "AgentCredentialsCard: failed to load the agent credentials");
            _loadError = "The credentials could not be loaded.";
        }
        _loading = false;
        StateHasChanged();
    }

    private async Task ResumeAsync(string credential)
    {
        try { await Guard.DemandAsync(AccessRole.Operator, null, "ResumeAgentCredential"); }
        catch (AccessDeniedException) { return; }

        _busy = true;
        try
        {
            await Credentials.ResumeAsync(credential);
            await ChangedAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Resuming credential {Credential} failed", credential);
            _error = ex is InvalidOperationException ? ex.Message : "The credential could not be resumed. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>"5-hour window 42 % (pause at 75 %)"; "off" when the threshold is 0.</summary>
    private static string UsageText(UiCredentialUsage u) =>
        $"{u.Label} {Math.Round(u.Utilization * 100, MidpointRounding.AwayFromZero):0} % "
        + (u.ThresholdPercent > 0 ? $"(pause at {u.ThresholdPercent} %)" : "(threshold off)");

    private static string UsageTitle(UiCredentialUsage u) =>
        (u.ResetsAt is { } r ? $"resets {r.UtcDateTime:yyyy-MM-dd HH:mm} UTC · " : "")
        + $"seen {u.SeenAt.UtcDateTime:yyyy-MM-dd HH:mm} UTC";

    private async Task SaveThresholdsAsync()
    {
        try { await Guard.DemandAsync(AccessRole.Admin, null, "SaveUsageThresholds"); }
        catch (AccessDeniedException) { return; }

        var thresholds = new CredentialUsageThresholds { FiveHourPercent = _fiveHour, SevenDayPercent = _sevenDay };
        if (thresholds.Validate() is { Count: > 0 } errors)
        {
            _error = string.Join(" ", errors);
            return;
        }

        _busy = true;
        try
        {
            await Credentials.SaveUsageThresholdsAsync(thresholds);
            await ChangedAsync();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            Logger.LogWarning(ex, "Saving the usage thresholds failed");
            _error = ex is InvalidOperationException ? ex.Message : "The usage thresholds could not be saved. Try again.";
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ChangedAsync()
    {
        _editing = null;
        await RefreshAsync();
        await OnChanged.InvokeAsync();
    }
}
