@inject ILogger<FirstRunBanner> Logger
@inject IUiSettingsClient Settings
@inject NavigationManager Navigation
@inject IAccessGuard Guard

@if (_show)
{
    <div class="first-run-banner" role="alert" aria-live="polite">
        <span class="first-run-banner-message">
            No job templates configured. Go to <a href="pipelines"><strong>Pipelines → Pipeline Job Templates</strong></a> to set up your first template before the pipeline can dispatch work.
        </span>
        <InlineStatus Message="@_errorMessage" IsError="true" OnDismissed="ClearError" />
        <button class="first-run-banner-dismiss" @onclick="DismissAsync" aria-label="Dismiss banner">Dismiss</button>
    </div>
}

@code {
    private bool _show;
    private bool _dismissed;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await EvaluateAsync();
    }

    private async Task EvaluateAsync()
    {
        UiFirstRunState state;
        try
        {
            state = await Settings.GetFirstRunStateAsync(CancellationToken.None);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // The banner is a hint; an unreachable API must not break the page it sits on.
            Logger.LogWarning(ex, "FirstRunBanner: failed to load the first-run state");
            _show = false;
            return;
        }
        var hasEnabled = state.HasEnabledTemplates;
        _dismissed = state.BannerDismissed;

        var currentPath = new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/');
        // Suppress the banner when the user is already on the Pipelines page.
        // AgentCoding.razor registers both /pipelines and /agent-coding as valid routes.
        var onPipelines = string.Equals(currentPath, "/pipelines", StringComparison.OrdinalIgnoreCase)
                       || string.Equals(currentPath, "/agent-coding", StringComparison.OrdinalIgnoreCase);

        // The banner shows only while no template is enabled. Dismissing hides it for good: before,
        // "(notDismissed OR noEnabledTemplates)" was always true here, so Dismiss did nothing.
        _show = !hasEnabled && !onPipelines && !_dismissed;
    }

    private async Task DismissAsync()
    {
        // Spec 049: the dismissal is shared configuration; CockpitLayout renders the banner for admins only.
        try { await Guard.DemandAsync(AccessRole.Admin, null, "DismissFirstRunBanner"); }
        catch (AccessDeniedException) { return; }
        try
        {
            await Settings.DismissFirstRunBannerAsync(CancellationToken.None);
        }
        catch (Exception ex)
        {
            // An exception escaping an event handler breaks the app (the error bar shows); keep the banner and say why.
            Logger.LogWarning(ex, "FirstRunBanner: failed to save the dismissal");
            _errorMessage = $"Failed to dismiss: {ex.Message}";
            return;
        }
        _errorMessage = null;
        _dismissed = true;
        await EvaluateAsync();
        StateHasChanged();
    }

    private void ClearError() => _errorMessage = null;
}
