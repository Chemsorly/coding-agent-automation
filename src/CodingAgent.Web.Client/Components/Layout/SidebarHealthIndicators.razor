@implements IDisposable
@using CodingAgent.Pipeline.Models
@inject IUiHealthClient Health
@inject IUiAgentClient Agents

@if (_sectionVisible)
{
    <div class="sidebar-health">
        <span class="sidebar-health-title">HEALTH</span>
        @if (_dbStatus is not null)
        {
            <span class="sidebar-health-item" title="@DbTooltip">
                <span class="infra-health-dot @DbDotClass"></span>
                <span class="sidebar-health-label">Database</span>
            </span>
        }
        <span class="sidebar-health-item" title="@RedisTooltip">
            <span class="infra-health-dot @RedisDotClass"></span>
            <span class="sidebar-health-label">Redis</span>
        </span>
        @if (_connectedCount > 0 || _dbStatus is not null || _redisStatus is not null)
        {
            <span class="sidebar-health-item" title="@AgentTooltip">
                <span class="infra-health-dot @AgentDotClass"></span>
                <span class="sidebar-health-label">Agents: @_connectedCount</span>
            </span>
        }
    </div>
}

@code {
    /// <summary>
    /// Database, Redis and the agent count come from the Pipeline API (spec 051, <c>/api/ui/health</c>
    /// and <c>/api/ui/agents</c>) with the user's token; every 10 s is enough for a sidebar dot. A
    /// project-scoped user counts only the agents running their projects' work.
    /// </summary>
    private static readonly TimeSpan RefreshInterval = TimeSpan.FromSeconds(10);

    private System.Threading.Timer? _refreshTimer;
    private bool _disposed;
    private bool _refreshInFlight;

    private bool? _dbStatus;
    private bool? _redisStatus;
    private int _connectedCount;
    private int _totalCount;

    /// <summary>
    /// Section is visible when at least one indicator has data (health read from the API, or agents
    /// registered). Before the first health read and without agents, it is hidden.
    /// </summary>
    private bool _sectionVisible;

    private string DbDotClass => _dbStatus == true ? "dot-healthy" : "dot-unhealthy";
    private string DbTooltip => _dbStatus == true ? "Database: Connected" : "Database: Disconnected";

    private string RedisDotClass
    {
        get
        {
            if (_redisStatus == true) return "dot-healthy";
            if (_redisStatus == false) return "dot-unhealthy";
            return "dot-inactive";
        }
    }

    private string RedisTooltip
    {
        get
        {
            if (_redisStatus == true) return "Redis: Connected";
            if (_redisStatus == false) return "Redis: Disconnected";
            return "Redis: Not configured";
        }
    }

    private string AgentDotClass
    {
        get
        {
            if (_totalCount == 0) return "dot-inactive";
            if (_connectedCount == _totalCount) return "dot-healthy";
            if (_connectedCount == 0) return "dot-unhealthy";
            return "dot-warning";
        }
    }
    private string AgentTooltip => $"Agents: {_connectedCount} connected, {_totalCount - _connectedCount} disconnected";

    protected override void OnInitialized() =>
        _refreshTimer = new System.Threading.Timer(RefreshTick, null, RefreshInterval, RefreshInterval);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Not during prerendering: the first read waits until the circuit is interactive.
        if (firstRender && await RefreshAsync() && !_disposed)
            StateHasChanged();
    }

    private async Task<bool> RefreshAsync()
    {
        if (_refreshInFlight)
            return false;
        _refreshInFlight = true;
        try
        {
            await Task.WhenAll(RefreshHealthAsync(), RefreshAgentsAsync());
        }
        finally
        {
            _refreshInFlight = false;
        }
        _sectionVisible = _dbStatus is not null || _redisStatus is not null || _connectedCount > 0;
        return true;
    }

    private async Task RefreshHealthAsync()
    {
        try
        {
            var health = await Health.GetAsync();
            _dbStatus = health.DatabaseConnected;
            _redisStatus = health.RedisConnected;
        }
        catch
        {
            // Graceful degradation: the API is unreachable (or refused), so the database cannot be
            // reached through it. Redis keeps its last known state.
            _dbStatus = false;
        }
    }

    private async Task RefreshAgentsAsync()
    {
        try
        {
            var agents = await Agents.GetAgentsAsync();
            _totalCount = agents.Count;
            _connectedCount = agents.Count(a => a.Status != AgentStatus.Disconnected);
        }
        catch
        {
            // Graceful degradation: the counts keep their last values.
        }
    }

    private async void RefreshTick(object? state)
    {
        if (_disposed) return;
        try
        {
            await InvokeAsync(async () =>
            {
                if (_disposed || !await RefreshAsync() || _disposed) return;
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { /* Intentional: component disposed between timer tick and InvokeAsync; no action needed. */ }
    }

    public void Dispose()
    {
        _disposed = true;
        _refreshTimer?.Dispose();
    }
}
