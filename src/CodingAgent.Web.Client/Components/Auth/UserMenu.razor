@implements IDisposable
@inject CurrentAccess Access

@* Top-bar user menu (Req 9.3). Log out is a plain form post: an interactive component cannot clear the HttpOnly cookie. *@
<details class="cockpit-user-menu" data-testid="user-menu">
    <summary title="Signed in as @Access.Username">
        <Icon Name="user" Size="14" />
        <span data-testid="user-menu-name">@(Access.Username ?? "Account")</span>
    </summary>
    <div class="cockpit-user-menu-panel">
        <a href="@AuthPaths.Profile.TrimStart('/')" data-testid="user-menu-profile">Profile</a>
        <form method="post" action="@AuthPaths.Logout.TrimStart('/')" data-testid="logout-form">
            <AntiforgeryToken />
            <button type="submit" data-testid="logout-button">Log out</button>
        </form>
    </div>
</details>

@code {
    // Spec 052: the menu renders before the session has loaded and, having no parameters, is not
    // rendered again with the layout; it follows the access itself.
    protected override async Task OnInitializedAsync()
    {
        Access.Changed += OnAccessChanged;
        await Access.InitializeAsync();
    }

    private void OnAccessChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Access.Changed -= OnAccessChanged;
}
