<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!--
    Spec 051 D9, spec 052 DD1: the web UI, run in the browser as WebAssembly. It references
    Contracts only, never a server project or Api.Client. CodingAgent.Web serves it and hosts the
    static login page. RootNamespace keeps the CodingAgent.Web namespaces of the code that moved
    here in 051.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodingAgent.Web</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Number and date formatting stay invariant and no ICU data ships; ToLocalTime() keeps the
         browser's time zone (D6, DD10). -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- As in the .NET 10 Blazor Web App template: the server project serves this app's files. -->
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform analyzer flags APIs that do not work in the browser. -->
    <SupportedPlatform Include="browser" />
    <!-- Only the router names the pages, by reflection; without this root the trimmed publish
         drops Routes and every page (spec 052 B1). -->
    <TrimmerRootAssembly Include="CodingAgent.Web.Client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodingAgent.Web" />
    <InternalsVisibleTo Include="CodingAgent.Web.UnitTests" />
    <InternalsVisibleTo Include="CodingAgent.Web.IntegrationTests" />
    <InternalsVisibleTo Include="CodingAgent.Web.E2ETests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <!-- IHttpClientFactory for the typed UI clients; it also works in the browser. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- The UI hub (spec 051 D7). The .NET SignalR client also runs in the browser. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodingAgent.Contracts\CodingAgent.Contracts.csproj" />
  </ItemGroup>
</Project>
