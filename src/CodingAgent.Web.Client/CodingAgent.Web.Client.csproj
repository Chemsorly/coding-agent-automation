<Project Sdk="Microsoft.NET.Sdk.Razor">
  <!--
    Spec 051 D9: the browser-safe part of the web UI. It references Contracts only, never a server
    project or Api.Client, so the same code can later run as WebAssembly. RootNamespace keeps the
    CodingAgent.Web namespaces of the code that moves here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CodingAgent.Web</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- The platform analyzer flags APIs that do not work in the browser. -->
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CodingAgent.Web" />
    <InternalsVisibleTo Include="CodingAgent.Web.UnitTests" />
    <InternalsVisibleTo Include="CodingAgent.Web.IntegrationTests" />
    <InternalsVisibleTo Include="CodingAgent.Web.E2ETests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Components and their authorization. No FrameworkReference to ASP.NET Core: that is server-only. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <!-- IHttpClientFactory for the typed UI clients; it also works in the browser. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <!-- The UI hub (spec 051 D7). The .NET SignalR client also runs in the browser. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- Components log through Serilog's static logger; a browser host would route it to the console. -->
    <PackageReference Include="Serilog" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CodingAgent.Contracts\CodingAgent.Contracts.csproj" />
  </ItemGroup>
</Project>
