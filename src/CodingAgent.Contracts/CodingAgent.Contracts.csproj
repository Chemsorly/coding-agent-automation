<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MsgPack017: Init properties with default initializers are intentional (SignalR DTOs). -->
    <NoWarn>$(NoWarn);MsgPack017;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pipeline needs Contracts' internals during the extraction transition; UnitTests exercise them. -->
    <InternalsVisibleTo Include="CodingAgent.Pipeline" />
    <InternalsVisibleTo Include="CodingAgent.Pipeline.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts references only the leaf CodeReview contracts lib; NEVER Pipeline. It must stay browser-safe (spec 051 D9). -->
    <ProjectReference Include="..\CodingAgent.Pipeline.CodeReview\CodingAgent.Pipeline.CodeReview.csproj" />
  </ItemGroup>
</Project>
