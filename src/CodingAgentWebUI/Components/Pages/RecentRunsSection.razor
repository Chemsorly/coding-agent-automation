@using CodingAgentWebUI.Pipeline.Models
@using CodingAgentWebUI.Pipeline.Services

<section class="settings-section" style="margin: 16px 20px;">
    <div class="monitoring-section-toggle" @onclick="ToggleExpanded"
         role="button" tabindex="0">
        <h2><Icon Name="scroll-text" Size="16" /> Recent Runs (@RunHistory.Count)</h2>
        <span class="monitoring-toggle-icon">@(IsExpanded ? "▾" : "▸")</span>
    </div>
    <div style="margin: 8px 0;">
        <a href="api/export/runs.json" download class="btn-cancel" style="text-decoration: none; display: inline-block; font-size: 0.8rem; padding: 4px 12px;">
            <Icon Name="download" Size="14" /> Export All (JSON)
        </a>
        <a href="api/export/runs.json?feedbackOnly=true" download class="btn-cancel" style="text-decoration: none; display: inline-block; font-size: 0.8rem; padding: 4px 12px; margin-left: 8px;">
            <Icon Name="download" Size="14" /> Feedback Only (JSON)
        </a>
    </div>
    @if (IsExpanded)
    {
        @if (RunHistory.Count == 0)
        {
            <div class="monitoring-empty">No completed runs yet.</div>
        }
        else
        {
            <div class="monitoring-table-wrap">
                <table class="monitoring-table">
                    <thead>
                        <tr>
                            <th>Run ID</th>
                            <th>Type</th>
                            <th>Project</th>
                            <th>Issue</th>
                            <th>Agent</th>
                            <th>Result</th>
                            <th>Started</th>
                            <th>Duration</th>
                            <th>Tokens</th>
                            <th>PR</th>
                            <th>Initiated By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in RunHistory.Take(20))
                        {
                            <tr class="monitoring-row-clickable"
                                @onclick="() => OnRunSelected.InvokeAsync(run)">
                                <td class="monitoring-mono" title="@run.RunId">@run.RunId</td>
                                <td>
                                    @if (run.RunType == PipelineRunType.Review)
                                    {
                                        <span class="run-type-badge run-type-review" title="PR Review"><Icon Name="search" Size="14" /></span>
                                    }
                                    else if (run.RunType is PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition)
                                    {
                                        <span class="run-type-badge run-type-decomp" title="@(run.RunType == PipelineRunType.DecompositionAnalysis ? "Decomposition Analysis" : "Decomposition")"><Icon Name="puzzle" Size="14" /></span>
                                    }
                                    else
                                    {
                                        <span class="run-type-badge run-type-impl" title="Implementation"><Icon Name="hammer" Size="14" /></span>
                                    }
                                </td>
                                <td>@(string.IsNullOrEmpty(run.ProjectName) ? "—" : run.ProjectName)</td>
                                <td title="#@run.IssueIdentifier @run.IssueTitle">
                                    @if (run.RunType == PipelineRunType.Review)
                                    {
                                        <text>PR #@run.IssueIdentifier @run.IssueTitle</text>
                                    }
                                    else
                                    {
                                        <text>#@run.IssueIdentifier @run.IssueTitle</text>
                                    }
                                </td>
                                <td>@(run.AgentId ?? "—")</td>
                                <td>
                                    @{
                                        var result = run.FinalStep switch
                                        {
                                            PipelineStep.Completed => "Completed",
                                            PipelineStep.Failed => "Failed",
                                            PipelineStep.Cancelled => "Cancelled",
                                            _ => "Failed"
                                        };
                                        var resultClass = run.FinalStep switch
                                        {
                                            PipelineStep.Completed => "step-completed",
                                            PipelineStep.Cancelled => "step-cancelled",
                                            _ => "step-failed"
                                        };
                                    }
                                    <span class="step-badge @resultClass" title="@run.FinalStep.ToDisplayName()">
                                        @result
                                    </span>
                                </td>
                                <td title="@run.StartedAt.ToString("yyyy-MM-dd HH:mm:ss")">@FormatTimestamp(run.StartedAt)</td>
                                <td>@FormatDuration(run.StartedAt, run.CompletedAt)</td>
                                <td><span class="token-badge">@CostFormatter.FormatTokens(run.TotalTokens)</span></td>
                                <td>
                                    @if (run.RunType == PipelineRunType.Review && !string.IsNullOrEmpty(run.ReviewPrUrl))
                                    {
                                        <a href="@run.ReviewPrUrl" target="_blank" rel="noopener">PR</a>
                                    }
                                    else if (!string.IsNullOrEmpty(run.PullRequestUrl))
                                    {
                                        <a href="@run.PullRequestUrl" target="_blank" rel="noopener">PR</a>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                                <td>@run.InitiatedBy</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PipelineRunSummary> RunHistory { get; set; } = [];
    [Parameter] public bool IsExpanded { get; set; }
    [Parameter] public EventCallback<bool> IsExpandedChanged { get; set; }
    [Parameter] public EventCallback<PipelineRunSummary> OnRunSelected { get; set; }

    private async Task ToggleExpanded()
    {
        IsExpanded = !IsExpanded;
        await IsExpandedChanged.InvokeAsync(IsExpanded);
    }
}
