    // --- Secrets management ---

    private void AddSecret()
    {
        _secrets.Add(new SecretEntry());
    }

    private void RemoveSecret(int index)
    {
        if (index >= 0 && index < _secrets.Count)
        {
            _secrets.RemoveAt(index);
            var newRevealed = new HashSet<int>();
            foreach (var i in _revealedSecrets)
            {
                if (i < index) newRevealed.Add(i);
                else if (i > index) newRevealed.Add(i - 1);
            }
            _revealedSecrets = newRevealed;
        }
    }

    private void UpdateSecretKey(int index, string value)
    {
        if (index >= 0 && index < _secrets.Count)
        {
            _secrets[index].Key = value;
            _secrets[index].ValidationError = null;
        }
    }

    private void UpdateSecretValue(int index, string value)
    {
        if (index >= 0 && index < _secrets.Count)
        {
            _secrets[index].Value = value;
        }
    }

    private void ToggleSecretVisibility(int index)
    {
        if (!_revealedSecrets.Remove(index))
            _revealedSecrets.Add(index);
    }

    private bool ValidateSecrets()
    {
        if (_secrets.Count == 0) return true;

        var isValid = true;
        var seenKeys = new HashSet<string>(StringComparer.Ordinal);

        foreach (var secret in _secrets)
        {
            secret.ValidationError = null;

            if (string.IsNullOrWhiteSpace(secret.Key))
            {
                secret.ValidationError = "Key is required.";
                isValid = false;
                continue;
            }

            if (!SecretKeyPattern.IsMatch(secret.Key))
            {
                secret.ValidationError = "Key must match POSIX env var pattern (letters, digits, underscores; cannot start with digit).";
                isValid = false;
                continue;
            }

            if (!seenKeys.Add(secret.Key))
            {
                secret.ValidationError = "Duplicate key.";
                isValid = false;
            }
        }

        return isValid;
    }

    private Dictionary<string, string>? BuildSecretsDictionary()
    {
        if (_secrets.Count == 0) return null;
        var dict = new Dictionary<string, string>();
        foreach (var secret in _secrets)
        {
            if (!string.IsNullOrWhiteSpace(secret.Key))
                dict[secret.Key] = secret.Value;
        }
        return dict.Count > 0 ? dict : null;
    }

    private static IReadOnlyList<string>? ParseBlacklistedPaths(string? input)
    {
        if (input is null) return null;
        var paths = input.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Where(p => !string.IsNullOrWhiteSpace(p))
            .ToList();
        return paths.Count > 0 ? paths : null;
    }

    private void OverrideBlacklistedPaths()
    {
        _blacklistedPathsText = string.Join(",", _globalConfig.BlacklistedPaths);
    }

    private class SecretEntry
    {
        public string Key { get; set; } = "";
        public string Value { get; set; } = "";
        public string? ValidationError { get; set; }
    }

    // ── MCP Servers tab ───────────────────────────────────────────────────────

    /// <summary>
    /// Renders the MCP Servers tab. Delegates to two focused helpers to keep
    /// cognitive complexity within the S3776 limit of 15.
    /// </summary>
    private RenderFragment RenderMcpTab() => __builder =>
    {
        <div class="provider-form">
            <h3>MCP Servers</h3>
            <p class="form-hint">Project MCP servers are merged with the profile's servers at dispatch time. Servers with the same name override the profile configuration; others are added. Leave empty to use the profile's MCP servers unchanged.</p>

            @RenderMcpServerTable()
            @RenderMcpServerFormOrAddButton()

            <div class="pipeline-form-actions">
                <button class="btn-save" @onclick="SaveMcpServersAsync">Save MCP Servers</button>
            </div>
        </div>
    };

    /// <summary>
    /// Renders the server list table when at least one MCP server is configured.
    /// Renders nothing when the server list is empty.
    /// </summary>
    private RenderFragment RenderMcpServerTable() => __builder =>
    {
        @if (_mcpServers.Count > 0)
        {
            <div class="monitoring-table-wrap" style="margin-bottom: 8px;">
                <table class="monitoring-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th>Command / URL</th>
                            <th>Enabled</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var (server, idx) in _mcpServers.Select((s, i) => (s, i)))
                        {
                            <tr>
                                <td class="monitoring-mono">@server.Name</td>
                                <td>@server.Type</td>
                                <td class="monitoring-mono">@(server.Type == "http" ? server.Url : $"{server.Command} {server.Args}".Trim())</td>
                                <td>@(server.Enabled ? "✓" : "✗")</td>
                                <td>
                                    <button class="btn-edit" @onclick="() => EditMcpServer(idx)">Edit</button>
                                    <button class="btn-delete" @onclick="() => RemoveMcpServer(idx)">Remove</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    };

    /// <summary>
    /// Renders either the add/edit form (when _showMcpForm is true) or the
    /// "+ Add MCP Server" button (when _showMcpForm is false).
    /// </summary>
    private RenderFragment RenderMcpServerFormOrAddButton() => __builder =>
    {
        @if (_showMcpForm)
        {
            <div class="provider-form" style="margin-top: 8px; padding: 12px; border: 1px solid var(--border-color, #ddd); border-radius: 4px;">
                <h4 style="margin-top: 0;">@(_editingMcpIndex >= 0 ? "Edit" : "Add") MCP Server</h4>
                <div class="form-group">
                    <label>Name *</label>
                    <input type="text" @bind="_mcpForm.Name" placeholder="e.g. context7" />
                </div>
                <div class="form-group">
                    <label>Type</label>
                    <select @bind="_mcpForm.Type">
                        <option value="stdio">stdio (command-based)</option>
                        <option value="http">HTTP (URL-based)</option>
                    </select>
                </div>
                @if (_mcpForm.Type == "http")
                {
                    <div class="form-group">
                        <label>URL *</label>
                        <input type="text" @bind="_mcpForm.Url" placeholder="e.g. https://mcp.context7.com/mcp" />
                    </div>
                    <div class="form-group">
                        <label>Headers <span class="form-hint">(one per line, KEY=VALUE — use for auth tokens)</span></label>
                        <textarea rows="3" @bind="_mcpForm.Headers" @bind:event="oninput" placeholder="Authorization=Bearer mytoken&#10;X-Org=myorg"></textarea>
                    </div>
                }
                else
                {
                    <div class="form-group">
                        <label>Command *</label>
                        <input type="text" @bind="_mcpForm.Command" placeholder="e.g. uvx" />
                    </div>
                    <div class="form-group">
                        <label>Arguments <span class="form-hint">(space-separated)</span></label>
                        <input type="text" @bind="_mcpForm.Args" placeholder="e.g. context7-mcp@latest" />
                    </div>
                    <div class="form-group">
                        <label>Environment Variables <span class="form-hint">(one per line, KEY=VALUE)</span></label>
                        <textarea rows="3" @bind="_mcpForm.EnvVars" @bind:event="oninput" placeholder="FASTMCP_LOG_LEVEL=ERROR"></textarea>
                    </div>
                }
                <div class="form-group form-checkbox">
                    <label>
                        <input type="checkbox" @bind="_mcpForm.Enabled" />
                        Enabled
                    </label>
                </div>
                <div class="form-buttons">
                    <button class="btn-save" @onclick="SaveMcpServer">Save Server</button>
                    <button class="btn-cancel" @onclick="() => _showMcpForm = false">Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div style="display: flex; gap: 8px; margin-top: 4px;">
                <button class="btn-add" @onclick="ShowAddMcpForm">+ Add MCP Server</button>
            </div>
        }
    };

    private void ShowAddMcpForm()
    {
        _editingMcpIndex = -1;
        _mcpForm = new McpServerFormModel();
        _showMcpForm = true;
    }

    private void EditMcpServer(int index)
    {
        _editingMcpIndex = index;
        var server = _mcpServers[index];
        _mcpForm = new McpServerFormModel
        {
            Name = server.Name,
            Type = server.Type,
            Command = server.Command,
            Args = server.Args,
            Url = server.Url,
            EnvVars = server.EnvVars,
            Headers = server.Headers,
            Enabled = server.Enabled
        };
        _showMcpForm = true;
    }

    private void RemoveMcpServer(int index)
    {
        _mcpServers.RemoveAt(index);
    }

    private void SaveMcpServer()
    {
        if (string.IsNullOrWhiteSpace(_mcpForm.Name))
            return;

        if (_mcpForm.Type == "http" && string.IsNullOrWhiteSpace(_mcpForm.Url))
            return;
        if (_mcpForm.Type != "http" && string.IsNullOrWhiteSpace(_mcpForm.Command))
            return;

        var entry = new McpServerFormModel
        {
            Name = _mcpForm.Name.Trim(),
            Type = _mcpForm.Type,
            Command = _mcpForm.Command?.Trim() ?? "",
            Args = _mcpForm.Args?.Trim() ?? "",
            Url = _mcpForm.Url?.Trim() ?? "",
            EnvVars = _mcpForm.EnvVars?.Trim() ?? "",
            Headers = _mcpForm.Headers?.Trim() ?? "",
            Enabled = _mcpForm.Enabled
        };

        if (_editingMcpIndex >= 0)
            _mcpServers[_editingMcpIndex] = entry;
        else
            _mcpServers.Add(entry);

        _showMcpForm = false;
        _editingMcpIndex = -1;
    }

    private async Task SaveMcpServersAsync()
    {
        try
        {
            var servers = _mcpServers.Select(s =>
            {
                string? command;
                if (s.Type == "http") command = null;
                else if (string.IsNullOrWhiteSpace(s.Command)) command = null;
                else command = s.Command.Trim();
                return new McpServerConfig
                {
                    Name = s.Name.Trim(),
                    Type = s.Type,
                    Command = command,
                    Args = string.IsNullOrWhiteSpace(s.Args) ? [] : s.Args.Split(' ', StringSplitOptions.RemoveEmptyEntries).ToList(),
                    Url = s.Type == "http" ? s.Url.Trim() : null,  // TODO [WARNING]: s.Url could be null if a future McpServerFormModel is constructed without enforcing the "" default; consider s.Url?.Trim() ?? "" for defensive safety.
                    Env = ParseMcpEnvVars(s.EnvVars),
                    Headers = s.Type == "http" ? ParseMcpEnvVars(s.Headers) : new Dictionary<string, string>(),
                    Disabled = !s.Enabled,
                    AutoApprove = []
                };
            }).ToList();

            _project = _project with { McpServers = servers.Count > 0 ? servers : null };
            await ConfigStore.SaveProjectAsync(_project, CancellationToken.None);
            await OnProjectSaved.InvokeAsync();
            await OnShowStatus.InvokeAsync(("Project MCP servers saved.", false));
        }
        catch (Exception ex)
        {
            await OnShowStatus.InvokeAsync(($"Failed to save: {ex.Message}", true));
        }
    }

    private static IReadOnlyDictionary<string, string> ParseMcpEnvVars(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return new Dictionary<string, string>();
        var dict = new Dictionary<string, string>();
        foreach (var line in input.Split('\n', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var eqIdx = line.IndexOf('=');
            if (eqIdx > 0)
                dict[line[..eqIdx].Trim()] = line[(eqIdx + 1)..].Trim();
        }
        return dict;
    }

    private sealed class McpServerFormModel
    {
        public string Name { get; set; } = "";
        public string Type { get; set; } = "stdio";
        public string Command { get; set; } = "";
        public string Args { get; set; } = "";
        public string Url { get; set; } = "";
        public string EnvVars { get; set; } = "";
        public string Headers { get; set; } = "";
        public bool Enabled { get; set; } = true;
    }
}
