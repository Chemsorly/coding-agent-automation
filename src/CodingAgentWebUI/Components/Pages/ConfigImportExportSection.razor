@using CodingAgentWebUI.Api.Client
@using Microsoft.AspNetCore.Components.Forms
@inject IPipelineApiConfigClient ConfigClient
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="section-content">
    <h2>Data Management</h2>
    <p class="section-description">
        Export configuration as a single JSON file (download) or import from an uploaded JSON file.
        Covers pipeline config, providers, profiles, quality gates, reviewers, and projects.
        Run history and consolidation runs are excluded.
    </p>

    <div class="import-export-actions">
        <div class="action-card">
            <h3>Export Configuration</h3>
            <p>
                Download the current database configuration as a single JSON file.
            </p>
            <p>
                The file contains <strong>provider credentials in plain text</strong> so that
                importing it restores a working system. Store it as a secret.
            </p>
            <button class="btn btn-secondary" @onclick="ExportAsync" disabled="@_exporting">
                @if (_exporting)
                {
                    <span class="spinner-sm"></span>
                }
                Download Config
            </button>
        </div>

        <div class="action-card">
            <h3>Import Configuration</h3>
            <p>
                Upload a previously exported JSON file to replace all configuration in the database.
                This <strong>overwrites</strong> existing config. All previous configuration is permanently deleted before import.
            </p>
            <InputFile OnChange="OnFileSelected" accept=".json" />
            @if (_selectedFile is not null)
            {
                <button class="btn btn-primary" @onclick="ImportAsync" disabled="@_loading">
                    @if (_loading)
                    {
                        <span class="spinner-sm"></span>
                    }
                    Import @_selectedFile.Name
                </button>
            }
        </div>
    </div>

    @if (_resultMessage is not null)
    {
        <div class="result-message @(_resultSuccess ? "success" : "error")">
            @_resultMessage
        </div>
    }
</div>

@code {
    [Parameter]
    public EventCallback<(string Message, bool IsError)> OnShowStatus { get; set; }

    [Parameter]
    public EventCallback OnImportCompleted { get; set; }

    private IBrowserFile? _selectedFile;
    private bool _loading;
    private bool _exporting;
    private string? _resultMessage;
    private bool _resultSuccess;

    private async Task ExportAsync()
    {
        _exporting = true;
        _resultMessage = null;
        StateHasChanged();

        try
        {
            // GET /api/config/export on the Pipeline API. Operator-tier only; the payload
            // carries unredacted provider credentials so it can be imported back.
            var bytes = await ConfigClient.ExportConfigAsync(CancellationToken.None);

            using var stream = new MemoryStream(bytes);
            using var streamRef = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("downloadFileFromStream", "pipeline-config-export.json", streamRef);

            _resultSuccess = true;
            _resultMessage = "Export downloaded successfully.";
            await OnShowStatus.InvokeAsync((_resultMessage, false));
        }
        catch (Exception ex)
        {
            _resultSuccess = false;
            _resultMessage = $"Export failed: {ex.Message}";
            await OnShowStatus.InvokeAsync((_resultMessage, true));
        }
        finally
        {
            _exporting = false;
            StateHasChanged();
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _resultMessage = null;
    }

    private const long MaxImportFileSizeBytes = 8 * 1024 * 1024; // 8 MB (Sonar S5693 threshold)

    private async Task ImportAsync()
    {
        if (_selectedFile is null) return;

        _loading = true;
        _resultMessage = null;
        StateHasChanged();

        try
        {
            // Reject files exceeding the maximum allowed size before reading any content (S5693)
            if (_selectedFile.Size > MaxImportFileSizeBytes)
            {
                _resultSuccess = false;
                _resultMessage = $"File too large: {_selectedFile.Size / (1024 * 1024)} MB. Maximum allowed size is 8 MB.";
                await OnShowStatus.InvokeAsync((_resultMessage, true));
                return;
            }

            // Read the file content (Blazor Server — file streams from browser to server)
            using var stream = _selectedFile.OpenReadStream(maxAllowedSize: MaxImportFileSizeBytes);

            // POST /api/config/import on the Pipeline API — multipart/form-data, file field "file".
            // Import is DESTRUCTIVE: the server clears all existing config before importing.
            await ConfigClient.ImportConfigAsync(stream, _selectedFile.Name, CancellationToken.None);

            _resultSuccess = true;
            _resultMessage = "Import completed successfully.";
            await OnShowStatus.InvokeAsync((_resultMessage, false));
            await OnImportCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            _resultSuccess = false;
            _resultMessage = $"Import failed: {ex.Message}";
            await OnShowStatus.InvokeAsync((_resultMessage, true));
        }
        finally
        {
            _loading = false;
            _selectedFile = null;
            StateHasChanged();
        }
    }
}
