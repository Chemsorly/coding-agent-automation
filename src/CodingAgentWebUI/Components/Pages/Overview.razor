@page "/overview"
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgentWebUI.Api.Client
@using CodingAgentWebUI.Pipeline.Interfaces
@using CodingAgentWebUI.Pipeline.Models
@using CodingAgentWebUI.Pipeline.Services
@using CodingAgentWebUI.Services
@using CodingAgentWebUI.Components.Shared
@using Microsoft.AspNetCore.SignalR.Client
@inject ILoopStatusService LoopService
@inject IPipelineApiRunHistoryClient RunHistory
@inject IPipelineApiAgentClient AgentClient
@inject IPipelineApiWorkItemClient WorkItems
@inject CockpitState State
@inject NavigationManager Nav
@inject IAgentHubConnection HubConnection

@*
    Overview — the cockpit landing (see docs/frontend-redesign-handoff.md).
    Loop status is read-only here (control lives in Pipelines). Stats are computed from the
    fetched run page and labelled "recent" — a true 24h aggregate needs a stats endpoint.
*@

<PageTitle>Overview - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Overview</h1>
            <span class="cockpit-page-sub">Fleet status at a glance</span>
        </div>
        <RefreshBar OnRefresh="RefreshDataAsync" />
    </div>

    <!-- loop status hero -->
    <div class="cockpit-card cockpit-card-pad" style="display: flex; align-items: center; justify-content: space-between; gap: 20px;">
        <div style="display: flex; align-items: center; gap: 14px;">
            <span style="width: 40px; height: 40px; border-radius: 11px; display: flex; align-items: center; justify-content: center; background: @LoopIconBg; color: @LoopIconColor;">
                <Icon Name="refresh-cw" Size="20" />
            </span>
            <div style="display: flex; flex-direction: column; gap: 3px;">
                <span style="font-size: 15px; font-weight: 700;">@LoopTitle</span>
                <span style="font-size: 12.5px; color: var(--text-muted);">@LoopSubtitle</span>
            </div>
        </div>
        <a href="/pipelines" class="cockpit-pager-btn" style="text-decoration: none;">Manage <Icon Name="chevrons-right" Size="14" /></a>
    </div>

    <!-- stat strip -->
    <div class="cockpit-stat-strip">
        <div class="cockpit-stat"><span class="cockpit-stat-l">Active</span><span class="cockpit-stat-v">@_activeCount</span></div>
        <div class="cockpit-stat"><span class="cockpit-stat-l">Queue</span><span class="cockpit-stat-v">@_queueCount</span></div>
        <div class="cockpit-stat"><span class="cockpit-stat-l">Agents</span><span class="cockpit-stat-v">@_agentsOnline<span style="font-size: 15px; color: var(--text-faint);">/@_agentsTotal</span></span></div>
        <div class="cockpit-stat">
            <span class="cockpit-stat-l">Success · <select class="time-window-select" @bind="_recentWindowHours" @bind:after="RefreshDataAsync" title="Time window for recent metrics">
                <option value="1">1h</option>
                <option value="6">6h</option>
                <option value="24">24h</option>
                <option value="168">7d</option>
            </select></span>
            <span class="cockpit-stat-v">@(_finishedCount > 0 ? $"{_successRate}%" : "—")</span>
        </div>
        <div class="cockpit-stat"><span class="cockpit-stat-l">Tokens · @RecentWindowLabel</span><span class="cockpit-stat-v">@CostFormatter.FormatTokens(_tokensRecent)</span></div>
    </div>

    @if (_attnNeedsRefinement + _attnFailed + _attnPlans > 0)
    {
        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Needs attention</h2><a href="/attention" style="font-size: 12.5px; font-weight: 600;">View all →</a></div>
            <div style="display: grid; grid-template-columns: repeat(3, 1fr);">
                <a href="/attention" style="display: flex; align-items: center; gap: 11px; padding: 14px 18px; border-right: 1px solid var(--hairline); text-decoration: none; color: inherit;">
                    <span style="width: 34px; height: 34px; border-radius: 9px; background: var(--warning-bg); color: var(--warning); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon Name="alert-triangle" Size="17" /></span>
                    <div><div style="font-size: 18px; font-weight: 800;">@_attnNeedsRefinement</div><div style="font-size: 12px; color: var(--text-muted);">Needs refinement</div></div>
                </a>
                <a href="/attention" style="display: flex; align-items: center; gap: 11px; padding: 14px 18px; border-right: 1px solid var(--hairline); text-decoration: none; color: inherit;">
                    <span style="width: 34px; height: 34px; border-radius: 9px; background: var(--error-bg); color: var(--error); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon Name="x-circle" Size="17" /></span>
                    <div><div style="font-size: 18px; font-weight: 800;">@_attnFailed</div><div style="font-size: 12px; color: var(--text-muted);">Failed runs</div></div>
                </a>
                <a href="/attention" style="display: flex; align-items: center; gap: 11px; padding: 14px 18px; text-decoration: none; color: inherit;">
                    <span style="width: 34px; height: 34px; border-radius: 9px; background: var(--bg-active); color: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><Icon Name="puzzle" Size="17" /></span>
                    <div><div style="font-size: 18px; font-weight: 800;">@_attnPlans</div><div style="font-size: 12px; color: var(--text-muted);">Plans to approve</div></div>
                </a>
            </div>
        </div>
    }

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; align-items: start;">
        <!-- active runs -->
        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Active runs</h2><span style="font-size: 12px; color: var(--text-muted);">@_activeRuns.Count</span></div>
            @if (_activeRuns.Count == 0)
            {
                <div class="cockpit-empty" style="padding: 24px;">No runs in flight.</div>
            }
            else
            {
                @foreach (var run in _activeRuns.Take(5))
                {
                    <div class="cockpit-run-row" @onclick="() => OpenRun(run.RunId)">
                        <div style="min-width: 0;">
                            <div style="font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">#@run.IssueIdentifier @run.IssueTitle</div>
                            <div class="mono" style="font-size: 11px; color: var(--text-muted);">@(run.AgentId ?? "—") · @run.FinalStep.ToDisplayName()</div>
                        </div>
                        <span class="step-badge step-running" style="flex-shrink: 0;">Running</span>
                    </div>
                }
            }
        </div>

        <!-- recent activity -->
        <div class="cockpit-card">
            <div class="cockpit-card-header"><h2>Recent activity</h2><a href="/runs" style="font-size: 12.5px; font-weight: 600;">All runs →</a></div>
            @if (_recentRuns.Count == 0)
            {
                <div class="cockpit-empty" style="padding: 24px;">No completed runs yet.</div>
            }
            else
            {
                @foreach (var run in _recentRuns.Take(6))
                {
                    var cls = run.FinalStep switch
                    {
                        PipelineStep.Completed => "step-completed",
                        PipelineStep.Cancelled => "step-cancelled",
                        _ => "step-failed"
                    };
                    var label = run.FinalStep switch
                    {
                        PipelineStep.Completed => "Completed",
                        PipelineStep.Cancelled => "Cancelled",
                        _ => "Failed"
                    };
                    <div class="cockpit-run-row" @onclick="() => OpenRun(run.RunId)">
                        <div style="min-width: 0;">
                            <div style="font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">#@run.IssueIdentifier @run.IssueTitle</div>
                            <div class="mono" style="font-size: 11px; color: var(--text-muted);">@(run.AgentId ?? "—") · @CostFormatter.FormatTokens(run.TotalTokens)</div>
                        </div>
                        <span class="step-badge @cls" style="flex-shrink: 0;">@label</span>
                    </div>
                }
            }
        </div>
    </div>
</div>

@code {
    private readonly CancellationTokenSource _cts = new();

    private int _activeCount;
    private int _queueCount;
    private int _agentsOnline;
    private int _agentsTotal;
    private int _finishedCount;
    private int _successRate;
    private long _tokensRecent;
    private int _attnNeedsRefinement, _attnFailed, _attnPlans;
    private List<PipelineRunSummary> _activeRuns = new();
    private List<PipelineRunSummary> _recentRuns = new();

    // Time window for "recent" metrics. Default 24h; session-persisted via field (resets on page reload).
    private int _recentWindowHours = 24;

    // Hub subscriptions — disposed in DisposeAsync.
    private IDisposable? _stepSub;
    private IDisposable? _completedSub;
    private bool _hubSubscribed;

    // TODO: [WARNING] This switch has no arm for 0 (unlike Insights, which supports an "All" option).
    // If _recentWindowHours is ever set to 0 (e.g. by a future code path copying Insights' enum),
    // the _ default arm returns "24h", silently producing wrong UI text next to the Tokens metric.
    // Fix: add a 0 => "All" arm, or restrict the dropdown options to exclude 0 on this page.
    private string RecentWindowLabel => _recentWindowHours switch
    {
        1 => "1h",
        6 => "6h",
        168 => "7d",
        _ => "24h"
    };

    protected override void OnInitialized()
    {
        LoopService.OnChange += HandleLoopChanged;
        State.OnProjectChanged += HandleProjectChanged;
    }

    protected override async Task OnInitializedAsync() => await RefreshDataAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_hubSubscribed)
            await SubscribeHubAsync();
    }

    // Subscribe to hub run-state events so the page refreshes immediately when any run
    // transitions step or completes — rather than waiting for the auto-refresh timer.
    // Uses the shared IAgentHubConnection (one connection per Blazor circuit, not per page).
    // The handlers are registered globally on the connection; they fire for any run group
    // the connection is subscribed to (e.g. from RunPage open in the same circuit).
    // Even without a SubscribeToRun call here the registration ensures the page reacts
    // as soon as the user also has a run page open, and is the correct hook point if a
    // global "any run changed" broadcast is added to the hub in the future.
    private async Task SubscribeHubAsync()
    {
        // TODO: [WARNING] _hubSubscribed is set to true before the try block. If HubConnection.StartAsync
        // throws (e.g. network unreachable on first render), the exception is caught and swallowed but
        // _hubSubscribed remains true, permanently preventing any retry of hub subscription for this
        // component instance. The RefreshBar polling fallback still works, but hub-based push is silently
        // disabled forever after one transient failure. Fix: move `_hubSubscribed = true` inside the try
        // block, or reset it to false in the catch so OnAfterRenderAsync retries on the next render.
        _hubSubscribed = true;
        try
        {
            _stepSub = HubConnection.On<string, PipelineStep, DateTimeOffset>(
                HubMethodNames.OnStepTransition, (_, _, _) => OnRunStateChanged());
            _completedSub = HubConnection.On<string, JobCompletionPayload>(
                HubMethodNames.OnRunCompleted, (_, _) => OnRunStateChanged());

            if (HubConnection.State == HubConnectionState.Disconnected)
                await HubConnection.StartAsync(_cts.Token);
        }
        catch (Exception ex)
        {
            // Hub subscription is best-effort — the RefreshBar polling fallback still works.
            Serilog.Log.Debug(ex, "Overview: failed to subscribe to hub events");
        }
    }

    // Called on any hub run-state event. Schedules a quiet data refresh on the Blazor circuit.
    private void OnRunStateChanged()
    {
        // TODO: [WARNING] OnStepTransition and OnRunCompleted are sent only to run-specific SignalR groups
        // (run-{jobId}). This page never calls SubscribeToRun, so these handlers fire only if the same
        // Blazor circuit also has a RunPage open that is subscribed to that specific run group. For a
        // standalone Overview page with no RunPage open, no push events are ever delivered and the page
        // relies entirely on manual/auto-refresh polling. A global "any run changed" broadcast on the hub
        // would make this reactive path work unconditionally without per-run group membership.
        _ = InvokeAsync(async () =>
        {
            try
            {
                await RefreshDataAsync();
                StateHasChanged();
            }
            catch (ObjectDisposedException) { }
        });
    }

    // Re-fetch when the top-bar project scope changes.
    private async void HandleProjectChanged()
    {
        try
        {
            await RefreshDataAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    // Re-fetched on load and on each auto-refresh tick. Degrades quietly (keeps prior values).
    private async Task RefreshDataAsync()
    {
        // Agents
        try
        {
            var agents = await AgentClient.GetAgentsAsync(_cts.Token);
            _agentsTotal = agents.Count;
            _agentsOnline = agents.Count(a => a.Status != AgentStatus.Disconnected);
        }
        catch (OperationCanceledException) { return; }
        catch { /* degrade — leave zeros */ }

        // Queue (pending work items)
        try
        {
            var pending = await WorkItems.GetPendingAsync(maxResults: 100, projectId: State.SelectedProjectId, ct: _cts.Token);
            _queueCount = pending.Count;
        }
        catch (OperationCanceledException) { return; }
        catch { }

        // Runs — one page, active + recent, aggregated client-side
        try
        {
            // TODO: [WARNING] pageSize: 50 caps the history. For wide windows (e.g. 7d) on busy systems,
            // runs older than the newest 50 are silently excluded, causing the windowed metrics to undercount.
            // Fix requires either server-side date filtering or a larger page size.
            var runs = await RunHistory.GetRunHistoryAsync(page: 1, pageSize: 50, feedbackOnly: false, includeActive: true, projectId: State.SelectedProjectId, ct: _cts.Token);
            var items = runs.Items;

            _activeRuns = items.Where(IsActive).ToList();
            _recentRuns = items.Where(r => !IsActive(r)).ToList();
            _activeCount = _activeRuns.Count;

            // "Recent" window: only completed runs within the selected time window.
            var windowCutoff = DateTimeOffset.UtcNow.AddHours(-_recentWindowHours);
            var finished = _recentRuns.Where(r => r.StartedAtOffset >= windowCutoff).ToList();
            _finishedCount = finished.Count;
            var succeeded = finished.Count(r => r.FinalStep == PipelineStep.Completed);
            _successRate = _finishedCount > 0 ? (int)Math.Round(100.0 * succeeded / _finishedCount) : 0;
            // TODO: [WARNING] _tokensRecent previously summed all items including active runs; it now sums only
            // completed runs in the selected window. This is a silent semantic change: tokens from long-running
            // active jobs that started before the window cutoff are no longer counted. The change is likely
            // intentional (windowed "recent" should be consistent), but it is untested and undocumented.
            _tokensRecent = finished.Sum(r => r.TotalTokens);

            _attnNeedsRefinement = items.Count(r => r.AnalysisRecommendation == AnalysisGateResult.NotReady);
            _attnFailed = items.Count(r => r.FinalStep == PipelineStep.Failed);
            _attnPlans = items.Count(r => r.RunType == PipelineRunType.DecompositionAnalysis && r.FinalStep == PipelineStep.Completed);
        }
        catch (OperationCanceledException) { return; }
        catch { }
    }

    private static bool IsActive(PipelineRunSummary r)
        => r.FinalStep is not PipelineStep.Completed and not PipelineStep.Failed and not PipelineStep.Cancelled;

    private void OpenRun(string runId) => Nav.NavigateTo($"/runs/{runId}");

    // ── loop hero (read-only) ───────────────────────────────────────────────
    private string LoopTitle => LoopService.IsSchedulerUnreachable ? "Scheduler unavailable"
        : LoopService.IsCircuitBroken ? "Loop paused — circuit broken"
        : LoopService.IsLoopActive ? "Closed-loop active" : "Loop idle";

    private string LoopSubtitle
    {
        get
        {
            if (LoopService.IsSchedulerUnreachable) return "Loop controls are disabled until the scheduler is reachable.";
            if (LoopService.IsLoopActive)
                return $"Polling template {LoopService.CurrentCycleTemplateIndex + 1} of {LoopService.CurrentCycleTemplateCount} · processed {LoopService.ProcessedCount} · failed {LoopService.FailedCount}";
            return "Start the closed loop from Pipelines to auto-dispatch queued work.";
        }
    }

    private string LoopIconBg => LoopService.IsSchedulerUnreachable || LoopService.IsCircuitBroken ? "var(--warning-bg)"
        : LoopService.IsLoopActive ? "var(--bg-info)" : "var(--surface-alt)";
    private string LoopIconColor => LoopService.IsSchedulerUnreachable || LoopService.IsCircuitBroken ? "var(--warning)"
        : LoopService.IsLoopActive ? "#0E7490" : "var(--text-muted)";

    private async void HandleLoopChanged()
    {
        try { await InvokeAsync(StateHasChanged); }
        catch (ObjectDisposedException) { }
    }

    public async ValueTask DisposeAsync()
    {
        LoopService.OnChange -= HandleLoopChanged;
        State.OnProjectChanged -= HandleProjectChanged;
        _stepSub?.Dispose();
        _completedSub?.Dispose();
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
