@page "/runs"
@layout CockpitLayout
@implements IAsyncDisposable
@using CodingAgentWebUI.Api.Client
@using CodingAgentWebUI.Pipeline.Models
@using CodingAgentWebUI.Pipeline.Services
@using CodingAgentWebUI.Services
@using CodingAgentWebUI.Components.Shared
@inject IPipelineApiRunHistoryClient RunHistory
@inject CockpitState State
@inject NavigationManager Nav

@*
    Runs — the list behind the Run Page (see docs/frontend-redesign-handoff.md).
    Data: IPipelineApiRunHistoryClient.GetRunHistoryAsync → PagedResult<PipelineRunSummary>.
    Consolidation runs are PipelineRunType.Consolidation and appear here folded in.

    Issue #2328: Removed Agent column; added Links column (issue URL + PR URL);
    added sortable headers (Result, Type, Duration, When — client-side, current page);
    added Result and Type filter dropdowns; sort state persisted in URL query param.
*@

<PageTitle>Runs - Coding Agent</PageTitle>

<div class="cockpit-page">
    <div class="cockpit-page-header">
        <div class="cockpit-page-titles">
            <h1>Runs</h1>
            <span class="cockpit-page-sub">Every dispatch — implementation, review, decomposition, and consolidation</span>
        </div>
    </div>

    <div class="cockpit-toolbar">
        <div class="cockpit-segmented" role="tablist" aria-label="Filter runs by outcome">
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.All ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.All)" @onclick="() => SetOutcome(OutcomeFilter.All)">All</button>
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.Completed ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.Completed)" @onclick="() => SetOutcome(OutcomeFilter.Completed)">Completed</button>
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.Failed ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.Failed)" @onclick="() => SetOutcome(OutcomeFilter.Failed)">Failed</button>
            <button class="cockpit-seg-btn @(_outcome == OutcomeFilter.Cancelled ? "is-active" : "")" role="tab" aria-selected="@(_outcome == OutcomeFilter.Cancelled)" @onclick="() => SetOutcome(OutcomeFilter.Cancelled)">Cancelled</button>
        </div>
        <label class="cockpit-filter-toggle @(_feedbackOnly ? "is-on" : "")">
            <input type="checkbox" checked="@_feedbackOnly" @onchange="ToggleFeedbackOnly" />
            Feedback only
        </label>
    </div>

    <AutoRefresh IntervalSeconds="12" OnTick="RefreshQuietAsync" />

    <div class="cockpit-card">
        @if (_loading)
        {
            <div class="cockpit-empty">Loading runs…</div>
        }
        else if (_error is not null)
        {
            <div class="cockpit-empty">@_error</div>
        }
        else if (_result is null || _result.Items.Count == 0)
        {
            <div class="cockpit-empty">No @(_outcome == OutcomeFilter.All ? "" : _outcome.ToString().ToLowerInvariant() + " ")runs@(_feedbackOnly ? " with feedback" : "") yet.</div>
        }
        else
        {
            <div class="monitoring-table-wrap">
                <table class="monitoring-table">
                    <colgroup>
                        <col style="width: 110px;" />  @* Result *@
                        <col style="width: 130px;" />  @* Type *@
                        <col />                         @* Run (flexible) *@
                        <col style="width: 100px;" />  @* Duration *@
                        <col style="width: 90px;" />   @* Tokens *@
                        <col style="width: 110px;" />  @* When *@
                        <col style="width: 90px;" />   @* Links *@
                    </colgroup>
                    <thead>
                        <tr>
                            @* ── Result column: sortable + filter ───────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.Result))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.Result)">
                                    Result @SortIndicatorForResult
                                </button>
                                <select class="column-filter" aria-label="Filter by Result"
                                        value="@_resultFilter"
                                        @onchange="e => _resultFilter = e.Value?.ToString() ?? string.Empty">
                                    <option value="">All</option>
                                    <option value="Completed">Completed</option>
                                    <option value="Failed">Failed</option>
                                    <option value="Cancelled">Cancelled</option>
                                    <option value="Running">Running</option>
                                </select>
                            </th>
                            @* ── Type column: sortable + filter ─────────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.Type))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.Type)">
                                    Type @SortIndicatorForType
                                </button>
                                <select class="column-filter" aria-label="Filter by Type"
                                        value="@_typeFilter"
                                        @onchange="e => _typeFilter = e.Value?.ToString() ?? string.Empty">
                                    <option value="">All</option>
                                    <option value="Implementation">Implementation</option>
                                    <option value="Review">Review</option>
                                    <option value="Decomposition">Decomposition</option>
                                    <option value="Consolidation">Consolidation</option>
                                </select>
                            </th>
                            <th>Run</th>
                            @* ── Duration column: sortable ───────────────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.Duration))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.Duration)">
                                    Duration @SortIndicatorForDuration
                                </button>
                            </th>
                            <th>Tokens</th>
                            @* ── When column: sortable ───────────────────────────────────────────── *@
                            <th class="@(ActiveSortClass(SortColumn.When))">
                                <button class="sort-header" @onclick="() => ToggleSort(SortColumn.When)">
                                    When @SortIndicatorForWhen
                                </button>
                            </th>
                            <th>Links</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in FilteredSortedRuns())
                        {
                            var resultLabel = run.FinalStep switch
                            {
                                PipelineStep.Completed => "Completed",
                                PipelineStep.Failed => "Failed",
                                PipelineStep.Cancelled => "Cancelled",
                                _ => "Running"
                            };
                            var resultClass = run.FinalStep switch
                            {
                                PipelineStep.Completed => "step-completed",
                                PipelineStep.Cancelled => "step-cancelled",
                                PipelineStep.Failed => "step-failed",
                                _ => "step-running"
                            };
                            var runTypeLabel = run.RunType switch
                            {
                                PipelineRunType.Review => "Review",
                                PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition => "Decomposition",
                                PipelineRunType.Consolidation => "Consolidation",
                                _ => "Implementation"
                            };
                            <tr class="monitoring-row-clickable" @onclick="() => OpenRun(run.RunId)">
                                <td>
                                    <span class="step-badge @resultClass" title="@run.FinalStep.ToDisplayName()">@resultLabel</span>
                                </td>
                                <td>
                                    @if (run.RunType == PipelineRunType.Review)
                                    {
                                        <span class="run-type-badge run-type-review" title="PR Review"><Icon Name="search" Size="14" /> Review</span>
                                    }
                                    else if (run.RunType is PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition)
                                    {
                                        <span class="run-type-badge run-type-decomp" title="@(run.RunType == PipelineRunType.DecompositionAnalysis ? "Decomposition Analysis" : "Decomposition")"><Icon Name="puzzle" Size="14" /> Decomp</span>
                                    }
                                    else if (run.RunType == PipelineRunType.Consolidation)
                                    {
                                        <span class="run-type-badge run-type-consolidation" title="Consolidation"><Icon Name="refresh-cw" Size="14" /> Consolidation</span>
                                    }
                                    else
                                    {
                                        <span class="run-type-badge run-type-impl" title="Implementation"><Icon Name="hammer" Size="14" /> Impl</span>
                                    }
                                </td>
                                <td>
                                    <span style="font-weight: 600;">@(run.RunType == PipelineRunType.Review ? "PR " : "")#@run.IssueIdentifier</span>
                                    <span style="color: var(--text-muted);">@Truncate(run.IssueTitle, 60)</span>
                                </td>
                                <td>@Dur(run.StartedAtOffset, run.CompletedAtOffset)</td>
                                <td><span class="token-badge">@CostFormatter.FormatTokens(run.TotalTokens)</span></td>
                                <td title="@run.StartedAtOffset.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")">@Ago(run.StartedAtOffset)</td>
                                <td class="runs-links-cell" @onclick:stopPropagation="true">
                                    @if (!string.IsNullOrEmpty(run.IssueUrl))
                                    {
                                        @* TODO: Validate that IssueUrl starts with https:// before rendering as href.
                                           Blazor HTML-encodes attribute values but does NOT strip javascript: URI schemes,
                                           so a malicious/corrupted record could produce a clickable XSS link. *@
                                        <a href="@run.IssueUrl" target="_blank" rel="noopener noreferrer" class="runs-link" title="Open issue #@run.IssueIdentifier">
                                            <Icon Name="message-square" Size="13" /> #@run.IssueIdentifier
                                        </a>
                                    }
                                    @* TODO: For PipelineRunType.Review runs, PullRequestUrl is typically null — the PR being
                                       reviewed is carried in ReviewPrUrl instead. Currently Review run rows show no PR link in
                                       the Links cell even though a URL is available. Consider falling back to ReviewPrUrl when
                                       PullRequestUrl is null and the run is a Review type. *@
                                    @if (!string.IsNullOrEmpty(run.PullRequestUrl))
                                    {
                                        @* TODO: Validate that PullRequestUrl starts with https:// before rendering as href.
                                           Same javascript: URI injection risk as IssueUrl above. *@
                                        <a href="@run.PullRequestUrl" target="_blank" rel="noopener noreferrer" class="runs-link runs-link-pr" title="Open pull request">
                                            <Icon Name="git-pull-request" Size="13" /> PR
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="cockpit-pager">
        @* TODO: The pager "N shown" count uses _result.Items.Count (unfiltered page), but the table body renders
           FilteredSortedRuns(). When a Result/Type filter is active the two numbers disagree — e.g. 25 shown
           in pager while only 5 rows are visible. Consider deriving the count from FilteredSortedRuns().Count()
           or displaying a separate "X of N" hint when a filter is active. *@
        <span class="cockpit-pager-info">Page @_page@(_result is { Items.Count: > 0 } ? $" · {_result.Items.Count} shown" : "")</span>
        <div class="cockpit-pager-buttons">
            <button class="cockpit-pager-btn" disabled="@(_page <= 1 || _loading)" @onclick="PrevPage">
                <Icon Name="chevrons-left" Size="14" /> Prev
            </button>
            <button class="cockpit-pager-btn" disabled="@(_result is null || !_result.HasMore || _loading)" @onclick="NextPage">
                Next <Icon Name="chevrons-right" Size="14" />
            </button>
        </div>
    </div>
</div>

@code {
    private const int PageSize = 25;

    private readonly CancellationTokenSource _cts = new();
    private PagedResult<PipelineRunSummary>? _result;
    private int _page = 1;
    private bool _feedbackOnly;
    private bool _loading = true;
    private string? _error;

    // ── Column sort state ────────────────────────────────────────────────────

    private enum SortColumn { When, Result, Type, Duration }

    // Default: When descending (newest first) — query-param backed so links are shareable.
    private SortColumn _sortColumn = SortColumn.When;
    private bool _sortAsc;   // false = descending (default for When)

    // ── Column filter state (client-side, not URL-persisted) ─────────────────

    private string _resultFilter = "";
    private string _typeFilter = "";

    // ── Query parameters ─────────────────────────────────────────────────────

    [Parameter]
    [SupplyParameterFromQuery(Name = "sort")]
    public string? SortFromQuery { get; set; }

    [Parameter]
    [SupplyParameterFromQuery(Name = "sortDir")]
    public string? SortDirFromQuery { get; set; }

    // ── Server-side outcome filter ────────────────────────────────────────────

    private enum OutcomeFilter { All, Completed, Failed, Cancelled }
    private OutcomeFilter _outcome = OutcomeFilter.All;

    private PipelineStep? FinalStepFilter => _outcome switch
    {
        OutcomeFilter.Completed => PipelineStep.Completed,
        OutcomeFilter.Failed => PipelineStep.Failed,
        OutcomeFilter.Cancelled => PipelineStep.Cancelled,
        _ => null
    };

    protected override void OnInitialized()
    {
        State.OnProjectChanged += HandleProjectChanged;

        // TODO: Sort state is read from query params here in OnInitialized, but [SupplyParameterFromQuery]
        // params are re-supplied on every navigation. If the user navigates to the same page with different
        // ?sort= query params (e.g. browser back/forward), OnParametersSet fires but the sort state is
        // never re-read from SortFromQuery/SortDirFromQuery, leaving sort state stale.
        // Move this query-param parsing to OnParametersSet to handle same-component re-navigation correctly.

        // Read sort state from query params
        if (Enum.TryParse<SortColumn>(SortFromQuery, ignoreCase: true, out var col))
            _sortColumn = col;
        _sortAsc = string.Equals(SortDirFromQuery, "asc", StringComparison.OrdinalIgnoreCase);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    // Re-query when the top-bar project scope changes (reset to the first page for the new scope).
    private async void HandleProjectChanged()
    {
        _page = 1;
        try
        {
            await LoadAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch (ObjectDisposedException) { }
    }

    private async Task SetOutcome(OutcomeFilter outcome)
    {
        if (_outcome == outcome) return;
        _outcome = outcome;
        _page = 1;   // a new filter resets to the first page
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _result = await RunHistory.GetRunHistoryAsync(
                page: _page, pageSize: PageSize, feedbackOnly: _feedbackOnly, includeActive: true,
                finalStep: FinalStepFilter, projectId: State.SelectedProjectId, ct: _cts.Token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex)
        {
            _error = $"Failed to load runs: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    // Quiet tick refresh — reloads the current page + filter, no spinner, no page reset.
    private async Task RefreshQuietAsync()
    {
        try
        {
            _result = await RunHistory.GetRunHistoryAsync(
                page: _page, pageSize: PageSize, feedbackOnly: _feedbackOnly, includeActive: true,
                finalStep: FinalStepFilter, projectId: State.SelectedProjectId, ct: _cts.Token);
            _error = null;
        }
        catch (OperationCanceledException) { }
        catch { /* keep the current page until the next tick */ }
    }

    private async Task ToggleFeedbackOnly(ChangeEventArgs e)
    {
        _feedbackOnly = e.Value is true;
        _page = 1;
        await LoadAsync();
    }

    private async Task PrevPage()
    {
        if (_page <= 1) return;
        _page--;
        await LoadAsync();
    }

    private async Task NextPage()
    {
        if (_result is null || !_result.HasMore) return;
        _page++;
        await LoadAsync();
    }

    // ── Sort ─────────────────────────────────────────────────────────────────

    private void ToggleSort(SortColumn col)
    {
        if (_sortColumn == col)
            _sortAsc = !_sortAsc;
        else
        {
            _sortColumn = col;
            // Default direction for each column: When = desc (newest first), others = asc
            _sortAsc = col != SortColumn.When;
        }
        PersistSortToUrl();
    }

    private void PersistSortToUrl()
    {
        var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["sort"] = _sortColumn.ToString().ToLowerInvariant(),
            ["sortDir"] = _sortAsc ? "asc" : "desc",
        });
        Nav.NavigateTo(uri, forceLoad: false, replace: true);
    }

    private IEnumerable<PipelineRunSummary> FilteredSortedRuns()
    {
        // TODO: This method is called directly in the @foreach, so it runs on every render cycle
        // (including the 12-second auto-refresh tick and any StateHasChanged call). Each invocation
        // allocates a new LINQ chain and enumerates _result.Items. For PageSize=25 this is low-cost,
        // but if PageSize grows, consider caching the result in a field invalidated on sort/filter
        // state changes to avoid unnecessary work on unrelated re-renders.
        if (_result is null) return [];

        IEnumerable<PipelineRunSummary> items = _result.Items;

        // ── Client-side column filters ────────────────────────────────────────
        if (!string.IsNullOrEmpty(_resultFilter))
            items = items.Where(r => ResultLabel(r) == _resultFilter);

        if (!string.IsNullOrEmpty(_typeFilter))
            items = items.Where(r => RunTypeLabel(r) == _typeFilter);

        // ── Client-side sort ──────────────────────────────────────────────────
        items = _sortColumn switch
        {
            SortColumn.Result => _sortAsc
                ? items.OrderBy(r => ResultLabel(r))
                : items.OrderByDescending(r => ResultLabel(r)),
            SortColumn.Type => _sortAsc
                ? items.OrderBy(r => RunTypeLabel(r))
                : items.OrderByDescending(r => RunTypeLabel(r)),
            SortColumn.Duration => _sortAsc
                ? items.OrderBy(r => DurationSeconds(r))
                : items.OrderByDescending(r => DurationSeconds(r)),
            SortColumn.When => _sortAsc
                ? items.OrderBy(r => r.StartedAtOffset)
                : items.OrderByDescending(r => r.StartedAtOffset),
            _ => items.OrderByDescending(r => r.StartedAtOffset),
        };

        return items;
    }

    private static string ResultLabel(PipelineRunSummary r) => r.FinalStep switch
    {
        PipelineStep.Completed => "Completed",
        PipelineStep.Failed => "Failed",
        PipelineStep.Cancelled => "Cancelled",
        _ => "Running"
    };

    private static string RunTypeLabel(PipelineRunSummary r) => r.RunType switch
    {
        PipelineRunType.Review => "Review",
        PipelineRunType.DecompositionAnalysis or PipelineRunType.Decomposition => "Decomposition",
        PipelineRunType.Consolidation => "Consolidation",
        _ => "Implementation"
    };

    private static double DurationSeconds(PipelineRunSummary r)
        => r.CompletedAtOffset.HasValue ? (r.CompletedAtOffset.Value - r.StartedAtOffset).TotalSeconds : double.MaxValue;

    // ── Sort header helpers ───────────────────────────────────────────────────

    private string ActiveSortClass(SortColumn col) => _sortColumn == col ? "sort-active" : "";

    // Per-column MarkupString properties so the Razor template can embed them inline
    // without Razor mistaking the closing paren for an HTML context end.
    private MarkupString SortIndicatorForResult   => SortIndicator(SortColumn.Result);
    private MarkupString SortIndicatorForType     => SortIndicator(SortColumn.Type);
    private MarkupString SortIndicatorForDuration => SortIndicator(SortColumn.Duration);
    private MarkupString SortIndicatorForWhen     => SortIndicator(SortColumn.When);

    private MarkupString SortIndicator(SortColumn col)
    {
        if (_sortColumn != col) return new MarkupString("");
        var arrow = _sortAsc ? "↑" : "↓";
        return new MarkupString($"<span class=\"sort-indicator\">{arrow}</span>");
    }

    private void OpenRun(string runId) => Nav.NavigateTo($"/runs/{runId}");

    private static string Truncate(string? s, int n)
        => string.IsNullOrEmpty(s) ? "" : (s.Length > n ? s[..n] + "…" : s);

    private static string Dur(DateTimeOffset start, DateTimeOffset? end)
    {
        if (end is null) return "running";
        var d = end.Value - start;
        if (d.TotalHours >= 1) return $"{(int)d.TotalHours}h {d.Minutes}m";
        if (d.TotalMinutes >= 1) return $"{(int)d.TotalMinutes}m {d.Seconds}s";
        return $"{Math.Max(0, (int)d.TotalSeconds)}s";
    }

    private static string Ago(DateTimeOffset t)
    {
        var d = DateTimeOffset.UtcNow - t;
        if (d.TotalMinutes < 1) return "just now";
        if (d.TotalMinutes < 60) return $"{(int)d.TotalMinutes}m ago";
        if (d.TotalHours < 24) return $"{(int)d.TotalHours}h ago";
        return $"{(int)d.TotalDays}d ago";
    }

    public async ValueTask DisposeAsync()
    {
        State.OnProjectChanged -= HandleProjectChanged;
        await _cts.CancelAsync();
        _cts.Dispose();
    }
}
