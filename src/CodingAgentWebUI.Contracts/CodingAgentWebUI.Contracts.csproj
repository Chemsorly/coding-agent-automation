<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- MsgPack017: Init properties with default initializers are intentional (SignalR DTOs). -->
    <NoWarn>$(NoWarn);MsgPack017;CS0436</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pipeline needs Contracts' internals during the extraction transition; UnitTests exercise them. -->
    <InternalsVisibleTo Include="CodingAgentWebUI.Pipeline" />
    <InternalsVisibleTo Include="CodingAgentWebUI.Pipeline.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <!-- Contracts references only the leaf CodeReview contracts lib and KiroCliLib; NEVER Pipeline. -->
    <ProjectReference Include="..\CodingAgentWebUI.Pipeline.CodeReview\CodingAgentWebUI.Pipeline.CodeReview.csproj" />
    <ProjectReference Include="..\KiroCliLib\KiroCliLib.csproj" />
  </ItemGroup>
</Project>
