<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[CodingAgent.Agent]*,[CodingAgent.Agent.KiroCli]*,[CodingAgent.Agent.OpenCode]*,[CodingAgent.Pipeline]*,[CodingAgent.Infrastructure.Providers]*,[KiroCliLib]*,[CodingAgent.Contracts]*,[CodingAgent.Infrastructure.Common]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
