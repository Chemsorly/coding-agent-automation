<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <!-- NOTE: Do NOT add <TestCaseFilter> here. The migration-integrity CI job uses
       --filter "Category=Integration" on the command line. A runsettings-level filter
       gets AND-combined with the CLI filter, producing the impossible expression
       "(Category!=Integration)&(Category=Integration)" which matches zero tests and
       silently passes. The category exclusion for local/quality-gate runs is handled
       by the CLI filter in those invocations, not here. -->
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[CodingAgentWebUI.Infrastructure.Providers]*,[CodingAgentWebUI.Infrastructure.Persistence]*,[CodingAgentWebUI.Pipeline]*</Include>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
