<?xml version="1.0" encoding="utf-8"?>
<!-- Merged runsettings for the solution-level SonarQube coverage run.
     Replaces the 11 per-project runsettings files that were used when each
     test project was executed individually. The Include pattern covers all
     production assemblies; the Exclude pattern strips test assemblies so
     they never appear in coverage reports. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Include>[CodingAgent.Web]*,[CodingAgent.Web.*]*,[KiroCliLib]*</Include>
          <Exclude>[CodingAgent.Web.*.UnitTests]*,[CodingAgent.Web.*.IntegrationTests]*,[CodingAgent.Web.E2ETests]*,[KiroCliLib.UnitTests]*</Exclude>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
